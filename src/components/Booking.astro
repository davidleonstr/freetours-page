<style>
  .field-row--pets {
    margin-top: 35px;
  }

  .field-row--email {
    margin-top: 35px;
  }

  .booking {
    background: var(--parchment);
    padding-block: 56px 100px;
  }

  .booking__eyebrow { color: var(--russet); }

  .booking__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 3.6vw, 2.9rem);
    margin: 10px 0 8px;
    color: var(--ink);
  }

  .booking__subtitle {
    font-size: 0.95rem;
    color: #5a6b5c;
    margin: 0 0 28px;
  }

  .booking__notice {
    font-size: 0.95rem;
    color: #5a6b5c;
    background: var(--cream);
    border: 1px solid rgba(24, 34, 25, 0.12);
    border-radius: var(--radius);
    padding: 16px 20px;
    margin: 0 0 32px;
  }

  .booking__grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 32px;
    align-items: start;
  }

  .booking__form {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .booking__card {
    background: var(--cream);
    border: 1px solid rgba(24, 34, 25, 0.1);
    border-top: 3px solid var(--gold);
    border-radius: var(--radius);
    padding: 30px 30px 32px;
  }

  .booking__card-title {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--ink);
    margin: 0 0 22px;
  }

  .booking__num {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--gold);
    border: 1px solid var(--line);
    border-radius: 50%;
    width: 26px;
    height: 26px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .field { margin-bottom: 18px; }
  .field:last-child { margin-bottom: 0; }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .field-row--three {
    margin-top: 20px;
    grid-template-columns: repeat(3, 1fr);
  }

  label {
    display: block;
    font-size: 0.82rem;
    font-weight: 600;
    color: #4a5b4c;
    margin-bottom: 7px;
  }
  label em {
    font-style: normal;
    color: var(--russet);
    margin-left: 2px;
  }
  .field__optional {
    font-weight: 400;
    color: #8a8272;
  }

  .field__notice {
    margin: -6px 0 0;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--russet);
  }
  .field__notice.is-hidden { display: none; }
  .field__notice--ok { color: #2e5c30; }

  input[type="text"],
  input[type="email"],
  input[type="tel"],
  input[type="number"],
  select {
    width: 100%;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--ink);
    background: var(--cream);
    border: 1px solid rgba(24, 34, 25, 0.22);
    border-radius: var(--radius);
    padding: 12px 14px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  input:focus, select:focus {
    outline: none;
    border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(233, 151, 10, 0.16);
  }

  select:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .phone-group {
    display: flex;
    gap: 8px;
  }
  .phone-group__prefix-wrap {
    flex: 0 0 148px;
  }
  .phone-group__prefix {
    padding-right: 30px;
  }
  .phone-group__number {
    flex: 1 1 auto;
    min-width: 0;
  }

  .select-wrap { position: relative; }
  select { appearance: none; padding-right: 34px; cursor: pointer; }
  .select-wrap::after {
    content: "";
    position: absolute;
    right: 14px;
    top: 50%;
    width: 8px;
    height: 8px;
    border-right: 1.6px solid var(--russet);
    border-bottom: 1.6px solid var(--russet);
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }

  .stepper {
    display: flex;
    align-items: center;
    border: 1px solid rgba(24, 34, 25, 0.22);
    border-radius: var(--radius);
    overflow: hidden;
    width: fit-content;
  }
  .stepper__btn {
    width: 40px;
    height: 44px;
    border: none;
    background: var(--parchment-alt);
    color: var(--ink);
    font-size: 1.1rem;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .stepper__btn:hover { background: var(--gold-soft); }
  .stepper__btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .stepper input {
    width: 56px;
    height: 44px;
    text-align: center;
    border: none;
    border-left: 1px solid rgba(24, 34, 25, 0.14);
    border-right: 1px solid rgba(24, 34, 25, 0.14);
    border-radius: 0;
    background: var(--cream);
  }

  .checkbox-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.92rem;
    color: var(--ink);
    margin-bottom: 12px;
    cursor: pointer;
  }
  .checkbox-row input { margin-top: 3px; accent-color: var(--gold); }
  .checkbox-row a { color: var(--russet); text-decoration: underline; }

  .booking__fineprint {
    font-size: 0.8rem;
    line-height: 1.55;
    color: #7a7562;
    margin: 0;
  }

  .booking__form-error {
    margin-top: 16px;
    font-size: 0.85rem;
    line-height: 1.5;
    color: #7a2e1f;
    background: rgba(158, 73, 54, 0.1);
    border-left: 3px solid var(--russet);
    padding: 10px 14px;
    border-radius: var(--radius);
  }
  .booking__form-error.is-hidden { display: none; }

  /* ---------- Logged-in account summary (replaces guest fields) ---------- */
  .booking__account {
    background: var(--parchment-alt);
    border: 1px dashed rgba(24, 34, 25, 0.18);
    border-radius: var(--radius);
    padding: 16px 18px;
  }
  .booking__account-label {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #7a7562;
    margin: 0 0 4px;
  }
  .booking__account-name {
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 2px;
  }
  .booking__account-email {
    font-size: 0.88rem;
    color: #5a6b5c;
    margin: 0 0 10px;
  }
  .booking__account-hint {
    font-size: 0.82rem;
    color: #7a7562;
    line-height: 1.5;
    margin: 14px 0 0;
  }

  .link-btn {
    background: none;
    border: none;
    font-family: var(--font-body);
    font-size: 0.82rem;
    color: var(--russet);
    cursor: pointer;
    padding: 4px 0;
  }
  .link-btn:hover { text-decoration: underline; }
  .link-btn:disabled { opacity: 0.5; cursor: not-allowed; }

  /* ---------- Summary ("ticket") — recolored to match the confirmation ticket ---------- */
  .summary {
    position: sticky;
    top: 96px;
  }
  .summary__inner {
    background: rgb(255, 239, 200);
    color: rgb(0, 0, 0);
    border-radius: var(--radius);
    padding: 30px 28px 32px;
    overflow: hidden;
  }
  .summary__title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: 1.2rem;
    color: #fff7ec;
    background: #E8791A;
    margin: -30px -28px 20px -28px;
    padding: 16px 28px;
  }
  .summary__list { margin: 0; }
  .summary__row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.88rem;
    padding: 9px 0;
    border-bottom: 1px dashed rgb(2, 2, 2);
  }
  .summary__row:last-child { border-bottom: none; }
  .summary__row dt { color: rgba(0, 0, 0, 0.6); margin: 0; font-weight: 400; }
  .summary__row dd { margin: 0; color: rgb(0, 0, 0); font-weight: 500; text-align: right; }

  .summary__row--tour {
    background: var(--forest-deep);
    border-radius: var(--radius);
    padding: 14px 16px;
    margin: 0 0 8px;
    border-bottom: none;
  }
  .summary__row--tour dt {
    color: rgba(242, 234, 215, 0.75);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 0.72rem;
    font-weight: 600;
  }
  .summary__row--tour dd {
    color: #fff7ec;
    font-weight: 700;
    font-size: 1.05rem;
  }

  .summary__divider {
    height: 1px;
    background: rgba(2, 2, 2, 0.15);
    margin: 18px 0;
  }

  .summary__cta {
    width: 100%;
    justify-content: center;
    margin-top: 22px;
    font-size: 0.95rem;
  }
  .summary__cta:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .summary__note {
    text-align: center;
    font-size: 0.74rem;
    color: rgba(0, 0, 0, 0.55);
    margin: 12px 0 0;
  }

  @media (max-width: 980px) {
    .booking__grid { grid-template-columns: 1fr; }
    .summary { position: static; }
  }

  @media (max-width: 640px) {
    .field-row { grid-template-columns: 1fr; }
    .booking__card { padding: 24px 20px 26px; }
  }
</style>

<script>
  const form = document.getElementById('booking-form') as HTMLFormElement | null;

  if (form) {
    const isAuthenticated = form.dataset.authenticated === 'true';

    const tourSelect = document.getElementById('tour') as HTMLSelectElement;
    const fechaSelect = document.getElementById('fecha') as HTMLSelectElement;
    const horaSelect = document.getElementById('hora') as HTMLSelectElement;

    const guestsInput = document.getElementById('guests') as HTMLInputElement;
    const guestsMinus = document.getElementById('guests-minus') as HTMLButtonElement;
    const guestsPlus = document.getElementById('guests-plus') as HTMLButtonElement;

    const childrenInput = document.getElementById('children') as HTMLInputElement;
    const childrenMinus = document.getElementById('children-minus') as HTMLButtonElement;
    const childrenPlus = document.getElementById('children-plus') as HTMLButtonElement;

    const babiesInput = document.getElementById('babies') as HTMLInputElement;
    const babiesMinus = document.getElementById('babies-minus') as HTMLButtonElement;
    const babiesPlus = document.getElementById('babies-plus') as HTMLButtonElement;

    const petsInput = document.getElementById('pets') as HTMLInputElement;
    const petsMinus = document.getElementById('pets-minus') as HTMLButtonElement;
    const petsPlus = document.getElementById('pets-plus') as HTMLButtonElement;

    const sPets = document.getElementById('s-pets')!;

    // Two "Confirmar reserva" buttons on the page (bottom of the form and
    // in the sticky summary) — keep both in sync everywhere.
    const submitBtns = Array.from(
      document.querySelectorAll<HTMLButtonElement>('#submit-btn, #submit-btn-2')
    );
    const formError = document.getElementById('form-error') as HTMLParagraphElement;
    const availabilityNotice = document.getElementById('availability-notice') as HTMLParagraphElement;

    // Only present when the visitor isn't logged in.
    const nombreInput = document.getElementById('nombre') as HTMLInputElement | null;
    const apellidosInput = document.getElementById('apellidos') as HTMLInputElement | null;
    const emailInput = document.getElementById('email') as HTMLInputElement | null;
    const prefijoSelect = document.getElementById('prefijo') as HTMLSelectElement | null;
    const telefonoInput = document.getElementById('telefono') as HTMLInputElement | null;

    const sTour = document.getElementById('s-tour')!;
    const sFecha = document.getElementById('s-fecha')!;
    const sHora = document.getElementById('s-hora')!;
    const sGuests = document.getElementById('s-guests')!;
    const sChildren = document.getElementById('s-children')!;
    const sBabies = document.getElementById('s-babies')!;

    // Cache of schedules already fetched per tour, keyed by tour id.
    const scheduleCache = new Map<string, { id: string; time: string }[]>();
    let scheduleRequestToken = 0;

    // Cache of the calendar dates a tour is actually offered on, keyed by
    // tour id. These come from GET /tours/:id/dates — a booking must
    // reference one of these rows by id (tourDateId), not a free-typed date.
    const dateCache = new Map<string, { id: string; date: string }[]>();
    let dateRequestToken = 0;

    // Cache of availability checks, keyed by tour+dateId+scheduleId. This is
    // a best-effort hint for the UI — the server still enforces it
    // authoritatively when the booking is actually submitted.
    const availabilityCache = new Map<string, { remaining: number | null; capacity: number | null }>();
    let currentAvailability: { remaining: number | null; capacity: number | null } | null = null;
    let availabilityRequestToken = 0;

    const formatDate = (value: string) => {
      const datePart = value.includes("T") ? value.split("T")[0] : value;
      return new Date(datePart + "T00:00:00").toLocaleDateString("es-ES", { day: "numeric", month: "short", year: "numeric" });
    };

    // tour_schedules.time comes back from the API as "HH:MM:SS" — trim
    // the seconds for display.
    const formatTime = (value: string) => value?.slice(0, 5) ?? value;

    function getCurrentCapacity(): number {
      const selected = tourSelect.selectedOptions[0];
      const cap = Number(selected?.dataset.capacity);
      const tourCapacity = Number.isFinite(cap) && cap > 0 ? cap : 15; // fallback if no tour selected yet

      if (currentAvailability && currentAvailability.remaining !== null) {
        return Math.max(Math.min(tourCapacity, currentAvailability.remaining), 0);
      }
      return tourCapacity;
    }

    async function loadDatesForSelectedTour() {
      const tourId = tourSelect.value;
      const thisRequest = ++dateRequestToken;

      fechaSelect.innerHTML = '';
      if (!tourId) {
        fechaSelect.disabled = true;
        fechaSelect.append(new Option('Elige primero una ruta', ''));
        updateSummary();
        return;
      }

      fechaSelect.disabled = true;
      fechaSelect.append(new Option('Cargando fechas…', ''));

      let dates = dateCache.get(tourId);
      if (!dates) {
        try {
          const res = await fetch(`/api/tours/${tourId}/dates`);
          if (!res.ok) throw new Error('Failed to load dates');
          dates = await res.json();
          dateCache.set(tourId, dates ?? []);
        } catch {
          dates = [];
        }
      }

      if (thisRequest !== dateRequestToken) return;

      fechaSelect.innerHTML = '';
      if (!dates || dates.length === 0) {
        fechaSelect.disabled = true;
        fechaSelect.append(new Option('No hay fechas disponibles para esta ruta', ''));
        updateSummary();
        return;
      }

      fechaSelect.disabled = false;
      fechaSelect.append(new Option('Elige una fecha', '', true, true));
      fechaSelect.options[0].disabled = true;
      for (const d of dates) {
        fechaSelect.append(new Option(formatDate(d.date), d.id));
      }
      updateSummary();
    }

    async function loadSchedulesForSelectedTour() {
      const tourId = tourSelect.value;
      const thisRequest = ++scheduleRequestToken;

      horaSelect.innerHTML = '';
      if (!tourId) {
        horaSelect.disabled = true;
        horaSelect.append(new Option('Elige primero una ruta', ''));
        updateSummary();
        return;
      }

      horaSelect.disabled = true;
      horaSelect.append(new Option('Cargando horarios…', ''));

      let schedules = scheduleCache.get(tourId);
      if (!schedules) {
        try {
          const res = await fetch(`/api/tours/${tourId}/schedules`);
          if (!res.ok) throw new Error('Failed to load schedules');
          schedules = await res.json();
          scheduleCache.set(tourId, schedules ?? []);
        } catch {
          schedules = [];
        }
      }

      if (thisRequest !== scheduleRequestToken) return;

      horaSelect.innerHTML = '';
      if (!schedules || schedules.length === 0) {
        horaSelect.disabled = true;
        horaSelect.append(new Option('No hay horarios disponibles para esta ruta', ''));
        updateSummary();
        return;
      }

      horaSelect.disabled = false;
      horaSelect.append(new Option('Elige una hora', '', true, true));
      horaSelect.options[0].disabled = true;
      for (const schedule of schedules) {
        horaSelect.append(new Option(formatTime(schedule.time), schedule.id));
      }
      updateSummary();
    }

    async function checkAvailability() {
      const tourId = tourSelect.value;
      const dateId = fechaSelect.value;
      const scheduleId = horaSelect.value;
      const thisRequest = ++availabilityRequestToken;

      if (!tourId || !dateId || !scheduleId) {
        currentAvailability = null;
        availabilityNotice.classList.add('is-hidden');
        updateSummary();
        return;
      }

      const cacheKey = `${tourId}|${dateId}|${scheduleId}`;
      let availability = availabilityCache.get(cacheKey);

      if (!availability) {
        try {
          const res = await fetch(
            `/api/tours/${tourId}/availability?dateId=${encodeURIComponent(dateId)}&scheduleId=${encodeURIComponent(scheduleId)}`
          );
          if (!res.ok) throw new Error('Failed to load availability');
          availability = await res.json();
          availabilityCache.set(cacheKey, availability!);
        } catch {
          if (thisRequest === availabilityRequestToken) {
            currentAvailability = null;
            availabilityNotice.classList.add('is-hidden');
            updateSummary();
          }
          return;
        }
      }

      if (thisRequest !== availabilityRequestToken) return;

      currentAvailability = availability!;

      if (availability!.remaining !== null) {
        if (availability!.remaining <= 0) {
          availabilityNotice.textContent = 'No quedan plazas para esta fecha y hora. Elige otra.';
          availabilityNotice.classList.remove('is-hidden', 'field__notice--ok');
        } else if (availability!.remaining <= 5) {
          availabilityNotice.textContent = `Solo quedan ${availability!.remaining} plaza(s) para esta salida.`;
          availabilityNotice.classList.remove('is-hidden');
          availabilityNotice.classList.add('field__notice--ok');
        } else {
          availabilityNotice.classList.add('is-hidden');
        }
      } else {
        availabilityNotice.classList.add('is-hidden');
      }

      updateSummary();
    }

    // Only adults occupy a reserved spot — children, babies, and pets don't
    // count against capacity (mirrors the backend's `quantity`-only rule).
    function updateSummary() {
      const selected = tourSelect.selectedOptions[0];
      const hasTour = Boolean(selected?.value);

      const capacity = getCurrentCapacity();
      const effectiveMax = Math.max(capacity, 1);

      let guests = Number(guestsInput.value || 1);
      if (guests > effectiveMax) {
        guests = effectiveMax;
        guestsInput.value = String(guests);
      }
      guestsInput.max = String(effectiveMax);

      const children = Number(childrenInput.value || 0);
      const babies = Number(babiesInput.value || 0);
      const pets = Number(petsInput.value || 0);

      const selectedSchedule = horaSelect.selectedOptions[0];
      const selectedDate = fechaSelect.selectedOptions[0];
      const soldOut = Boolean(
        currentAvailability && currentAvailability.remaining !== null && currentAvailability.remaining <= 0
      );

      sTour.textContent = hasTour ? selected!.textContent ?? '' : '—';
      sFecha.textContent = selectedDate?.value ? selectedDate.textContent ?? '—' : '—';
      sHora.textContent = selectedSchedule?.value ? selectedSchedule.textContent ?? '—' : '—';
      sGuests.textContent = String(guests);
      sChildren.textContent = String(children);
      sBabies.textContent = String(babies);
      sPets.textContent = String(pets);

      const guestsFull = guests >= effectiveMax;
      submitBtns.forEach((btn) => { btn.disabled = soldOut; });
      guestsPlus.disabled = soldOut || guestsFull;
    }

    guestsMinus.addEventListener('click', () => {
      guestsInput.value = String(Math.max(1, Number(guestsInput.value) - 1));
      updateSummary();
    });
    guestsPlus.addEventListener('click', () => {
      const max = getCurrentCapacity();
      if (max < 1) return; // sold out — nothing to add
      guestsInput.value = String(Math.min(max, Number(guestsInput.value) + 1));
      updateSummary();
    });

    childrenMinus.addEventListener('click', () => {
      childrenInput.value = String(Math.max(0, Number(childrenInput.value) - 1));
      updateSummary();
    });
    childrenPlus.addEventListener('click', () => {
      childrenInput.value = String(Math.min(15, Number(childrenInput.value) + 1));
      updateSummary();
    });

    babiesMinus.addEventListener('click', () => {
      babiesInput.value = String(Math.max(0, Number(babiesInput.value) - 1));
      updateSummary();
    });
    babiesPlus.addEventListener('click', () => {
      babiesInput.value = String(Math.min(10, Number(babiesInput.value) + 1));
      updateSummary();
    });

    petsMinus.addEventListener('click', () => {
      petsInput.value = String(Math.max(0, Number(petsInput.value) - 1));
      updateSummary();
    });
    petsPlus.addEventListener('click', () => {
      petsInput.value = String(Math.min(5, Number(petsInput.value) + 1));
      updateSummary();
    });

    tourSelect.addEventListener('change', () => {
      currentAvailability = null;
      availabilityNotice.classList.add('is-hidden');
      loadDatesForSelectedTour();
      loadSchedulesForSelectedTour();
    });
    [fechaSelect, horaSelect].forEach((el) =>
      el.addEventListener('change', () => {
        updateSummary();
        checkAvailability();
      })
    );

    function showError(message: string) {
      formError.textContent = message;
      formError.classList.remove('is-hidden');
    }
    function clearError() {
      formError.textContent = '';
      formError.classList.add('is-hidden');
    }
    function setSubmitting(isSubmitting: boolean) {
      submitBtns.forEach((btn) => {
        btn.disabled = isSubmitting;
        btn.textContent = isSubmitting ? 'Confirmando…' : 'Confirmar reserva';
      });
    }

    async function submitBooking(payload: Record<string, unknown>) {
      try {
        const res = await fetch('/api/bookings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (!res.ok) {
          return { ok: false as const, message: data?.message ?? 'No se ha podido completar la reserva.' };
        }
        return { ok: true as const, data };
      } catch {
        return {
          ok: false as const,
          message: 'No se ha podido conectar con el servidor. Comprueba tu conexión e inténtalo de nuevo.'
        };
      }
    }

    document.getElementById('logout-btn')?.addEventListener('click', async () => {
      await fetch('/api/auth/logout', { method: 'POST' });
      window.location.reload();
    });

    // --- Main submit ---
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearError();

      if (!tourSelect.value) {
        showError('Selecciona una ruta.');
        return;
      }
      if (!fechaSelect.value) {
        showError('Selecciona una fecha.');
        return;
      }
      if (!horaSelect.value) {
        showError('Selecciona una hora de inicio.');
        return;
      }

      const guests = Number(guestsInput.value);
      const children = Number(childrenInput.value);
      const babies = Number(babiesInput.value);
      const pets = Number(petsInput.value);
      const partySize = guests; // only adults occupy a reserved spot

      if (currentAvailability && currentAvailability.remaining !== null) {
        if (currentAvailability.remaining <= 0) {
          showError('No quedan plazas para esta fecha y hora. Elige otra.');
          return;
        }
        if (partySize > currentAvailability.remaining) {
          showError(`Solo quedan ${currentAvailability.remaining} plaza(s) para esta salida.`);
          return;
        }
      }

      const bookingPayload = {
        tourId: tourSelect.value,
        tourDateId: fechaSelect.value,
        tourScheduleId: horaSelect.value,
        guests,
        numberOfChildren: children,
        numberOfBabies: babies,
        numberOfPets: pets
      };

      if (isAuthenticated) {
        setSubmitting(true);
        const result = await submitBooking(bookingPayload);
        if (result.ok) {
          window.location.href = `/reserva-confirmada?booking=${result.data.id}`;
        } else {
          showError(result.message);
          setSubmitting(false);
        }
        return;
      }

      // Guest flow — no confirmation code on this backend: log the visitor
      // in (or register them on the spot) using the details they gave,
      // then submit the booking straight away.
      if (!nombreInput?.value.trim()) {
        showError('Introduce tu nombre.');
        return;
      }
      const apellidos = apellidosInput?.value.trim();
      const email = emailInput?.value.trim() ?? '';
      if (!email) {
        showError('Introduce tu correo electrónico.');
        return;
      }
      const telefonoDigits = telefonoInput?.value.trim() ?? '';
      if (!telefonoDigits) {
        showError('Introduce tu número de teléfono móvil.');
        return;
      }
      // Concatenate the chosen country prefix (e.g. "+34") with the digits
      // the visitor typed, so the backend gets one complete E.164-ish number.
      const prefijo = prefijoSelect?.value ?? '';
      const telefono = `${prefijo}${telefonoDigits.replace(/[\s-]+/g, '')}`;

      setSubmitting(true);
      try {
        let authRes = await fetch('/api/auth/start', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email,
            fullName: `${nombreInput.value} ${apellidos}`.trim(),
            phone: telefono || undefined
          })
        });
        let authData = await authRes.json();

        // Registration fails with 409 when an account already exists for
        // this email (e.g. the visitor hit "¿No eres tú?" and then
        // re-entered their own address) — the backend's message literally
        // says to use /auth/login instead, so do that automatically
        // rather than surfacing the error and making them retry by hand.
        if (!authRes.ok && authRes.status === 409) {
          authRes = await fetch('/api/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email })
          });
          authData = await authRes.json();
        }

        if (!authRes.ok) throw new Error(authData?.message || 'No se ha podido continuar.');

        const result = await submitBooking(bookingPayload);
        if (!result.ok) throw new Error(result.message);

        window.location.href = `/reserva-confirmada?booking=${result.data.id}`;
      } catch (err: any) {
        showError(err?.message || 'No se ha podido completar la reserva.');
        setSubmitting(false);
      }
    });

    if (tourSelect.value) {
      loadDatesForSelectedTour();
      loadSchedulesForSelectedTour();
    } else {
      updateSummary();
    }
  }
</script>
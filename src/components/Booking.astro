---
import { getTours, getCurrentCustomer } from "@/lib/api.js";
import { getSessionToken, clearSessionCookie } from "@/lib/session.js";

interface ApiTour {
  id: string;
  name: string;
  capacity: number | null;
  is_active: boolean;
}

interface CurrentCustomer {
  id: string;
  full_name: string;
  email: string;
  phone: string | null;
}

let tours: ApiTour[] = [];
let loadError = false;

try {
  tours = await getTours({ active: true });
} catch (err) {
  console.error('Failed to load tours from the API', err);
  loadError = true;
}

// If the visitor already has a valid session, skip asking for their name/
// email again and book straight under their account.
let currentCustomer: CurrentCustomer | null = null;
const sessionToken = getSessionToken(Astro.cookies);
if (sessionToken) {
  try {
    currentCustomer = await getCurrentCustomer(sessionToken);
  } catch {
    // Expired/invalid token — clear it and fall back to the guest flow,
    // which logs them in (or registers them) on submit.
    clearSessionCookie(Astro.cookies);
  }
}

const preselectedTour = Astro.url.searchParams.get("tour") ?? "";
---

<section class="booking" id="reserva">
  <div class="wrap">
    <p class="eyebrow booking__eyebrow">Reserva tu plaza</p>
    <h1 class="booking__title">Vive Dublín a tu ritmo</h1>
    <p class="booking__subtitle">Free tours — sin coste, sin pago que gestionar. Solo reserva tu plaza.</p>

    {loadError && (
      <p class="booking__notice">
        No hemos podido cargar las rutas disponibles. Recarga la página o inténtalo más tarde.
      </p>
    )}

    {!loadError && (
    <div class="booking__grid">
      <!-- ============ FORM COLUMN ============ -->
      <form class="booking__form" id="booking-form" novalidate data-authenticated={currentCustomer ? "true" : "false"}>
        <!-- 1. Tour details -->
        <div class="booking__card">
          <h2 class="booking__card-title"><span class="booking__num">01</span>El tour</h2>

          <div class="field">
            <label for="tour">Selecciona tu ruta<em>*</em></label>
            <div class="select-wrap">
              <select id="tour" name="tour" required>
                <option value="" disabled selected={!preselectedTour}>Elige una ruta</option>
                {tours.map((t) => (
                  <option
                    value={t.id}
                    data-capacity={t.capacity ?? ''}
                    selected={t.id === preselectedTour}
                  >
                    {t.name}
                  </option>
                ))}
              </select>
            </div>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="fecha">Fecha<em>*</em></label>
              <div class="select-wrap">
                <select id="fecha" name="fecha" required disabled>
                  <option value="" selected>Elige primero una ruta</option>
                </select>
              </div>
            </div>
            <div class="field">
              <label for="hora">Hora de inicio<em>*</em></label>
              <div class="select-wrap">
                <select id="hora" name="hora" required disabled>
                  <option value="" selected>Elige primero una ruta</option>
                </select>
              </div>
            </div>
          </div>

          <div class="field-row field-row--three">
            <div class="field">
              <label for="guests">Adultos<em>*</em></label>
              <div class="stepper">
                <button type="button" class="stepper__btn" id="guests-minus" aria-label="Restar adulto">−</button>
                <input type="number" id="guests" name="guests" min="1" max="15" value="1" readonly />
                <button type="button" class="stepper__btn" id="guests-plus" aria-label="Añadir adulto">+</button>
              </div>
            </div>
            <div class="field">
              <label for="children">Niños <span class="field__optional">(no ocupan plaza)</span></label>
              <div class="stepper">
                <button type="button" class="stepper__btn" id="children-minus" aria-label="Restar niño">−</button>
                <input type="number" id="children" name="children" min="0" max="15" value="0" readonly />
                <button type="button" class="stepper__btn" id="children-plus" aria-label="Añadir niño">+</button>
              </div>
            </div>
            <div class="field">
              <label for="babies">Bebés <span class="field__optional">(no ocupan plaza)</span></label>
              <div class="stepper">
                <button type="button" class="stepper__btn" id="babies-minus" aria-label="Restar bebé">−</button>
                <input type="number" id="babies" name="babies" min="0" max="10" value="0" readonly />
                <button type="button" class="stepper__btn" id="babies-plus" aria-label="Añadir bebé">+</button>
              </div>
            </div>
          </div>

          <div class="field-row field-row--pets">
            <div class="field">
              <label for="pets">Mascotas <span class="field__optional">(no ocupan plaza)</span></label>
              <div class="stepper">
                <button type="button" class="stepper__btn" id="pets-minus" aria-label="Restar mascota">−</button>
                <input type="number" id="pets" name="pets" min="0" max="5" value="0" readonly />
                <button type="button" class="stepper__btn" id="pets-plus" aria-label="Añadir mascota">+</button>
              </div>
            </div>
          </div>

          <p class="field__notice is-hidden" id="availability-notice" role="status"></p>
        </div>

        <!-- 2. Your details -->
        <div class="booking__card">
          <h2 class="booking__card-title"><span class="booking__num">02</span>Tus datos</h2>

          {currentCustomer ? (
            <div class="booking__account" id="account-summary">
              <p class="booking__account-label">Reservando como</p>
              <p class="booking__account-name">{currentCustomer.full_name}</p>
              <p class="booking__account-email">{currentCustomer.email}</p>
              <button type="button" class="link-btn" id="logout-btn">¿No son tus datos? Presione aquí para poner sus datos nuevamente.</button>
            </div>

---
const advantages = [
  "Disfruta con tranquilidad",
  "Galería exclusiva profesional",
  "Grupos reducidos, ritmo pausado",
];

const backgrounds = [
  '/images/background-3.webp',
  '/images/background-2.webp',
  '/images/background-1.jpeg'
];

const url = new URL(Astro.request.url);
const id = url.searchParams.get('bg');

const randomBg = id && Number(id) <= backgrounds.length ? backgrounds[Number(id)] : backgrounds[Math.floor(Math.random() * backgrounds.length)];
---

<section class="hero" id="top" style={`--bg-image: url('${randomBg}')`}>
  <div class="wrap hero__row">
    <div class="hero__copy">
      <p class="eyebrow">Free tours · Dublín</p>
      <h1 class="hero__title">Freetours<br />en Dublín</h1>
      <a href="/reservar" id="reservar" class="btn btn-solid">
        RESERVAR EXCURSIONES
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="4" y1="12" x2="20" y2="12"/>
          <polyline points="13 5 20 12 13 19"/>
        </svg>
      </a>
    </div>

    <div class="hero__art">
      <ul class="hero__advantages">
        <li class="hero__advantages-title">Ventajas —</li>
        {advantages.map((v) => (
          <li>
            <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="var(--gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="4 10.5 8 14.5 16 5.5"/>
            </svg>
            <span class="italic-text">{v}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .italic-text {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 100; 
  }

  .hero {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    background-image: 
      linear-gradient(rgba(0, 0, 0, 0.363), rgba(0, 0, 0, 0.4)), 
      var(--bg-image);
    background-size: cover;
    background-position:  center;
    background-repeat: no-repeat;
    color: var(--cream);
    padding-block: 72px 96px;
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
  }

  .hero__row {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: 40px;
  }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-style: italic;
    font-size: clamp(2.8rem, 5.4vw, 4.6rem);
    line-height: 1.03;
    margin: 14px 0 24px;
    color: var(--cream);
  }

  .hero__text {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--parchment-alt);
    max-width: 46ch;
    margin-bottom: 34px;
  }

  .hero__art {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero__stag {
    width: min(100%, 380px);
    height: auto;
  }

  .hero__advantages {
    position: absolute;
    right: 4%;
    bottom: 4%;
    list-style: none;
    margin: 0;
    padding: 22px 24px;
    background: rgba(18, 30, 20, 0.55);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    backdrop-filter: blur(2px);
  }

  .hero__advantages-title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--gold-soft);
    margin-bottom: 10px;
  }

  .hero__advantages li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.88rem;
    color: var(--parchment-alt);
    padding: 5px 0;
  }

  @media (min-width: 901px) {
    .hero__advantages {
      transform: translateY(160px);
    }
  }

  @media (max-width: 900px) {
    .hero__row { grid-template-columns: 1fr; }
    .hero__advantages {
      position: static;
      margin-top: 24px;
      width: fit-content;
    }
  }
</style>
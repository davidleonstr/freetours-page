---
// Drop <ConfirmDialog /> once into any admin page, then call
// initConfirmDialog() + confirmDialog({...}) from src/lib/confirmDialog.js
// instead of window.confirm(). Fully self-contained — doesn't rely on any
// CSS classes defined elsewhere on the page.
---

<div class="cd-overlay cd-is-hidden" id="confirm-overlay">
  <div class="cd-panel" role="alertdialog" aria-modal="true" aria-labelledby="confirm-title">
    <h2 class="cd-panel__title" id="confirm-title">¿Estás seguro?</h2>
    <p class="cd-panel__message" id="confirm-message"></p>
    <div class="cd-panel__actions">
      <button type="button" class="cd-btn cd-btn--ghost" id="confirm-cancel">Cancelar</button>
      <button type="button" class="cd-btn cd-btn--danger" id="confirm-ok">Eliminar</button>
    </div>
  </div>
</div>

<style is:global>
  .cd-overlay {
    position: fixed;
    inset: 0;
    background: rgba(10, 14, 10, 0.5);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 8vh 20px;
    z-index: 200;
    overflow-y: auto;
  }
  .cd-overlay.cd-is-hidden {
    display: none;
  }

  .cd-panel {
    width: 100%;
    max-width: 420px;
    background: var(--cream, #fdf9ef);
    border-radius: var(--radius, 10px);
    border-top: 3px solid var(--gold, #e9970a);
    padding: 26px 28px 24px;
    font-family: var(--font-body, system-ui, sans-serif);
  }

  .cd-panel__title {
    font-family: var(--font-display, serif);
    font-weight: 600;
    font-size: 1.2rem;
    color: var(--ink, #182219);
    margin: 0 0 10px;
  }

  .cd-panel__message {
    font-size: 0.92rem;
    line-height: 1.55;
    color: #4a5b4c;
    margin: 0 0 22px;
  }

  .cd-panel__actions {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
  }

  .cd-btn {
    font-family: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    border-radius: var(--radius, 8px);
    padding: 10px 18px;
    cursor: pointer;
    border: 1px solid transparent;
  }
  .cd-btn--ghost {
    background: none;
    border-color: rgba(24, 34, 25, 0.2);
    color: rgba(0, 0, 0, 0.6);
  }
  .cd-btn--ghost:hover {
    background: rgba(24, 34, 25, 0.05);
  }
  .cd-btn--danger {
    background: #7a2e1f;
    border-color: #7a2e1f;
    color: #fff;
  }
  .cd-btn--danger:hover {
    background: #661f13;
  }
  .cd-btn--safe {
    background: var(--gold, #e9970a);
    border-color: var(--gold, #e9970a);
    color: #fff;
  }
</style>
---
// components/SocialLinks.astro
//
// Extrae los 5 iconos de redes sociales que aparecían repetidos, con
// distinto tamaño y a veces con URLs con espacios de más, en:
//   - Nav.astro (tamaño 32)
//   - pages/index.astro, pages/reservar.astro (footer, tamaño 18)
//   - pages/blog.astro, pages/sobre-mi.astro (footer estático, tamaño 18-20)
//   - pages/reseñas.astro, pages/tours/[id].astro (footer)
//
// Con este componente, todas esas versiones se sustituyen por
// <SocialLinks size={18} /> (o el tamaño que corresponda).

interface Props {
  size?: number;
  className?: string;
}

const { size = 18, className = "" } = Astro.props;
---

<div class={`social-links ${className}`} aria-label="Redes sociales">
  <a
    href="https://www.instagram.com/meriyotoursdublin?utm_source=qr&igsi=bW1sMWg2cTl3aXdl"
    aria-label="Instagram"
    class="social-links__icon"
  >
    <svg viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="1.6">
      <rect x="3" y="3" width="18" height="18" rx="5"/>
      <circle cx="12" cy="12" r="4.2"/>
      <circle cx="17.3" cy="6.7" r="0.9" fill="currentColor" stroke="none"/>
    </svg>
  </a>
  <a
    href="https://www.tiktok.com/@meriyotours?_r=1&_t=ZN-996MxyUnSGk"
    aria-label="TikTok"
    class="social-links__icon"
  >
    <svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor">
      <path d="M14.5 3h2.6c.2 1.6 1.2 3 2.8 3.6v2.7c-1.4 0-2.8-.4-3.9-1.2v6.6c0 3-2.4 5.3-5.4 5.3S5.2 17.7 5.2 14.7c0-2.9 2.3-5.2 5.2-5.3v2.8c-1.3.1-2.4 1.2-2.4 2.5 0 1.4 1.2 2.5 2.6 2.5s2.6-1.1 2.6-2.5V3z"/>
    </svg>
  </a>
  <a
    href="https://www.facebook.com/people/MeriyoTours/61593730161963/?rdid=iuVWVNEKzYqnFpZ3&share_url=https%3A%2F%2Fwww.facebook.com%2Fshare%2F1H9FrGtubn%2F"
    aria-label="Facebook"
    class="social-links__icon"
  >
    <svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor">
      <path d="M13.5 21v-7.6h2.6l.4-3h-3v-1.9c0-.9.2-1.5 1.5-1.5h1.6V4.3C15.9 4.2 15 4.1 14 4.1c-2.3 0-3.9 1.4-3.9 4v2.3H7.5v3H10V21h3.5z"/>
    </svg>
  </a>
  <a href="https://x.com/meriyotours" aria-label="X (Twitter)" class="social-links__icon">
    <svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor">
      <path d="M18.9 3h3.1l-6.8 7.7L23.2 21h-6.3l-4.9-6.4L6.3 21H3.2l7.2-8.3L2.8 3h6.4l4.5 5.9L18.9 3zm-1.1 16.2h1.7L7.3 4.7H5.5l12.3 14.5z"/>
    </svg>
  </a>
  <a href="https://www.youtube.com/@meriyotours" aria-label="YouTube" class="social-links__icon">
    <svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor">
      <path d="M22.5 7.2c-.3-1.1-1.1-1.9-2.2-2.2C18.4 4.5 12 4.5 12 4.5s-6.4 0-8.3.5c-1.1.3-1.9 1.1-2.2 2.2C1 9.1 1 12 1 12s0 2.9.5 4.8c.3 1.1 1.1 1.9 2.2 2.2 1.9.5 8.3.5 8.3.5s6.4 0 8.3-.5c1.1-.3 1.9-1.1 2.2-2.2.5-1.9.5-4.8.5-4.8s0-2.9-.5-4.8zM9.8 15.3V8.7l6 3.3-6 3.3z"/>
    </svg>
  </a>
</div>

<style>
  .social-links {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .social-links__icon {
    color: inherit;
    display: inline-flex;
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .social-links__icon:hover {
    color: var(--gold);
    transform: translateY(-1px);
  }
</style>
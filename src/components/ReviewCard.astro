---
interface Props {
  content: string | null;
  stars: number;
  customerName: string;
  // Shown when a review needs to say which tour it's for (homepage, where
  // reviews span the whole catalog). Omit on the tour detail page, where
  // it's redundant.
  tourName?: string;
}

const { content, stars, customerName, tourName } = Astro.props;
---

<div class="review-card">
  <div class="review-card__stars" aria-label={`${stars} de 5 estrellas`}>
    {Array.from({ length: 5 }).map((_, i) => (
      <svg
        viewBox="0 0 20 20"
        width="13"
        height="13"
        fill={i < stars ? 'var(--gold)' : 'none'}
        stroke="var(--gold)"
        stroke-width={i < stars ? '0' : '1.4'}
      >
        <path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.1-5.4 3.1 1.3-6-4.6-4.1 6.1-.6L10 1.5Z"/>
      </svg>
    ))}
  </div>

  {content && <p class="review-card__quote">&ldquo;{content}&rdquo;</p>}

  <p class="review-card__reviewer">{customerName}</p>
  {tourName && <p class="review-card__reviewer"><span>— {tourName}</span></p>}
</div>

<style is:global>
  .review-card {
    border: 1px dashed black;
    padding: 20px;
  }

  .review-card__stars {
    display: flex;
    gap: 3px;
    margin-bottom: 8px;
  }

  .review-card__quote {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--ink);
    margin: 0 0 10px;
  }

  .review-card__reviewer {
    font-size: 0.8rem;
    font-weight: 600;
    margin: 0;
    color: var(--russet);
  }
  .review-card__reviewer span {
    font-weight: 400;
    color: #6b6355;
  }
</style>
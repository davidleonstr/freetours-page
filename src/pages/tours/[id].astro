---
import Nav from "@/components/Nav.astro";
import ReviewCard from "@/components/ReviewCard.astro";
import { ApiError, getTour, getAllTourReviews, getTourReviewSummary, getCurrentCustomer } from "@/lib/api.js";
import { getSessionToken, clearSessionCookie } from "@/lib/session.js";
import "@/styles/global.css";

export const prerender = false;

const { id } = Astro.params;

let tour: any = null;

try {
  tour = await getTour(id as string);
} catch (err) {
  if (err instanceof ApiError && err.status === 404) {
    return Astro.redirect('/404');
  }
  throw err;
}

if (!tour.is_active) {
  return Astro.redirect('/404');
}

if (Array.isArray(tour.gallery)) {
  tour.gallery = [...tour.gallery].sort((a: any, b: any) => a.position - b.position);
}

interface ApiReview {
  id: string;
  stars: number;
  content: string | null;
  tour_id: string;
  customer_id: string;
  created_at: string;
  tour_name: string;
  customer_name: string;
}

interface ReviewSummary {
  tourId: string;
  reviewCount: number;
  averageStars: number;
  breakdown: Record<string, number>;
}

interface CurrentCustomer {
  id: string;
  full_name: string;
  email: string;
}

let reviews: ApiReview[] = [];
let summary: ReviewSummary | null = null;
let reviewsError = false;

try {
  [reviews, summary] = await Promise.all([
    getAllTourReviews(tour.id),
    getTourReviewSummary(tour.id)
  ]);
} catch (err) {
  console.error('Failed to load reviews for this tour', err);
  reviewsError = true;
}

// Resolve the logged-in customer (if any) from the session cookie — same
// pattern as Booking.astro — so we know whether to show the review form,
// a "you've already reviewed this" note, or a login prompt.
let currentCustomer: CurrentCustomer | null = null;
const sessionToken = getSessionToken(Astro.cookies);
if (sessionToken) {
  try {
    currentCustomer = await getCurrentCustomer(sessionToken);
  } catch {
    clearSessionCookie(Astro.cookies);
  }
}

const myReview = currentCustomer
  ? reviews.find((r) => r.customer_id === currentCustomer!.id) ?? null
  : null;

function splitCaption(text: string): { title: string | null; body: string | null } {
  const trimmed = text.trim();
  const match = trimmed.match(/^([^.!?]{1,40}[.!?])\s*(.*)$/);
  if (match && match[2]) {
    return { title: match[1].replace(/[.!?]$/, ''), body: match[2] };
  }
  return { title: null, body: trimmed };
}

// Each gallery image is one stop on the route: its alt text is split into
// a short title (the stop's name) and a body (what happens there), the
// same convention used to compose booking-ticket copy elsewhere. Numbered
// 1, 2, 3… in gallery order, mirroring the waypoint layout used in the
// "arrival guide" post.
const routeStops = (tour.gallery ?? []).map((img: any, index: number) => {
  const parts = img.alt ? splitCaption(img.alt) : null;
  return {
    number: index + 1,
    image: img,
    title: parts?.title ?? null,
    body: parts?.body ?? (parts ? null : img.alt ?? null)
  };
});

// Helper to format decimal hours into hours and minutes
function formatDuration(decimalHours: number): string {
  const h = Math.floor(decimalHours);
  const m = Math.round((decimalHours - h) * 60);
  const parts = [];
  if (h > 0) parts.push(`${h}h`);
  if (m > 0) parts.push(`${m}m`);
  return parts.join(' ') + ' de duración';
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{tour.name} — Meriyo Tours (Dublin)</title>
    <link rel="icon" href="/web-icon-orange.svg" />
    <meta name="description" content={tour.description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;1,500;1,600&family=Work+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  </head>
  <body>
    <Nav />
    <main>
      <section class="tour-detail">
        <div class="wrap tour-detail__inner">
          <p class="eyebrow">Excursión gratuita</p>
          <h1 class="tour-detail__title">{tour.name}</h1>
          <p class="tour-detail__desc">{tour.description}</p>

          <div class="tour-detail__meta">
            {tour.duration_hours != null && <span>{formatDuration(Number(tour.duration_hours))}</span>}
            {summary && summary.reviewCount > 0 && (
              <span>★ {summary.averageStars.toFixed(1)} ({summary.reviewCount} {summary.reviewCount === 1 ? 'reseña' : 'reseñas'})</span>
            )}
          </div>

          {routeStops.length > 0 && (
            <div class="tour-route-section">
              <h2 class="tour-route-section__title">¿Qué veremos durante el tour?</h2>
              <p class="tour-route-section__lede">El recorrido está dividido en puntos — así es, paso a paso.</p>

              <div class="tour-route">
                {routeStops.map((stop: any) => (
                  <div class="tour-route__stop">
                    <div class="tour-route__marker">{stop.number}</div>
                    <div class="tour-route__content">
                      <figure class="tour-route__figure">
                        <img src={stop.image.url} alt={stop.image.alt ?? tour.name} loading="lazy" />
                      </figure>
                      <div class="tour-route__text">
                        {stop.title && <h3 class="tour-route__stop-title">{stop.title}</h3>}
                        {stop.body && <p class="tour-route__stop-body">{stop.body}</p>}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          <a href={`/reservar?tour=${tour.id}`} class="btn orange-btn rounded-btn">Reservar esta ruta</a>

          {tour.meeting_point_lat != null && tour.meeting_point_lng != null && (
            <div class="tour-detail__map-wrap">
              <h2 class="tour-detail__map-title">Punto de encuentro</h2>
              {tour.meeting_point && <p class="tour-detail__map-address">{tour.meeting_point}</p>}
              <div id="meeting-point-map" class="tour-detail__map"></div>
              <p class="tour-detail__map-attribution">
                Mapa de <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors
              </p>
            </div>
          )}
        </div>
      </section>

      {tour.stops && tour.stops.length > 0 && (
        <section class="tour-stops-map-section">
          <div class="wrap">
            <p class="eyebrow">Recorrido</p>
            <h2 class="tour-stops-map-section__title">Mapa de la ruta</h2>
            <div id="tour-stops-map" class="tour-stops-map"></div>
            <p class="tour-detail__map-attribution">
              Mapa de <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors
            </p>
          </div>
        </section>
      )}

      <section class="tour-reviews">
        <div class="wrap">
          <p class="eyebrow">Reseñas</p>
          <h2 class="tour-reviews__title">Opiniones de esta ruta</h2>

          {reviewsError && (
            <p class="tour-reviews__notice">
              No hemos podido cargar las reseñas en este momento. Inténtalo de nuevo más tarde.
            </p>
          )}

          {!reviewsError && (
            <div class="review-form-wrap">
              {currentCustomer && myReview && (
                <div class="review-cta review-cta--done">
                  <p>Ya has dejado una reseña para esta ruta. ¡Gracias por compartir tu opinión!</p>
                </div>
              )}

              {currentCustomer && !myReview && (
                <div class="review-form-card" id="review-form-card">
                  <h3 class="review-form-card__title">Deja tu reseña</h3>
                  <form id="review-form" novalidate>
                    <div class="field">
                      <label id="star-picker-label">Puntuación<em>*</em></label>
                      <div class="star-picker" id="star-picker" role="radiogroup" aria-labelledby="star-picker-label">
                        {[1, 2, 3, 4, 5].map((n) => (
                          <button type="button" class="star-picker__star" data-star={n} aria-label={`${n} estrellas`}>★</button>
                        ))}
                      </div>
                      <input type="hidden" id="review-stars" name="stars" />
                    </div>
                    <div class="field">
                      <label for="review-content">Comentario <span class="field__optional">(opcional)</span></label>
                      <textarea id="review-content" name="content" rows="4" maxlength="5000"></textarea>
                    </div>
                    <p class="review-form-error is-hidden" id="review-form-error" role="alert"></p>
                    <button type="submit" class="btn orange-btn" id="review-submit">Publicar reseña</button>
                  </form>
                </div>
              )}
            </div>
          )}

          {!reviewsError && reviews.length === 0 && (
            <p class="tour-reviews__notice" id="reviews-empty-notice">Todavía no hay reseñas para esta ruta.</p>
          )}

          {!reviewsError && reviews.length > 0 && (
            <div class="tour-reviews__grid" id="reviews-grid">
              {reviews.map((r) => (
                <ReviewCard content={r.content} stars={r.stars} customerName={r.customer_name} />
              ))}
            </div>
          )}
        </div>
      </section>
    </main>

    <footer class="site-footer" id="sobre-mi">
      <div class="wrap site-footer__row">
        <div>
          <p class="site-footer__logo"><em>Meriyo</em> Tours <em>Dublín</em></p>
          <p class="site-footer__text">
            Dublín que no sale en las
            postales. Free tours con reserva anticipada.
          </p>
        </div>
        <div class="footer__social" aria-label="Redes sociales">
          <a href="https://www.instagram.com/meriyotour?igsi=bW1sMWg2cTl3aXdl " aria-label="Instagram" class="nav__icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="3" y="3" width="18" height="18" rx="5"/>
              <circle cx="12" cy="12" r="4.2"/>
              <circle cx="17.3" cy="6.7" r="0.9" fill="currentColor" stroke="none"/>
            </svg>
          </a>
          <a href="https://www.tiktok.com/@meriyotours?_r=1&_t=ZN-996MxyUnSGk " aria-label="TikTok" class="nav__icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
              <path d="M14.5 3h2.6c.2 1.6 1.2 3 2.8 3.6v2.7c-1.4 0-2.8-.4-3.9-1.2v6.6c0 3-2.4 5.3-5.4 5.3S5.2 17.7 5.2 14.7c0-2.9 2.3-5.2 5.2-5.3v2.8c-1.3.1-2.4 1.2-2.4 2.5 0 1.4 1.2 2.5 2.6 2.5s2.6-1.1 2.6-2.5V3z"/>
            </svg>
          </a>
          <a href="https://www.facebook.com/people/MeriyoTours/61593730161963/?rdid=iuVWVNEKzYqnFpZ3&share_url=https%3A%2F% 2Fwww.facebook.com%2Fshare%2F1H9FrGtubn%2F " aria-label="Facebook" class="nav__icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
              <path d="M13.5 21v-7.6h2.6l.4-3h-3v-1.9c0-.9.2-1.5 1.5-1.5h1.6V4.3C15.9 4.2 15 4.1 14 4.1c-2.3 0-3.9 1.4-3.9 4v2.3H7.5v3H10V21h3.5z"/>
            </svg>
          </a>
          <a href="https://x.com/meriyotours " aria-label="X (Twitter)" class="nav__icon">
            <svg viewBox="0 0 24 24" width="29" height="29" fill="currentColor">
              <path d="M18.9 3h3.1l-6.8 7.7L23.2 21h-6.3l-4.9-6.4L6.3 21H3.2l7.2-8.3L2.8 3h6.4l4.5 5.9L18.9 3zm-1.1 16.2h1.7L7.3 4.7H5.5l12.3 14.5z"/>
            </svg>
          </a>
          <a href="https://www.youtube.com/@meriyotours " aria-label="YouTube" class="nav__icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
              <path d="M22.5 7.2c-.3-1.1-1.1-1.9-2.2-2.2C18.4 4.5 12 4.5 12 4.5s-6.4 0-8.3.5c-1.1.3-1.9 1.1-2.2 2.2C1 9.1 1 12 1 12s0 2.9.5 4.8c.3 1.1 1.1 1.9 2.2 2.2 1.9.5 8.3.5 8.3.5s6.4 0 8.3-.5c1.1-.3 1.9-1.1 2.2-2.2.5-1.9.5-4.8.5-4.8s0-2.9-.5-4.8zM9.8 15.3V8.7l6 3.3-6 3.3z"/>
            </svg>
          </a>
        </div>
        <div class="display-legal-items">
          <a href="/condiciones-reserva" class="site-footer__copy">Condiciones de reserva</a>
          <a href="/politicas-privacidad" class="site-footer__copy">Políticas de privacidad</a>
          <p class="site-footer__copy">© {new Date().getFullYear()} Meriyo Tours (Dublin)</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  .tour-stops-map-section {
    background: var(--parchment);
    padding-block: 0 70px;
  }
  .tour-stops-map-section__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.5rem, 2.6vw, 1.9rem);
    color: var(--ink);
    margin: 10px 0 20px;
  }
  .tour-stops-map {
    width: 100%;
    height: 380px;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid rgba(24, 34, 25, 0.12);
  }
  .tour-stops-map__marker span {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--forest-deep);
    color: var(--gold);
    border: 2px solid var(--gold);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.85rem;
    box-shadow: 0 2px 6px rgba(0,0,0,0.25);
  }
  .tour-stops-map .leaflet-popup-content {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--ink);
  }

  @media (max-width: 640px) {
    .tour-stops-map { height: 280px; }
  }
  .tour-detail {
    background: var(--parchment);
    padding-block: 64px 60px;
  }
  .tour-detail__inner { max-width: 760px; }
  .tour-detail__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 3.6vw, 2.9rem);
    color: var(--ink);
    margin: 10px 0 18px;
  }
  .tour-detail__desc {
    font-size: 1rem;
    line-height: 1.7;
    color: #3c4a3d;
    margin: 0 0 22px;
  }
  .tour-detail__meta {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    font-size: 0.85rem;
    font-weight: bold;
    color: var(--gold);
    margin: 0 0 28px;
  }

  .tour-detail__map-wrap {
    margin-top: 44px;
  }
  .tour-detail__map-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.3rem;
    color: var(--ink);
    margin: 0 0 8px;
  }
  .tour-detail__map-address {
    font-size: 0.9rem;
    color: #5a6b5c;
    margin: 0 0 14px;
  }
  .tour-detail__map {
    width: 100%;
    height: 320px;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid rgba(24, 34, 25, 0.12);
  }
  .tour-detail__map-attribution {
    font-size: 0.72rem;
    color: #9a9284;
    margin: 8px 0 0;
  }
  .tour-detail__map-attribution a { color: inherit; text-decoration: underline; }

  .tour-detail__gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 14px;
    margin-top: 40px;
  }

  /* ---------- Route / waypoints (numbered stops, like the arrival-guide post) ---------- */
  .tour-route-section {
    margin-top: 56px;
    margin-bottom: 45px;
  }
  .tour-route-section__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.5rem, 2.6vw, 1.9rem);
    color: var(--ink);
    margin: 0 0 10px;
  }
  .tour-route-section__lede {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #3c4a3d;
    margin: 0 0 28px;
  }

  .tour-route {
    position: relative;
    padding-left: 56px;
  }
  /* the dashed connecting line running through every marker, same device
     used on the arrival-guide page's waypoint list */
  .tour-route::before {
    content: "";
    position: absolute;
    left: 19px;
    top: 6px;
    bottom: 6px;
    width: 2px;
    background-image: linear-gradient(to bottom, var(--gold) 60%, transparent 0%);
    background-size: 2px 12px;
    background-repeat: repeat-y;
  }

  .tour-route__stop {
    position: relative;
    padding-block: 32px;
    border-bottom: 1px solid rgba(24, 34, 25, 0.12);
  }
  .tour-route__stop:first-child { padding-top: 4px; }
  .tour-route__stop:last-child { border-bottom: none; }

  .tour-route__marker {
    position: absolute;
    left: -56px;
    top: 32px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--forest-deep);
    color: var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    border: 2px solid var(--gold);
  }

  .tour-route__content {
    display: grid;
    grid-template-columns: minmax(200px, 280px) 1fr;
    gap: 24px;
    align-items: center;
  }
  .tour-route__figure {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid rgba(24, 34, 25, 0.1);
  }
  .tour-route__figure img {
    width: 100%;
    height: 190px;
    object-fit: cover;
    display: block;
  }
  .tour-route__stop-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--ink);
    margin: 0 0 10px;
  }
  .tour-route__stop-body {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #3c4a3d;
    margin: 0;
  }

  @media (max-width: 620px) {
    .tour-route { padding-left: 44px; }
    .tour-route::before { left: 15px; }
    .tour-route__marker { left: -44px; width: 32px; height: 32px; font-size: 0.9rem; top: 28px; }
    .tour-route__content { grid-template-columns: 1fr; }
    .tour-route__figure img { height: 200px; }
  }

  .tour-reviews {
    background: var(--parchment);
    padding-block: 20px 100px;
  }
  .tour-reviews__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.7rem, 3vw, 2.2rem);
    margin: 10px 0 30px;
    color: var(--ink);
  }
  .tour-reviews__notice {
    font-size: 0.95rem;
    color: #5a6b5c;
    background: var(--cream);
    border: 1px solid rgba(24, 34, 25, 0.12);
    border-radius: var(--radius);
    padding: 16px 20px;
    margin: 0 0 22px;
  }
  .tour-reviews__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  /* ---------- Review form / CTA ---------- */
  .review-form-wrap { margin-bottom: 30px; }

  .review-cta {
    background: var(--cream);
    border: 1px dashed rgba(24, 34, 25, 0.18);
    border-radius: var(--radius);
    padding: 16px 20px;
    font-size: 0.92rem;
    color: #4a5b4c;
  }
  .review-cta a { color: var(--russet); text-decoration: underline; }
  .review-cta--done {
    background: rgba(72, 122, 74, 0.1);
    border-color: rgba(72, 122, 74, 0.3);
    color: #2e5c30;
  }

  .review-form-card {
    background: var(--cream);
    border: 1px solid rgba(24, 34, 25, 0.1);
    border-top: 3px solid var(--gold);
    border-radius: var(--radius);
    padding: 26px 26px 28px;
  }
  .review-form-card__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--ink);
    margin: 0 0 18px;
  }
  .review-form-card .field { margin-bottom: 16px; }
  .review-form-card label {
    display: block;
    font-size: 0.82rem;
    font-weight: 600;
    color: #4a5b4c;
    margin-bottom: 8px;
  }
  .review-form-card label em { font-style: normal; color: var(--russet); margin-left: 2px; }
  .field__optional { font-weight: 400; color: #8a8272; }

  .star-picker { display: flex; gap: 6px; }
  .star-picker__star {
    background: none;
    border: none;
    font-size: 1.6rem;
    line-height: 1;
    color: rgba(24, 34, 25, 0.22);
    cursor: pointer;
    padding: 2px;
    transition: color 0.15s ease, transform 0.15s ease;
  }
  .star-picker__star:hover { transform: translateY(-1px); }
  .star-picker__star.is-filled { color: var(--gold); }

  .review-form-card textarea {
    width: 100%;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--ink);
    background: var(--cream);
    border: 1px solid rgba(24, 34, 25, 0.22);
    border-radius: var(--radius);
    padding: 12px 14px;
    resize: vertical;
  }
  .review-form-card textarea:focus {
    outline: none;
    border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(233, 151, 10, 0.16);
  }

  .review-form-error {
    font-size: 0.85rem;
    color: #7a2e1f;
    background: rgba(158, 73, 54, 0.1);
    border-left: 3px solid var(--russet);
    padding: 10px 14px;
    border-radius: var(--radius);
    margin: 0 0 16px;
  }
  .review-form-error.is-hidden { display: none; }

  @media (max-width: 940px) {
    .tour-reviews__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    .tour-reviews__grid { grid-template-columns: 1fr; }
    .tour-detail__map { height: 240px; }
  }


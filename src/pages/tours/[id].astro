---
import Nav from "@/components/Nav.astro";
import ReviewCard from "@/components/ReviewCard.astro";
import { ApiError, getTour, getAllTourReviews, getTourReviewSummary, getCurrentCustomer } from "@/lib/api.js";
import { getSessionToken, clearSessionCookie } from "@/lib/session.js";
import "@/styles/global.css";

export const prerender = false;

const { id } = Astro.params;

let tour: any = null;

try {
  tour = await getTour(id as string);
} catch (err) {
  if (err instanceof ApiError && err.status === 404) {
    return Astro.redirect('/404');
  }
  throw err;
}

if (!tour.is_active) {
  return Astro.redirect('/404');
}

if (Array.isArray(tour.gallery)) {
  tour.gallery = [...tour.gallery].sort((a: any, b: any) => a.position - b.position);
}

interface ApiReview {
  id: string;
  stars: number;
  content: string | null;
  tour_id: string;
  customer_id: string;
  created_at: string;
  tour_name: string;
  customer_name: string;
}

interface ReviewSummary {
  tourId: string;
  reviewCount: number;
  averageStars: number;
  breakdown: Record<string, number>;
}

interface CurrentCustomer {
  id: string;
  full_name: string;
  email: string;
}

let reviews: ApiReview[] = [];
let summary: ReviewSummary | null = null;
let reviewsError = false;

try {
  [reviews, summary] = await Promise.all([
    getAllTourReviews(tour.id),
    getTourReviewSummary(tour.id)
  ]);
} catch (err) {
  console.error('Failed to load reviews for this tour', err);
  reviewsError = true;
}

// Resolve the logged-in customer (if any) from the session cookie — same
// pattern as Booking.astro — so we know whether to show the review form,
// a "you've already reviewed this" note, or a login prompt.
let currentCustomer: CurrentCustomer | null = null;
const sessionToken = getSessionToken(Astro.cookies);
if (sessionToken) {
  try {
    currentCustomer = await getCurrentCustomer(sessionToken);
  } catch {
    clearSessionCookie(Astro.cookies);
  }
}

const myReview = currentCustomer
  ? reviews.find((r) => r.customer_id === currentCustomer!.id) ?? null
  : null;

function splitCaption(text: string): { title: string | null; body: string | null } {
  const trimmed = text.trim();
  const match = trimmed.match(/^([^.!?]{1,40}[.!?])\s*(.*)$/);
  if (match && match[2]) {
    return { title: match[1].replace(/[.!?]$/, ''), body: match[2] };
  }
  return { title: null, body: trimmed };
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{tour.name} — Tours Meriyo Dublín</title>
    <link rel="icon" href="/web-icon-orange.svg" />
    <meta name="description" content={tour.description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;1,500;1,600&family=Work+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  </head>
  <body>
    <Nav />
    <main>
      <section class="tour-detail">
        <div class="wrap tour-detail__inner">
          <p class="eyebrow">Excursión gratuita</p>
          <h1 class="tour-detail__title">{tour.name}</h1>
          <p class="tour-detail__desc">{tour.description}</p>

          <div class="tour-detail__meta">
            {tour.duration_hours && <span>{tour.duration_hours}h de duración</span>}
            {summary && summary.reviewCount > 0 && (
              <span>★ {summary.averageStars.toFixed(1)} ({summary.reviewCount} {summary.reviewCount === 1 ? 'reseña' : 'reseñas'})</span>
            )}
          </div>

          {tour.gallery?.length > 0 && (
            <div class="tour-highlights">
              <div class="tour-highlights__text">
                <h2 class="tour-highlights__title">¿Qué veremos durante el tour?</h2>
                <p>{tour.description}</p>
              </div>

              <div class="tour-highlights__carousel-wrap">
                <div class="tour-highlights__carousel" id="gallery-carousel">
                  {tour.gallery.map((img: any) => {
                    const parts = img.alt ? splitCaption(img.alt) : null;
                    return (
                      <div class="carousel-slide" data-slide tabindex="0">
                        <img src={img.url} alt={img.alt ?? tour.name} loading="lazy" />
                        {parts && (
                          <div class="carousel-caption">
                            {parts.title && <p class="carousel-caption__title">{parts.title}</p>}
                            {parts.body && <p class="carousel-caption__body">{parts.body}</p>}
                          </div>
                        )}
                      </div>
                    );
                  })}
                </div>

                <div class="tour-highlights__dots" id="gallery-dots">
                  {tour.gallery.map((_: any, i: number) => (
                    <button type="button" class="carousel-dot" data-dot data-index={i} aria-label={`Ir a la imagen ${i + 1}`}></button>
                  ))}
                </div>
              </div>
            </div>
          )}

          <a href={`/reservar?tour=${tour.id}`} class="btn orange-btn rounded-btn">Reservar esta ruta</a>

          {tour.meeting_point_lat != null && tour.meeting_point_lng != null && (
            <div class="tour-detail__map-wrap">
              <h2 class="tour-detail__map-title">Punto de encuentro</h2>
              {tour.meeting_point && <p class="tour-detail__map-address">{tour.meeting_point}</p>}
              <div id="meeting-point-map" class="tour-detail__map"></div>
              <p class="tour-detail__map-attribution">
                Mapa de <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors
              </p>
            </div>
          )}
        </div>
      </section>

      <section class="tour-reviews">
        <div class="wrap">
          <p class="eyebrow">Reseñas</p>
          <h2 class="tour-reviews__title">Opiniones de esta ruta</h2>

          {reviewsError && (
            <p class="tour-reviews__notice">
              No hemos podido cargar las reseñas en este momento. Inténtalo de nuevo más tarde.
            </p>
          )}

          {!reviewsError && (
            <div class="review-form-wrap">
              {currentCustomer && myReview && (
                <div class="review-cta review-cta--done">
                  <p>Ya has dejado una reseña para esta ruta. ¡Gracias por compartir tu opinión!</p>
                </div>
              )}

              {currentCustomer && !myReview && (
                <div class="review-form-card" id="review-form-card">
                  <h3 class="review-form-card__title">Deja tu reseña</h3>
                  <form id="review-form" novalidate>
                    <div class="field">
                      <label id="star-picker-label">Puntuación<em>*</em></label>
                      <div class="star-picker" id="star-picker" role="radiogroup" aria-labelledby="star-picker-label">
                        {[1, 2, 3, 4, 5].map((n) => (
                          <button type="button" class="star-picker__star" data-star={n} aria-label={`${n} estrellas`}>★</button>
                        ))}
                      </div>
                      <input type="hidden" id="review-stars" name="stars" />
                    </div>
                    <div class="field">
                      <label for="review-content">Comentario <span class="field__optional">(opcional)</span></label>
                      <textarea id="review-content" name="content" rows="4" maxlength="5000"></textarea>
                    </div>
                    <p class="review-form-error is-hidden" id="review-form-error" role="alert"></p>
                    <button type="submit" class="btn orange-btn" id="review-submit">Publicar reseña</button>
                  </form>
                </div>
              )}
            </div>
          )}

          {!reviewsError && reviews.length === 0 && (
            <p class="tour-reviews__notice" id="reviews-empty-notice">Todavía no hay reseñas para esta ruta.</p>
          )}

          {!reviewsError && reviews.length > 0 && (
            <div class="tour-reviews__grid" id="reviews-grid">
              {reviews.map((r) => (
                <ReviewCard content={r.content} stars={r.stars} customerName={r.customer_name} />
              ))}
            </div>
          )}
        </div>
      </section>
    </main>

    <footer class="site-footer" id="sobre-mi">
      <div class="wrap site-footer__row">
        <div>
          <p class="site-footer__logo">Tours <em>Meriyo</em> Dublín</p>
          <p class="site-footer__text">
            Guías locales, grupos reducidos y el Dublín que no sale en las
            postales. Free tours a diario, con reserva anticipada.
          </p>
        </div>
        <p class="site-footer__copy">© {new Date().getFullYear()} Tours Meriyo Dublín</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  .tour-detail {
    background: var(--parchment);
    padding-block: 64px 60px;
  }
  .tour-detail__inner { max-width: 760px; }
  .tour-detail__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 3.6vw, 2.9rem);
    color: var(--ink);
    margin: 10px 0 18px;
  }
  .tour-detail__desc {
    font-size: 1rem;
    line-height: 1.7;
    color: #3c4a3d;
    margin: 0 0 22px;
  }
  .tour-detail__meta {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    font-size: 0.85rem;
    color: #5a6b5c;
    margin: 0 0 28px;
  }

  .tour-detail__map-wrap {
    margin-top: 44px;
  }
  .tour-detail__map-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.3rem;
    color: var(--ink);
    margin: 0 0 8px;
  }
  .tour-detail__map-address {
    font-size: 0.9rem;
    color: #5a6b5c;
    margin: 0 0 14px;
  }
  .tour-detail__map {
    width: 100%;
    height: 320px;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid rgba(24, 34, 25, 0.12);
  }
  .tour-detail__map-attribution {
    font-size: 0.72rem;
    color: #9a9284;
    margin: 8px 0 0;
  }
  .tour-detail__map-attribution a { color: inherit; text-decoration: underline; }

  .tour-detail__gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 14px;
    margin-top: 40px;
  }
  .tour-highlights {
    display: grid;
    margin-bottom: 45px;
    grid-template-columns: minmax(240px, 340px) 1fr;
    gap: 40px;
    align-items: start;
    margin-top: 56px;
  }
  .tour-highlights__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.5rem, 2.6vw, 1.9rem);
    color: var(--ink);
    margin: 0 0 16px;
  }
  .tour-highlights__text p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #3c4a3d;
    margin: 0 0 16px;
  }

  .tour-highlights__carousel-wrap { min-width: 0; }
  .tour-highlights__carousel {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: 4px;
  }
  .tour-highlights__carousel::-webkit-scrollbar { display: none; }

  .carousel-slide {
    position: relative;
    flex: 0 0 auto;
    width: min(230px, 70vw);
    height: 280px;
    border-radius: var(--radius);
    overflow: hidden;
    scroll-snap-align: start;
    border: 1px solid rgba(24, 34, 25, 0.1);
  }
  .carousel-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .carousel-caption {
    position: absolute;
    inset: auto 0 0 0;
    background: linear-gradient(to top, rgba(27, 41, 33, 0.9), rgba(27, 41, 33, 0));
    padding: 40px 16px 14px;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    pointer-events: none;
  }
  .carousel-slide:hover .carousel-caption,
  .carousel-slide:focus-within .carousel-caption,
  .carousel-slide:focus .carousel-caption {
    opacity: 1;
    transform: translateY(0);
  }

  .carousel-caption__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--cream);
    margin: 0 0 6px;
  }
  .carousel-caption__body {
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--parchment-alt);
    margin: 0;
  }

  .tour-highlights__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 16px;
  }
  .carousel-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    background: rgba(24, 34, 25, 0.2);
    padding: 0;
    cursor: pointer;
  }
  .carousel-dot.is-active { background: var(--ink); }

  @media (max-width: 780px) {
    .tour-highlights { grid-template-columns: 1fr; }
  }

  .tour-reviews {
    background: var(--parchment);
    padding-block: 20px 100px;
  }
  .tour-reviews__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.7rem, 3vw, 2.2rem);
    margin: 10px 0 30px;
    color: var(--ink);
  }
  .tour-reviews__notice {
    font-size: 0.95rem;
    color: #5a6b5c;
    background: var(--cream);
    border: 1px solid rgba(24, 34, 25, 0.12);
    border-radius: var(--radius);
    padding: 16px 20px;
    margin: 0 0 22px;
  }
  .tour-reviews__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  /* ---------- Review form / CTA ---------- */
  .review-form-wrap { margin-bottom: 30px; }

  .review-cta {
    background: var(--cream);
    border: 1px dashed rgba(24, 34, 25, 0.18);
    border-radius: var(--radius);
    padding: 16px 20px;
    font-size: 0.92rem;
    color: #4a5b4c;
  }
  .review-cta a { color: var(--russet); text-decoration: underline; }
  .review-cta--done {
    background: rgba(72, 122, 74, 0.1);
    border-color: rgba(72, 122, 74, 0.3);
    color: #2e5c30;
  }

  .review-form-card {
    background: var(--cream);
    border: 1px solid rgba(24, 34, 25, 0.1);
    border-top: 3px solid var(--gold);
    border-radius: var(--radius);
    padding: 26px 26px 28px;
  }
  .review-form-card__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--ink);
    margin: 0 0 18px;
  }
  .review-form-card .field { margin-bottom: 16px; }
  .review-form-card label {
    display: block;
    font-size: 0.82rem;
    font-weight: 600;
    color: #4a5b4c;
    margin-bottom: 8px;
  }
  .review-form-card label em { font-style: normal; color: var(--russet); margin-left: 2px; }
  .field__optional { font-weight: 400; color: #8a8272; }

  .star-picker { display: flex; gap: 6px; }
  .star-picker__star {
    background: none;
    border: none;
    font-size: 1.6rem;
    line-height: 1;
    color: rgba(24, 34, 25, 0.22);
    cursor: pointer;
    padding: 2px;
    transition: color 0.15s ease, transform 0.15s ease;
  }
  .star-picker__star:hover { transform: translateY(-1px); }
  .star-picker__star.is-filled { color: var(--gold); }

  .review-form-card textarea {
    width: 100%;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--ink);
    background: var(--cream);
    border: 1px solid rgba(24, 34, 25, 0.22);
    border-radius: var(--radius);
    padding: 12px 14px;
    resize: vertical;
  }
  .review-form-card textarea:focus {
    outline: none;
    border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(233, 151, 10, 0.16);
  }

  .review-form-error {
    font-size: 0.85rem;
    color: #7a2e1f;
    background: rgba(158, 73, 54, 0.1);
    border-left: 3px solid var(--russet);
    padding: 10px 14px;
    border-radius: var(--radius);
    margin: 0 0 16px;
  }
  .review-form-error.is-hidden { display: none; }

  @media (max-width: 940px) {
    .tour-reviews__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    .tour-reviews__grid { grid-template-columns: 1fr; }
    .tour-detail__map { height: 240px; }
  }

  .site-footer {
    background: var(--forest-deep);
    color: var(--parchment-alt);
    padding-block: 40px;
    border-top: 1px solid var(--line);
  }
  .site-footer__row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    flex-wrap: wrap;
  }
  .site-footer__logo {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--cream);
    margin: 0 0 8px;
  }
  .site-footer__logo em { color: var(--gold); }
  .site-footer__text {
    max-width: 46ch;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--parchment-alt);
    margin: 0;
  }
  .site-footer__copy {
    font-size: 0.78rem;
    color: rgba(242, 234, 215, 0.6);
    margin: 0;
  }
</style>

<script define:vars={{ tourId: tour.id }}>
  const carousel = document.getElementById('gallery-carousel');
  const dotsWrap = document.getElementById('gallery-dots');

  if (carousel && dotsWrap) {
    const slides = Array.from(carousel.querySelectorAll('[data-slide]'));
    const dots = Array.from(dotsWrap.querySelectorAll('[data-dot]'));

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        slides[i]?.scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
      });
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const idx = slides.indexOf(entry.target);
            dots.forEach((d) => d.classList.remove('is-active'));
            dots[idx]?.classList.add('is-active');
          }
        });
      },
      { root: carousel, threshold: 0.6 }
    );
    slides.forEach((s) => observer.observe(s));
    dots[0]?.classList.add('is-active');
  }

  const form = document.getElementById('review-form');

  if (form) {
    const starPicker = document.getElementById('star-picker');
    const starsInput = document.getElementById('review-stars');
    const contentInput = document.getElementById('review-content');
    const errorEl = document.getElementById('review-form-error');
    const submitBtn = document.getElementById('review-submit');
    const formCard = document.getElementById('review-form-card');

    let selectedStars = 0;

    function paintStars(count) {
      starPicker.querySelectorAll('.star-picker__star').forEach((btn) => {
        const n = Number(btn.dataset.star);
        btn.classList.toggle('is-filled', n <= count);
      });
    }

    starPicker?.addEventListener('click', (e) => {
      const btn = e.target.closest('.star-picker__star');
      if (!btn) return;
      selectedStars = Number(btn.dataset.star);
      starsInput.value = String(selectedStars);
      paintStars(selectedStars);
    });

    starPicker?.addEventListener('mouseover', (e) => {
      const btn = e.target.closest('.star-picker__star');
      if (!btn) return;
      paintStars(Number(btn.dataset.star));
    });
    starPicker?.addEventListener('mouseleave', () => paintStars(selectedStars));

    function showError(message) {
      errorEl.textContent = message;
      errorEl.classList.remove('is-hidden');
    }
    function clearError() {
      errorEl.textContent = '';
      errorEl.classList.add('is-hidden');
    }
    function escapeHtml(value) {
      const div = document.createElement('div');
      div.textContent = value ?? '';
      return div.innerHTML;
    }

    function starsSvg(count) {
      let out = '';
      for (let i = 0; i < 5; i++) {
        const filled = i < count;
        out += `<svg viewBox="0 0 20 20" width="13" height="13" fill="${filled ? 'var(--gold)' : 'none'}" stroke="var(--gold)" stroke-width="${filled ? '0' : '1.4'}"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.1-5.4 3.1 1.3-6-4.6-4.1 6.1-.6L10 1.5Z"/></svg>`;
      }
      return out;
    }

    function buildReviewCard(review) {
      const div = document.createElement('div');
      div.className = 'review-card';
      const quoteHtml = review.content
        ? `<p class="review-card__quote">&ldquo;${escapeHtml(review.content)}&rdquo;</p>`
        : '';
      div.innerHTML = `
        <div class="review-card__stars" aria-label="${review.stars} de 5 estrellas">${starsSvg(review.stars)}</div>
        ${quoteHtml}
        <p class="review-card__reviewer">${escapeHtml(review.customer_name)}</p>
      `;
      return div;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearError();

      if (!selectedStars) {
        showError('Selecciona una puntuación.');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Publicando…';

      try {
        const res = await fetch(`/api/tours/${tourId}/reviews`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            stars: selectedStars,
            content: contentInput.value.trim() || undefined
          })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data?.message || 'No se ha podido publicar la reseña.');

        document.getElementById('reviews-empty-notice')?.remove();
        let grid = document.getElementById('reviews-grid');
        if (!grid) {
          grid = document.createElement('div');
          grid.className = 'tour-reviews__grid';
          grid.id = 'reviews-grid';
          formCard.closest('.wrap')?.appendChild(grid);
        }
        grid.prepend(buildReviewCard(data));

        formCard.outerHTML =
          '<div class="review-cta review-cta--done"><p>¡Gracias! Tu reseña se ha publicado.</p></div>';
      } catch (err) {
        showError(err?.message || 'No se ha podido publicar la reseña.');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Publicar reseña';
      }
    });
  }
</script>

<script define:vars={{ lat: tour.meeting_point_lat, lng: tour.meeting_point_lng, address: tour.meeting_point ?? '' }}>
  function initMeetingPointMap() {
    if (lat == null || lng == null) return;
    const mapEl = document.getElementById('meeting-point-map');
    if (!mapEl || typeof L === 'undefined') return;

    const map = L.map('meeting-point-map', { scrollWheelZoom: false }).setView([lat, lng], 16);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
    }).addTo(map);
    L.marker([lat, lng]).addTo(map).bindPopup(address || 'Punto de encuentro');
  }

  if (typeof L !== 'undefined') {
    initMeetingPointMap();
  } else {
    window.addEventListener('load', initMeetingPointMap);
  }
</script>
</script>
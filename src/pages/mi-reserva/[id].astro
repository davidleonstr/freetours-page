---
// Requires two additions you don't have yet — see the bottom of this file
// for exact code to paste:
//   1. src/lib/api.js        -> updateBooking(id, data, token), cancelBooking(id, token)
//   2. src/pages/api/bookings/[id].js  -> PATCH + DELETE proxy route
//
// Booking fields used below come directly from GET /bookings/:id in your
// bookings.js: id, customer_id, tour_id, tour_date_id, tour_schedule_id,
// quantity, number_of_children, number_of_babies, status, created_at,
// tour_name, tour_date, departure_time, customer_name, customer_email.
import Nav from "@/components/Nav.astro";
import WhatsAppButton from '@/components/WhatsAppButton.astro';
import ConfirmDialog from "@/components/ConfirmDialog.astro";
import { ApiError, getBooking, getTourDates, getTourSchedules } from "@/lib/api.js";
import "@/styles/global.css";

// --------------- STRICT AUTH ---------------
//import { ApiError, getBooking, getTourDates, getTourSchedules, getCurrentCustomer } from "@/lib/api.js";
//import { getSessionToken, clearSessionCookie } from "@/lib/session.js";

export const prerender = false;

const { id } = Astro.params;

// --------------- STRICT AUTH ---------------
//// --- Auth ---
//const sessionToken = getSessionToken(Astro.cookies);
//if (!sessionToken) {
//  return Astro.redirect(`/iniciar-sesion?redirect=/my-reserva/${id}`);
//}

//let currentCustomer: { id: string; full_name: string; email: string } | null = null;
//try {
//  currentCustomer = await getCurrentCustomer(sessionToken);
//} catch {
//  clearSessionCookie(Astro.cookies);
//  return Astro.redirect(`/iniciar-sesion?redirect=/my-reserva/${id}`);
//}

// --- Load the booking ---
// GET /bookings/:id has no auth requirement on the backend (anyone with the
// id can fetch it), so the ownership check below is what actually protects
// this — it must happen before anything is rendered.
interface Booking {
  id: string;
  customer_id: string;
  tour_id: string;
  tour_date_id: string;
  tour_schedule_id: string;
  quantity: number;
  number_of_children: number;
  number_of_babies: number;
  number_of_pets: number;
  status: string;
  created_at: string;
  tour_name: string;
  tour_date: string;
  departure_time: string;
}

let booking: Booking | null = null;
try {
  booking = await getBooking(id as string);
} catch (err) {
  if (err instanceof ApiError && err.status === 404) {
    return Astro.redirect("/404");
  }
  throw err;
}

// --------------- STRICT AUTH ---------------
//if (!booking || booking.customer_id !== currentCustomer?.id) {
//  return Astro.redirect("/404");
//}

if (!booking) {
  return Astro.redirect("/404");
}

// Matches the backend's own rule in PATCH/DELETE /bookings/:id.
const canModify = !["cancelled", "completed"].includes(booking.status);

// Only needed for the edit form's date/time dropdowns.
let tourDates: any[] = [];
let tourSchedules: any[] = [];
if (canModify) {
  try {
    [tourDates, tourSchedules] = await Promise.all([
      getTourDates(booking.tour_id),
      getTourSchedules(booking.tour_id)
    ]);
  } catch (err) {
    console.error("No se han podido cargar las fechas/horarios disponibles para editar", err);
  }
}

const formatDate = (value: string) => {
  const datePart = value.includes("T") ? value.split("T")[0] : value;
  return new Date(datePart + "T00:00:00").toLocaleDateString("es-ES", {
    day: "numeric",
    month: "long",
    year: "numeric"
  });
};

const statusLabel: Record<string, string> = {
  cancelled: "Cancelada"
};

const partySummary = [
  `${booking.quantity} adulto${booking.quantity === 1 ? "" : "s"}`,
  booking.number_of_children ? `${booking.number_of_children} niño${booking.number_of_children === 1 ? "" : "s"}` : null,
  booking.number_of_babies ? `${booking.number_of_babies} bebé${booking.number_of_babies === 1 ? "" : "s"}` : null,
  booking.number_of_pets ? `${booking.number_of_pets} mascota${booking.number_of_pets === 1 ? "" : "s"}` : null
].filter(Boolean).join(", ");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mi reserva — Meriyo Tours (Dublin)</title>
    <link rel="icon" href="/web-icon-orange.svg" />
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;1,500;1,600&family=Work+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Nav />
    <main>
      <section class="reserva-detail">
        <div class="wrap reserva-detail__inner">
          <p class="eyebrow">Mi reserva</p>
          <h1 class="reserva-detail__title">{booking.tour_name}</h1>

          <p class="admin__banner is-hidden" id="reserva-banner" role="status"></p>

          <div class="reserva-card" id="reserva-card" data-reserva-id={booking.id} data-can-modify={canModify ? "true" : "false"}>
            <div class="reserva-card__row">
              {booking.status === 'cancelled' && (
                <>
                  <span class="reserva-card__label">Estado</span> 
                  <span class={`status-pill status-pill--${booking.status}`} id="status-pill">
                    {statusLabel[booking.status] ?? booking.status}
                  </span>
                </>
              )}
            </div>
            <div class="reserva-card__row">
              <span class="reserva-card__label">Fecha</span>
              <span id="reserva-date-display">{formatDate(booking.tour_date)}</span>
            </div>
            <div class="reserva-card__row">
              <span class="reserva-card__label">Hora de salida</span>
              <span id="reserva-time-display">{booking.departure_time}</span>
            </div>
            <div class="reserva-card__row">
              <span class="reserva-card__label">Personas</span>
              <span id="reserva-party-display">{partySummary}</span>
            </div>
            <div class="reserva-card__row">
              <span class="reserva-card__label">Nº de reserva</span>
              <span class="reserva-card__mono">{booking.id}</span>
            </div>
          </div>

          {!canModify && (
            <p class="reserva-detail__notice">
              {booking.status === "cancelled"
                ? "Esta reserva está cancelada. Si crees que se trata de un error, contáctanos."
                : "Esta reserva ya se ha completado y no se puede modificar."}
            </p>
          )}

          {canModify && (
            <div class="reserva-actions">
              <button type="button" class="btn ghost-btn" id="edit-reserva-btn">Editar reserva</button>
              <button type="button" class="btn danger-btn" id="cancel-reserva-btn">Cancelar reserva</button>
            </div>
          )}

          {canModify && (
            <form id="edit-reserva-form" class="edit-reserva-form is-hidden">
              <h2 class="edit-reserva-form__title">Editar reserva</h2>

              {tourDates.length > 0 && (
                <div class="field">
                  <label for="edit-date">Fecha</label>
                  <div class="select-wrap">
                    <select id="edit-date" name="tourDateId">
                      {tourDates.map((d: any) => (
                        <option value={d.id} selected={d.id === booking!.tour_date_id}>
                          {formatDate(d.date)}
                        </option>
                      ))}
                    </select>
                  </div>
                </div>
              )}

              {tourSchedules.length > 0 && (
                <div class="field">
                  <label for="edit-schedule">Hora</label>
                  <div class="select-wrap">
                    <select id="edit-schedule" name="tourScheduleId">
                      {tourSchedules.map((s: any) => (
                        <option value={s.id} selected={s.id === booking!.tour_schedule_id}>
                          {s.time}
                        </option>
                      ))}
                    </select>
                  </div>
                </div>
              )}

              <div class="field-row">
                <div class="field">
                  <label for="edit-quantity">Adultos</label>
                  <input type="number" id="edit-quantity" min="1" max="20" value={booking.quantity} required />
                </div>
                <div class="field">
                  <label for="edit-children">Niños</label>
                  <input type="number" id="edit-children" min="0" max="20" value={booking.number_of_children} />
                </div>
                <div class="field">
                  <label for="edit-babies">Bebés</label>
                  <input type="number" id="edit-babies" min="0" max="20" value={booking.number_of_babies} />
                </div>
                <div class="field">
                  <label for="edit-pets">Mascotas</label>
                  <input type="number" id="edit-pets" min="0" max="20" value={booking.number_of_pets} />
                </div>
              </div>

              <p class="panel__error is-hidden" id="edit-reserva-error" role="alert"></p>

              <div class="edit-reserva-form__actions">
                <button type="submit" class="btn orange-btn" id="save-reserva-btn">Guardar cambios</button>
                <button type="button" class="btn ghost-btn" id="cancel-edit-btn">Cancelar</button>
              </div>
            </form>
          )}
        </div>
      </section>
    </main>

    <ConfirmDialog />

    <footer class="site-footer" id="sobre-mi">
      <div class="wrap site-footer__row">
        <div>
          <p class="site-footer__logo"><em>Meriyo</em> Tours <em>Dublín</em></p>
          <p class="site-footer__text">
            Dublín que no sale en las
            postales. Free tours con reserva anticipada.
          </p>
        </div>
        <div class="footer__social" aria-label="Redes sociales">
          <a href="https://www.instagram.com/meriyotoursdublin?utm_source=qr&igsi=bW1sMWg2cTl3aXdl " aria-label="Instagram" class="nav__icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="3" y="3" width="18" height="18" rx="5"/>
              <circle cx="12" cy="12" r="4.2"/>
              <circle cx="17.3" cy="6.7" r="0.9" fill="currentColor" stroke="none"/>
            </svg>
          </a>
          <a href="https://www.tiktok.com/@meriyotours?_r=1&_t=ZN-996MxyUnSGk " aria-label="TikTok" class="nav__icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
              <path d="M14.5 3h2.6c.2 1.6 1.2 3 2.8 3.6v2.7c-1.4 0-2.8-.4-3.9-1.2v6.6c0 3-2.4 5.3-5.4 5.3S5.2 17.7 5.2 14.7c0-2.9 2.3-5.2 5.2-5.3v2.8c-1.3.1-2.4 1.2-2.4 2.5 0 1.4 1.2 2.5 2.6 2.5s2.6-1.1 2.6-2.5V3z"/>
            </svg>
          </a>
          <a href="https://www.facebook.com/people/MeriyoTours/61593730161963/?rdid=iuVWVNEKzYqnFpZ3&share_url=https%3A%2F% 2Fwww.facebook.com%2Fshare%2F1H9FrGtubn%2F " aria-label="Facebook" class="nav__icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
              <path d="M13.5 21v-7.6h2.6l.4-3h-3v-1.9c0-.9.2-1.5 1.5-1.5h1.6V4.3C15.9 4.2 15 4.1 14 4.1c-2.3 0-3.9 1.4-3.9 4v2.3H7.5v3H10V21h3.5z"/>

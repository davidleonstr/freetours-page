  .site-footer__row { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; }
  .site-footer__logo { font-family: var(--font-display); font-style: italic; font-size: 1.05rem; color: var(--cream); margin: 0 0 8px; }
  .site-footer__logo em { color: var(--gold); }
  .site-footer__text { max-width: 46ch; font-size: 0.85rem; line-height: 1.6; color: var(--parchment-alt); margin: 0; }

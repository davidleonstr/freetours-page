    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 0;
    border-bottom: 1px dashed rgba(24, 34, 25, 0.12);
    font-size: 0.94rem;
    color: var(--ink);
  }
  .reserva-card__row:last-child { border-bottom: none; }

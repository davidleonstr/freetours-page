---
import Nav from "@/components/Nav.astro";
import "@/styles/global.css";
import { getCurrentCustomer } from "@/lib/api.js";
import { getSessionToken, clearSessionCookie } from "@/lib/session.js";

export const prerender = false;

const redirectTo = "/cuenta-creada";

const token = getSessionToken(Astro.cookies);
if (!token) {
  return Astro.redirect(`/crear-cuenta?redirect=${encodeURIComponent(redirectTo)}`);
}

interface Customer {
    full_name: string;
    email: string;
}

let customer: Customer | null = null;
try {
  customer = await getCurrentCustomer(token) as Customer;
} catch {
  clearSessionCookie(Astro.cookies);
  return Astro.redirect(`/crear-cuenta?redirect=${encodeURIComponent(redirectTo)}`);
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cuenta creada — Tours Meriyo Dublín</title>
    <link rel="icon" href="/web-icon-orange.svg" />
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;1,500;1,600&family=Work+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Nav />
    <main>
      <section class="status-page">
        <div class="wrap status-page__inner">
          <div class="status-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="var(--gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10" />
              <path d="M8 12.5l2.5 2.5L16 9.5" />
            </svg>
          </div>

          <p class="eyebrow status-page__eyebrow">¡Todo listo!</p>
          <h1 class="status-page__title">Cuenta creada, {customer.full_name.split(' ')[0]}</h1>
          <p class="status-page__text">
            Tu cuenta se ha creado y verificado con <strong>{customer.email}</strong>.
            Ya has iniciado sesión — no necesitarás una contraseña, solo un código
            cada vez que vuelvas a entrar.
          </p>

          <div class="status-page__actions">
            <a href={'/'} class="btn orange-btn rounded-btn">Continuar</a>
            <a href="/#excursiones" class="btn btn-ghost">Ver excursiones</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer" id="sobre-mi">
      <div class="wrap site-footer__row">
        <div>
          <p class="site-footer__logo">Tours <em>Meriyo</em> Dublín</p>
          <p class="site-footer__text">
            Guías locales, grupos reducidos y el Dublín que no sale en las postales.
          </p>
        </div>
        <p class="site-footer__copy">© {new Date().getFullYear()} Tours Meriyo Dublín</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  .status-page {
    min-height: 60vh;
    display: flex;
    align-items: center;
    background: var(--forest-deep);
    color: var(--parchment-alt);
  }
  .status-page__inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: 80px;
  }
  .status-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: rgba(233, 151, 10, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }
  .status-page__eyebrow { color: var(--gold-soft); }
  .status-page__title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.15;
    color: var(--cream);
    margin: 14px 0 16px;
  }
  .status-page__text {
    max-width: 46ch;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--parchment-alt);
    margin: 0 0 36px;
  }
  .status-page__text strong { color: var(--cream); }
  .status-page__actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
  }

  @media (max-width: 640px) {
    .status-page__inner { padding-block: 60px; }
  }

  .site-footer {
    background: var(--forest-deep);
    color: var(--parchment-alt);
    padding-block: 40px;
    border-top: 1px solid var(--line);
  }
  .site-footer__row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    flex-wrap: wrap;
  }
  .site-footer__logo {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--cream);
    margin: 0 0 8px;
  }
  .site-footer__logo em { color: var(--gold); }
  .site-footer__text {
    max-width: 46ch;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--parchment-alt);
    margin: 0;
  }
  .site-footer__copy {
    font-size: 0.78rem;
    color: rgba(242, 234, 215, 0.6);
    margin: 0;
  }
</style>
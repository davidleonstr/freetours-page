---
import Nav from "@/components/Nav.astro";
import "@/styles/global.css";

interface Props {
  feature?: string;
}

const { feature = "Esta función" } = Astro.props as Props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Próximamente — Meriyo Tours (Dublin)</title>
    <link rel="icon" href="/web-icon-orange.svg" />
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;1,500;1,600&family=Work+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Nav />
    <main>
      <section class="soon">
        <div class="wrap soon__inner">
          <p class="eyebrow soon__eyebrow">Muy pronto</p>
          <h1 class="soon__title">{feature} está en camino</h1>
          <p class="soon__text">
            Estamos preparando esta parte de la web para que tu experiencia
            reservando y descubriendo Dublín sea aún mejor. Vuelve pronto
            para verlo en marcha.
          </p>

          <div class="soon__actions">
            <a href="/" class="btn orange-btn rounded-btn">Volver al inicio</a>
            <a href="/reservar" class="btn btn-ghost">Reservar un tour</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer" id="sobre-mi">
      <div class="wrap site-footer__row">
        <div>
          <p class="site-footer__logo">Meriyo Tours <em>Dublín</em></p>
          <p class="site-footer__text">
            Dublín que no sale en las
            postales. Free tours con reserva anticipada.
          </p>
        </div>
        <p class="site-footer__copy">© {new Date().getFullYear()} Meriyo Tours (Dublin)</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  .soon {
    min-height: 72vh;
    display: flex;
    align-items: center;
    background: var(--forest-deep);
    color: var(--parchment-alt);
  }

  .soon__inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: 90px;
  }

  .soon__title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(2rem, 4vw, 3.1rem);
    line-height: 1.15;
    margin: 14px 0 18px;
  }

  .soon__text {
    max-width: 48ch;
    font-size: 1rem;
    line-height: 1.65;
    margin: 0 0 36px;
  }

  .soon__actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
  }

  @media (max-width: 640px) {
    .soon__inner { padding-block: 60px; }
  }

  .site-footer {
    background: var(--forest-deep);
    color: var(--parchment-alt);
    padding-block: 40px;
    border-top: 1px solid var(--line);
  }
  .site-footer__row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    flex-wrap: wrap;
  }
  .site-footer__logo {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--cream);
    margin: 0 0 8px;
  }
  .site-footer__logo em { color: var(--gold); }
  .site-footer__text {
    max-width: 46ch;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--parchment-alt);
    margin: 0;
  }
  .site-footer__copy {
    font-size: 0.78rem;
    color: rgba(242, 234, 215, 0.6);
    margin: 0;
  }
</style>
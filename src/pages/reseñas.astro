---
import Nav from "@/components/Nav.astro";
import ReviewCard from "@/components/ReviewCard.astro";
import {
  getTours,
  getTourGallery,
  getAllTourReviews,
  getTourReviewSummary,
  getCurrentCustomer,
  ApiError,
} from "@/lib/api.js";
import { getSessionToken, clearSessionCookie } from "@/lib/session.js";
import "@/styles/global.css";

// This page reads the session cookie and hits several endpoints per
// request (same reasoning as Booking.astro / the tour detail page), so it
// can't be statically prerendered.
export const prerender = false;

interface ApiTour {
  id: string;
  name: string;
  description: string;
  duration_hours: number | null;
  capacity: number | null;
  is_active: boolean;
}

interface TourWithCover extends ApiTour {
  cover: string | null;
}

interface ApiReview {
  id: string;
  stars: number;
  content: string | null;
  tour_id: string;
  customer_id: string;
  created_at: string;
  tour_name: string;
  customer_name: string;
}

interface ReviewSummary {
  tourId: string;
  reviewCount: number;
  averageStars: number;
  breakdown: Record<string, number>;
}

interface CurrentCustomer {
  id: string;
  full_name: string;
  email: string;
}

// --- Tours (active only, same as Tours.astro) ---
let tours: TourWithCover[] = [];
let loadError = false;

try {
  const activeTours: ApiTour[] = await getTours({ active: true });
  tours = await Promise.all(
    activeTours.map(async (t) => {
      try {
        const gallery = await getTourGallery(t.id);
        return { ...t, cover: gallery[0]?.url ?? null };
      } catch {
        return { ...t, cover: null };
      }
    })
  );
} catch (err) {
  console.error("Failed to load tours from the API", err);
  loadError = true;
}

// --- Per-tour summaries (average stars + count), used for the "by route" cards ---
const summaries = new Map<string, ReviewSummary>();
let summariesError = false;

if (!loadError) {
  try {
    const results = await Promise.all(
      tours.map((t) =>
        getTourReviewSummary(t.id).catch(
          (): ReviewSummary => ({
            tourId: t.id,
            reviewCount: 0,
            averageStars: 0,
            breakdown: {},
          })
        )
      )
    );
    results.forEach((s) => summaries.set(s.tourId, s));
  } catch (err) {
    console.error("Failed to load review summaries", err);
    summariesError = true;
  }
}

// --- Every review across every active tour, newest first ---
// There's no single "all reviews" endpoint, so we fetch per tour (same
// call the tour detail page already makes) and merge them here.
let allReviews: ApiReview[] = [];
let reviewsError = false;

if (!loadError) {
  try {
    const perTour = await Promise.all(
      tours.map((t) => getAllTourReviews(t.id).catch(() => [] as ApiReview[]))
    );
    allReviews = perTour
      .flat()
      .sort(
        (a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime()
      );
  } catch (err) {
    console.error("Failed to load reviews from the API", err);
    reviewsError = true;
  }
}

const totalReviews = allReviews.length;
const overallAverage =
  totalReviews > 0
    ? allReviews.reduce((sum, r) => sum + r.stars, 0) / totalReviews
    : 0;

// --- Logged-in customer (same pattern as Booking.astro / tour detail page) ---
let currentCustomer: CurrentCustomer | null = null;
const sessionToken = getSessionToken(Astro.cookies);
if (sessionToken) {
  try {
    currentCustomer = await getCurrentCustomer(sessionToken);
  } catch {
    clearSessionCookie(Astro.cookies);
  }
}

// --- Eligibility: just needs an active session. Any logged-in customer
// can review any active tour — the picker below lists every active tour,
// and the API is the source of truth for "already reviewed this tour"
// when the form is submitted, exactly like it does on the tour detail page.
const canShowForm = !!currentCustomer && tours.length > 0;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reseñas — Meriyo Tours (Dublin)</title>
    <link rel="icon" href="/web-icon-orange.svg" />
    <meta
      name="description"
      content="Todas las opiniones de nuestros viajeros sobre las rutas de Meriyo Tours en Dublín."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;1,500;1,600&family=Work+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Nav />
    <main>
      <section class="reviews-hub-hero">
        <div class="wrap">
          <p class="eyebrow">Opiniones</p>
          <h1 class="reviews-hub-hero__title">Lo que dicen nuestros viajeros</h1>
          <p class="reviews-hub-hero__lede">
            Reseñas reales de personas que hicieron alguna de nuestras rutas por Dublín.
          </p>
        </div>
      </section>

    {!reviewsError && canShowForm && (
        <section class="reviews-hub-form-section">
          <div class="wrap">
            <div class="review-form-card" id="review-form-card">
              <h3 class="review-form-card__title">Deja tu reseña</h3>
              <p class="review-form-card__hint">
                Elige la ruta que quieres reseñar.
              </p>
              <form id="review-form" novalidate>
                <div class="field">
                  <label for="review-tour">Ruta<em>*</em></label>
                  <select id="review-tour" name="tour_id" required>
                    <option value="" selected disabled>
                      Elige la ruta que quieres reseñar…
                    </option>
                    {tours.map((t) => (
                      <option value={t.id}>{t.name}</option>
                    ))}
                  </select>
                </div>
                <div class="field">
                  <label id="star-picker-label">Puntuación<em>*</em></label>
                  <div
                    class="star-picker"
                    id="star-picker"
                    role="radiogroup"
                    aria-labelledby="star-picker-label"
                  >
                    {[1, 2, 3, 4, 5].map((n) => (
                      <button
                        type="button"
                        class="star-picker__star"
                        data-star={n}
                        aria-label={`${n} estrellas`}
                      >
                        ★
                      </button>
                    ))}
                  </div>
                  <input type="hidden" id="review-stars" name="stars" />
                </div>
                <div class="field">
                  <label for="review-content">
                    Comentario <span class="field__optional">(opcional)</span>
                  </label>
                  <textarea id="review-content" name="content" rows="4" maxlength="5000"></textarea>
                </div>
                <p class="review-form-error is-hidden" id="review-form-error" role="alert"></p>
                <button type="submit" class="btn orange-btn" id="review-submit">
                  Publicar reseña
                </button>
              </form>
            </div>
          </div>
        </section>
      )}

      <section class="reviews-hub-bytour">
        <div class="wrap">
          <p class="eyebrow">Por ruta</p>
          <h2 class="reviews-hub-section-title">Reseñas por ruta</h2>

          {loadError && (
            <p class="reviews-hub-notice">
              No hemos podido cargar las rutas en este momento. Inténtalo de nuevo más tarde.
            </p>
          )}

          {!loadError && tours.length === 0 && (
            <p class="reviews-hub-notice">Todavía no hay rutas publicadas.</p>
          )}

          {!loadError && tours.length > 0 && (
            <div class="tour-summary-grid">
              {tours.map((t) => {
                const s = summaries.get(t.id);
                return (
                  <a href={`/tours/${t.id}#reviews`} class="tour-summary-card">
                    <div
                      class={`tour-summary-card__media${t.cover ? "" : " tour-summary-card__media--empty"}`}
                      style={t.cover ? `background-image:url(${t.cover})` : undefined}
                    >
                      <div class="tour-summary-card__scrim"></div>
                      <h3 class="tour-summary-card__name">{t.name}</h3>
                    </div>
                    <div class="tour-summary-card__footer">
                      {s && s.reviewCount > 0 ? (
                        <span class="tour-summary-card__rating">
                          ★ {s.averageStars.toFixed(1)}
                          <span class="tour-summary-card__count">
                            ({s.reviewCount} {s.reviewCount === 1 ? "reseña" : "reseñas"})
                          </span>
                        </span>
                      ) : (
                        <span class="tour-summary-card__rating tour-summary-card__rating--empty">
                          Sin reseñas todavía
                        </span>
                      )}
                      <span class="tour-summary-card__link">Ver ruta y reseñas →</span>
                    </div>
                  </a>
                );
              })}
            </div>
          )}
        </div>
      </section>

      <section class="reviews-hub-all">
        <div class="wrap">
          <div class="reviews-hub-all__head">
            <div>
              <p class="eyebrow">Todas</p>
              <h2 class="reviews-hub-section-title" id="all-reviews">Todas las opiniones</h2>
            </div>

            {!reviewsError && !loadError && tours.length > 0 && totalReviews > 0 && (
              <div class="reviews-hub-filter">
                <label for="reviews-filter">Filtrar por ruta</label>
                <select id="reviews-filter">
                  <option value="all">Todas las rutas</option>
                  {tours.map((t) => (
                    <option value={t.id}>{t.name}</option>
                  ))}
                </select>
              </div>
            )}
          </div>

          {reviewsError && (
            <p class="reviews-hub-notice">
              No hemos podido cargar las reseñas en este momento. Inténtalo de nuevo más tarde.
            </p>
          )}

          {!reviewsError && totalReviews === 0 && (
            <p class="reviews-hub-notice" id="reviews-empty-notice">
              Todavía no hay reseñas publicadas.
            </p>
          )}

          {!reviewsError && totalReviews > 0 && (
            <>
              <div class="tours__grid" id="reviews-grid">
                {allReviews.map((r, i) => (
                  <div
                    class="reviews-hub-item"
                    data-tour-id={r.tour_id}
                    data-index={i}
                    style={i >= 9 ? "display:none" : undefined}
                  >
                    <ReviewCard
                      content={r.content}
                      stars={r.stars}
                      customerName={r.customer_name}
                      tourName={r.tour_name}
                    />
                  </div>
                ))}
              </div>

              {totalReviews > 9 && (
                <div class="reviews-hub-loadmore">
                  <button type="button" class="btn btn-ghost" id="reviews-load-more">
                    Cargar más reseñas
                  </button>
                </div>
              )}

              <p class="reviews-hub-notice is-hidden" id="reviews-filter-empty">
                No hay reseñas todavía para esta ruta.
              </p>
            </>
          )}
        </div>
      </section>
    </main>

    <footer class="site-footer" id="sobre-mi">
      <div class="wrap site-footer__row">
        <div>
          <p class="site-footer__logo"><em>Meriyo</em> Tours <em>Dublín</em></p>
          <p class="site-footer__text">
            Dublín que no sale en las postales. Free tours con reserva anticipada.
          </p>
        </div>
        <div class="footer__social" aria-label="Redes sociales">
          <a href="https://www.instagram.com/meriyotoursdublin?utm_source=qr&igsi=bW1sMWg2cTl3aXdl " aria-label="Instagram" class="nav__icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="3" y="3" width="18" height="18" rx="5"/>
              <circle cx="12" cy="12" r="4.2"/>
              <circle cx="17.3" cy="6.7" r="0.9" fill="currentColor" stroke="none"/>
            </svg>
          </a>
          <a href="https://www.tiktok.com/@meriyotours?_r=1&_t=ZN-996MxyUnSGk " aria-label="TikTok" class="nav__icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
              <path d="M14.5 3h2.6c.2 1.6 1.2 3 2.8 3.6v2.7c-1.4 0-2.8-.4-3.9-1.2v6.6c0 3-2.4 5.3-5.4 5.3S5.2 17.7 5.2 14.7c0-2.9 2.3-5.2 5.2-5.3v2.8c-1.3.1-2.4 1.2-2.4 2.5 0 1.4 1.2 2.5 2.6 2.5s2.6-1.1 2.6-2.5V3z"/>
            </svg>
          </a>
          <a href="https://www.facebook.com/people/MeriyoTours/61593730161963/?rdid=iuVWVNEKzYqnFpZ3&share_url=https%3A%2F% 2Fwww.facebook.com%2Fshare%2F1H9FrGtubn%2F " aria-label="Facebook" class="nav__icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
              <path d="M13.5 21v-7.6h2.6l.4-3h-3v-1.9c0-.9.2-1.5 1.5-1.5h1.6V4.3C15.9 4.2 15 4.1 14 4.1c-2.3 0-3.9 1.4-3.9 4v2.3H7.5v3H10V21h3.5z"/>
            </svg>
          </a>
          <a href="https://x.com/meriyotours " aria-label="X (Twitter)" class="nav__icon">
            <svg viewBox="0 0 24 24" width="29" height="29" fill="currentColor">
              <path d="M18.9 3h3.1l-6.8 7.7L23.2 21h-6.3l-4.9-6.4L6.3 21H3.2l7.2-8.3L2.8 3h6.4l4.5 5.9L18.9 3zm-1.1 16.2h1.7L7.3 4.7H5.5l12.3 14.5z"/>
            </svg>
          </a>
          <a href="https://www.youtube.com/@meriyotours " aria-label="YouTube" class="nav__icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
              <path d="M22.5 7.2c-.3-1.1-1.1-1.9-2.2-2.2C18.4 4.5 12 4.5 12 4.5s-6.4 0-8.3.5c-1.1.3-1.9 1.1-2.2 2.2C1 9.1 1 12 1 12s0 2.9.5 4.8c.3 1.1 1.1 1.9 2.2 2.2 1.9.5 8.3.5 8.3.5s6.4 0 8.3-.5c1.1-.3 1.9-1.1 2.2-2.2.5-1.9.5-4.8.5-4.8s0-2.9-.5-4.8zM9.8 15.3V8.7l6 3.3-6 3.3z"/>
            </svg>
          </a>
        </div>
        <div class="display-legal-items">
          <a href="/condiciones-reserva" class="site-footer__copy">Condiciones de reserva</a>
          <a href="/politicas-privacidad" class="site-footer__copy">Políticas de privacidad</a>
          <a href="/politicas-cookies" class="site-footer__copy">Políticas de cookies</a>
          <p class="site-footer__copy">© {new Date().getFullYear()} Meriyo Tours (Dublin)</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  .reviews-hub-hero {
    background: var(--parchment);
    padding-block: 70px 40px;
  }
  .reviews-hub-hero__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 3.6vw, 2.9rem);
    color: var(--ink);
    margin: 10px 0 14px;
  }
  .reviews-hub-hero__lede {
    font-size: 1rem;
    line-height: 1.7;
    color: #3c4a3d;
    margin: 0 0 30px;
    max-width: 60ch;
  }

  .reviews-hub-stats {
    display: flex;
    align-items: center;
    gap: 28px;
    background: var(--cream);
    border: 1px solid rgba(24, 34, 25, 0.1);
    border-top: 3px solid var(--gold);
    border-radius: var(--radius);
    padding: 22px 28px;
    max-width: 560px;
  }
  .reviews-hub-stats__item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }
  .reviews-hub-stats__value {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.7rem;
    color: var(--ink);
  }
  .reviews-hub-stats__label {
    font-size: 0.78rem;
    color: #5a6b5c;
  }
  .reviews-hub-stats__divider {
    width: 1px;
    align-self: stretch;
    background: rgba(24, 34, 25, 0.12);
  }

  .reviews-hub-form-section {
    background: var(--parchment);
    padding-block: 0 50px;
  }

  .reviews-hub-bytour {
    background: var(--parchment);
    padding-block: 10px 70px;
  }
  .reviews-hub-all {
    background: var(--parchment);
    padding-block: 10px 100px;
  }

  .reviews-hub-section-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.6rem, 2.8vw, 2.1rem);
    color: var(--ink);
    margin: 10px 0 30px;
  }

  .reviews-hub-notice {
    font-size: 0.95rem;
    color: #5a6b5c;
    background: var(--cream);
    border: 1px solid rgba(24, 34, 25, 0.12);
    border-radius: var(--radius);
    padding: 16px 20px;
    margin: 0 0 20px;
  }
  .reviews-hub-notice.is-hidden { display: none; }

  /* ---------- Per-tour summary cards ---------- */
  .tour-summary-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .tour-summary-card {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid rgba(24, 34, 25, 0.1);
    border-top: 3px solid var(--gold);
    background: var(--cream);
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .tour-summary-card:hover,
  .tour-summary-card:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(24, 34, 25, 0.12);
  }
  .tour-summary-card__media {
    position: relative;
    height: 170px;
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: flex-end;
    padding: 18px;
  }
  .tour-summary-card__media--empty {
    background: linear-gradient(160deg, var(--forest-deep), #2c3d2d);
  }
  .tour-summary-card__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 14, 10, 0.85) 0%, rgba(10, 14, 10, 0.1) 70%);
  }
  .tour-summary-card__name {
    position: relative;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    color: #fff;
    margin: 0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
  }
  .tour-summary-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 18px;
    gap: 10px;
    flex-wrap: wrap;
  }
  .tour-summary-card__rating {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.92rem;
    color: var(--russet);
  }
  .tour-summary-card__rating--empty {
    font-style: normal;
    color: #8a8272;
    font-family: var(--font-body);
    font-size: 0.85rem;
  }
  .tour-summary-card__count {
    font-style: normal;
    color: #8a8272;
    font-size: 0.8rem;
  }
  .tour-summary-card__link {
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    color: var(--forest-deep);
    font-weight: 600;
  }

  /* ---------- Review form / CTA (shared look with Tours.astro) ---------- */
  .review-form-card {
    background: var(--cream);
    border: 1px solid rgba(24, 34, 25, 0.1);
    border-top: 3px solid var(--gold);
    border-radius: var(--radius);
    padding: 26px 26px 28px;
    max-width: 560px;
  }
  .review-form-card__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--ink);
    margin: 0 0 6px;
  }
  .review-form-card__hint {
    font-size: 0.85rem;
    color: #5a6b5c;
    margin: 0 0 18px;
  }
  .review-form-card .field { margin-bottom: 16px; }
  .review-form-card label {
    display: block;
    font-size: 0.82rem;
    font-weight: 600;
    color: #4a5b4c;
    margin-bottom: 8px;
  }
  .review-form-card label em { font-style: normal; color: var(--russet); margin-left: 2px; }
  .field__optional { font-weight: 400; color: #8a8272; }

  .review-form-card select {
    width: 100%;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--ink);
    background: var(--cream);
    border: 1px solid rgba(24, 34, 25, 0.22);
    border-radius: var(--radius);
    padding: 12px 14px;
  }
  .review-form-card select:focus {
    outline: none;
    border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(233, 151, 10, 0.16);
  }

  .star-picker { display: flex; gap: 6px; }
  .star-picker__star {
    background: none;
    border: none;
    font-size: 1.6rem;
    line-height: 1;
    color: rgba(24, 34, 25, 0.22);
    cursor: pointer;
    padding: 2px;
    transition: color 0.15s ease, transform 0.15s ease;
  }
  .star-picker__star:hover { transform: translateY(-1px); }
  .star-picker__star.is-filled { color: var(--gold); }

  .review-form-card textarea {
    width: 100%;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--ink);
    background: var(--cream);
    border: 1px solid rgba(24, 34, 25, 0.22);
    border-radius: var(--radius);
    padding: 12px 14px;
    resize: vertical;
  }
  .review-form-card textarea:focus {
    outline: none;
    border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(233, 151, 10, 0.16);
  }

  .review-form-error {
    font-size: 0.85rem;
    color: #7a2e1f;
    background: rgba(158, 73, 54, 0.1);
    border-left: 3px solid var(--russet);
    padding: 10px 14px;
    border-radius: var(--radius);
    margin: 0 0 16px;
  }
  .review-form-error.is-hidden { display: none; }

  .review-cta {
    background: var(--cream);
    border: 1px dashed rgba(24, 34, 25, 0.18);
    border-radius: var(--radius);
    padding: 16px 20px;
    font-size: 0.92rem;
    color: #4a5b4c;
    max-width: 560px;
  }
  .review-cta a { color: var(--russet); text-decoration: underline; }
  .review-cta--done {
    background: rgba(72, 122, 74, 0.1);
    border-color: rgba(72, 122, 74, 0.3);
    color: #2e5c30;
  }

  /* ---------- All-reviews grid + filter ---------- */
  .reviews-hub-all__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 16px;

<script>
  // ---------- Filter the "all reviews" grid by tour ----------
  const filterSelect = document.getElementById("reviews-filter") as HTMLSelectElement | null;
  const emptyNotice = document.getElementById("reviews-filter-empty") as HTMLParagraphElement | null;
  const loadMoreBtn = document.getElementById("reviews-load-more") as HTMLButtonElement | null;

  const PAGE_SIZE = 9;
  let visibleCount = PAGE_SIZE;
  let activeTourId = "all";

  function applyFilterAndPaging() {
    const items = document.querySelectorAll<HTMLElement>(".reviews-hub-item");
    let shownSoFar = 0;
    let matchCount = 0;

    items.forEach((item) => {
      const matches = activeTourId === "all" || item.dataset.tourId === activeTourId;
      if (!matches) {
        item.style.display = "none";
        return;
      }
      matchCount++;
      if (shownSoFar < visibleCount) {
        item.style.display = "";
        shownSoFar++;
      } else {
        item.style.display = "none";
      }
    });

    if (emptyNotice) {
      emptyNotice.classList.toggle("is-hidden", matchCount !== 0);
    }
    if (loadMoreBtn) {
      loadMoreBtn.style.display = matchCount > shownSoFar ? "" : "none";
    }
  }

  filterSelect?.addEventListener("change", () => {
    activeTourId = filterSelect.value;
    visibleCount = PAGE_SIZE;
    applyFilterAndPaging();
  });

  loadMoreBtn?.addEventListener("click", () => {
    visibleCount += PAGE_SIZE;
    applyFilterAndPaging();
  });

  applyFilterAndPaging();
</script>

<script>
  // ---------- Review form (tour picker limited to bookedTours from the server) ----------
  const form = document.getElementById("review-form") as HTMLFormElement | null;

  if (form) {
    const tourSelect = document.getElementById("review-tour") as HTMLSelectElement;
    const starPicker = document.getElementById("star-picker") as HTMLDivElement;
    const starsInput = document.getElementById("review-stars") as HTMLInputElement;
    const contentInput = document.getElementById("review-content") as HTMLTextAreaElement;
    const errorEl = document.getElementById("review-form-error") as HTMLParagraphElement;
    const submitBtn = document.getElementById("review-submit") as HTMLButtonElement;
    const formCard = document.getElementById("review-form-card") as HTMLDivElement;

    let selectedStars = 0;

    function paintStars(count: number): void {
      starPicker.querySelectorAll(".star-picker__star").forEach((btn) => {
        const button = btn as HTMLButtonElement;
        const n = Number(button.dataset.star);
        button.classList.toggle("is-filled", n <= count);
      });
    }

    starPicker?.addEventListener("click", (e: MouseEvent) => {
      const target = e.target as HTMLElement;
      const btn = target.closest(".star-picker__star") as HTMLButtonElement | null;
      if (!btn) return;
      selectedStars = Number(btn.dataset.star);
      starsInput.value = String(selectedStars);
      paintStars(selectedStars);
    });

    starPicker?.addEventListener("mouseover", (e: MouseEvent) => {
      const target = e.target as HTMLElement;
      const btn = target.closest(".star-picker__star") as HTMLButtonElement | null;
      if (!btn) return;
      paintStars(Number(btn.dataset.star));
    });

    starPicker?.addEventListener("mouseleave", () => paintStars(selectedStars));

    function showError(message: string): void {
      errorEl.textContent = message;
      errorEl.classList.remove("is-hidden");
    }

    function clearError(): void {
      errorEl.textContent = "";
      errorEl.classList.add("is-hidden");
    }

    form.addEventListener("submit", async (e: SubmitEvent) => {
      e.preventDefault();
      clearError();

      const tourId = tourSelect.value;
      if (!tourId) {
        showError("Elige la ruta que quieres reseñar.");
        return;
      }
      if (!selectedStars) {
        showError("Selecciona una puntuación.");
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = "Publicando…";

      try {
        const res = await fetch(`/api/tours/${tourId}/reviews`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            stars: selectedStars,
            content: contentInput.value.trim() || undefined,
          }),
        });

        const data = await res.json();

        // The API is still the source of truth for "already reviewed this
        // tour" — a duplicate attempt surfaces here as a normal form error.
        if (!res.ok) throw new Error(data?.message || "No se ha podido publicar la reseña.");

        formCard.outerHTML =
          '<div class="review-cta review-cta--done"><p>¡Gracias! Tu reseña se ha publicado. Actualiza la página para verla en el listado.</p></div>';
      } catch (err: any) {
        showError(err?.message || "No se ha podido publicar la reseña.");
        submitBtn.disabled = false;
        submitBtn.textContent = "Publicar reseña";
      }
    });
  }
</script>
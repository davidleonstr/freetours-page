---
// @ts-nocheck
import "@/styles/global.css";
import { listAllTours, getTourGallery } from "@/lib/adminApi.js";
import ConfirmDialog from "@/components/ConfirmDialog.astro";

export const prerender = false;

interface ApiTour {
  id: string;
  name: string;
  is_active: boolean;
}

interface GalleryEntry {
  gallery_id: string;
  position: number;
  image_id: string;
  url: string;
  alt: string | null;
}

let tours: ApiTour[] = [];
let loadError: string | null = null;

try {
  tours = await listAllTours();
} catch (err) {
  console.error("No se han podido cargar las excursiones para el panel de imágenes", err);
  loadError = "No se han podido cargar las excursiones. Recarga la página.";
}

const selectedTourId = Astro.url.searchParams.get("tour") || tours[0]?.id || "";
const selectedTour = tours.find((t) => t.id === selectedTourId) ?? null;

let gallery: GalleryEntry[] = [];
let galleryError: string | null = null;

if (selectedTourId && !loadError) {
  try {
    gallery = await getTourGallery(selectedTourId);
    gallery.sort((a, b) => a.position - b.position);
  } catch (err) {
    console.error("No se ha podido cargar la galería", err);
    galleryError = "No se ha podido cargar la galería de esta ruta.";
  }
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Imágenes — Meriyo Tours (Dublin)</title>
    <link rel="icon" href="/web-icon-orange.svg" />
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;1,500;1,600&family=Work+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="admin-top">
      <div class="wrap admin-top__row">
        <a href="/" class="admin-top__logo">Meriyo Tours <em>Dublín</em></a>
        <span class="admin-top__tag">Panel de imágenes</span>
        <a href="/admin/reservations" class="admin-top__nav-link">Reservas</a>
        <a href="/admin/tours" class="admin-top__nav-link">Excursiones</a>
        <a href="/admin/schedules" class="admin-top__nav-link">Horarios</a>
        <a href="/admin/dates" class="admin-top__nav-link">Fechas</a>   
        <button type="button" class="admin-top__back admin-top__logout" id="admin-logout-btn">Cerrar sesión</button>
        <a href="/" class="admin-top__back">← Volver al sitio</a>
      </div>
    </header>

    <main class="admin">
      <div class="wrap">
        <div class="admin__head">
          <div>
            <p class="eyebrow">Catálogo</p>
            <h1 class="admin__title">Imágenes</h1>
          </div>
        </div>

        {loadError && <p class="admin__notice admin__notice--error">{loadError}</p>}

        <p class="admin__banner is-hidden" id="admin-banner" role="status"></p>

        {!loadError && tours.length === 0 && (
          <p class="admin__notice">
            Todavía no hay excursiones. Crea una primero desde el
            <a href="/admin/tours">panel de excursiones</a>.
          </p>
        )}

        {!loadError && tours.length > 0 && (
          <>
            <div class="admin__card">
              <div class="field">
                <label for="tour-picker">Ruta</label>
                <div class="select-wrap">
                  <select id="tour-picker">
                    {tours.map((t) => (
                      <option value={t.id} selected={t.id === selectedTourId}>
                        {t.name}{!t.is_active ? " (archivada)" : ""}
                      </option>
                    ))}
                  </select>
                </div>
              </div>
            </div>

            {selectedTour && (
              <div class="admin__card" id="gallery-card" data-tour-id={selectedTour.id}>
                <h2 class="admin__card-title">Imágenes de "{selectedTour.name}"</h2>

                {galleryError && <p class="admin__notice admin__notice--error">{galleryError}</p>}

                {!galleryError && (
                  <>
                    <div class="image-grid" id="image-grid">
                      {gallery.length === 0 && (
                        <p class="image-grid__empty" id="image-grid-empty">
                          Todavía no hay imágenes para esta ruta.
                        </p>
                      )}
                      {gallery.map((entry) => (
                        <div class="image-item" data-gallery-id={entry.gallery_id} data-image-id={entry.image_id}>
                          <img src={entry.url} alt={entry.alt ?? ""} class="image-item__thumb" />
                          <div class="image-item__fields">
                            <label>
                              Descripción
                              <textarea class="image-item__desc" rows="2">{entry.alt ?? ""}</textarea>
                            </label>
                            <label class="image-item__position-label">
                              Posición
                              <input type="number" min="0" class="image-item__position" value={entry.position} />
                            </label>
                          </div>
                          <div class="image-item__actions">
                            <button type="button" class="btn orange-btn image-item__save">Guardar</button>
                            <button type="button" class="admin__link-btn admin__link-btn--danger image-item__delete">Eliminar</button>
                          </div>
                          <p class="panel__error is-hidden image-item__error" role="alert"></p>
                        </div>
                      ))}
                    </div>

                    <form id="upload-form" class="upload-form">
                      <div class="field">
                        <label for="new-file">Archivo de imagen</label>
                        <input type="file" id="new-file" accept="image/jpeg,image/png,image/webp,image/gif" required />
                      </div>
                      <div class="field">
                        <label for="new-desc">Descripción</label>
                        <textarea id="new-desc" rows="2" placeholder="Vista del punto de encuentro desde la calle principal"></textarea>
                      </div>
                        <div class="field">
                        <label for="new-position">Posición</label>
                        <input type="number" id="new-position" min="0" value={gallery.length} />
                        </div>
                      <button type="submit" class="btn orange-btn" id="upload-btn">Subir imagen</button>
                    </form>
                    <p class="panel__error is-hidden" id="upload-error" role="alert"></p>
                  </>
                )}
              </div>
            )}
          </>
        )}
      </div>
    </main>

    <ConfirmDialog />

    <style is:global>
      .admin-top {
        background: var(--forest-deep);
        border-bottom: 1px solid var(--line);
      }
      .admin-top__row {
        display: flex;
        align-items: center;
        gap: 20px;
        padding-block: 16px;
      }
      .admin-top__logo {
        font-family: var(--font-display);
        font-style: italic;
        font-size: 1.05rem;
        color: var(--cream);
      }
      .admin-top__logo em { color: var(--gold); }
      .admin-top__tag {
        font-size: 0.78rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--gold-soft);
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 4px 12px;
      }
      .admin-top__nav-link {
        margin-left: auto;
        font-size: 0.85rem;
        color: var(--parchment-alt);
      }
      .admin-top__nav-link + .admin-top__nav-link { margin-left: 16px; }
      .admin-top__nav-link:hover { color: var(--gold-soft); }
      .admin-top__back {
        font-size: 0.85rem;
        color: var(--parchment-alt);
      }
      .admin-top__back:hover { color: var(--gold-soft); }
      .admin-top__logout {
        background: none;
        border: none;
        font-family: inherit;
        cursor: pointer;
        padding: 0;
      }

      .admin { background: var(--parchment); padding-block: 44px 100px; min-height: 60vh; }

      .admin__head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 30px;
      }
      .admin__title {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: clamp(1.8rem, 3vw, 2.4rem);
        color: var(--ink);
        margin: 8px 0 0;
      }

      .admin__notice {
        font-size: 0.92rem;
        border-radius: var(--radius);
        padding: 14px 18px;
        margin: 0 0 22px;
        color: #4a5b4c;
        background: var(--cream);
        border: 1px solid rgba(24, 34, 25, 0.12);
      }
      .admin__notice--error {
        color: #7a2e1f;
        background: rgba(158, 73, 54, 0.1);
        border-left: 3px solid var(--russet);
      }

      .admin__banner {
        font-size: 0.9rem;
        border-radius: var(--radius);
        padding: 12px 18px;
        margin: 0 0 20px;
        background: rgba(233, 151, 10, 0.12);
        border-left: 3px solid var(--gold);
        color: var(--ink);
      }
      .admin__banner.is-hidden { display: none; }
      .admin__banner--error {
        background: rgba(158, 73, 54, 0.1);
        border-left-color: var(--russet);
        color: #7a2e1f;
      }

      .admin__card {
        background: var(--cream);
        border: 1px solid rgba(24, 34, 25, 0.1);
        border-top: 3px solid var(--gold);
        border-radius: var(--radius);
        padding: 26px 28px 28px;
        margin-bottom: 24px;
      }
      .admin__card-title {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1.15rem;
        color: var(--ink);
        margin: 0 0 20px;
      }

      .field { margin-bottom: 0; }
      label {
        display: block;
        font-size: 0.82rem;
        font-weight: 600;
        color: #4a5b4c;
        margin-bottom: 7px;
      }

      input[type="time"],
      input[type="number"],
      input[type="file"],
      textarea,
      select {
        font-family: var(--font-body);
        font-size: 0.95rem;
        color: var(--ink);
        background: var(--cream);
        border: 1px solid rgba(24, 34, 25, 0.22);
        border-radius: var(--radius);
        padding: 11px 14px;
        width: 100%;
      }
      textarea { resize: vertical; }
      select { appearance: none; cursor: pointer; }
      input:focus, select:focus, textarea:focus {
        outline: none;
        border-color: var(--gold);
        box-shadow: 0 0 0 3px rgba(233, 151, 10, 0.16);
      }
      .select-wrap { position: relative; max-width: 360px; }

      .image-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 18px;
        margin-bottom: 26px;
      }
      .image-grid__empty {
        grid-column: 1 / -1;
        padding: 18px 16px;
        color: #7a7562;
        font-size: 0.9rem;
        text-align: center;
        border: 1px solid rgba(24, 34, 25, 0.1);
        border-radius: var(--radius);
        margin: 0;
      }
      .image-item {
        border: 1px solid rgba(24, 34, 25, 0.12);
        border-radius: var(--radius);
        padding: 14px;
        background: var(--parchment);
      }
      .image-item__thumb {
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        border-radius: calc(var(--radius) - 2px);
        margin-bottom: 12px;
        background: rgba(24, 34, 25, 0.06);
      }
      .image-item__fields { display: flex; flex-direction: column; gap: 10px; margin-bottom: 12px; }
      .image-item__desc { min-height: 52px; }
      .image-item__position { max-width: 100px; }
      .image-item__actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
      }

        .upload-form {
        display: flex;
        flex-direction: column;
        gap: 18px;
        }
        .upload-form .field { width: 100%; }
        .upload-form button[type="submit"] {
        align-self: flex-start;
        }
      .upload-form .field { flex: 1; min-width: 200px; }
      .upload-form__position { max-width: 110px; }

      .admin__link-btn {
        background: none;
        border: none;
        font-size: 0.85rem;
        font-family: var(--font-body);
        color: var(--russet);
        cursor: pointer;
        padding: 4px 6px;
      }
      .admin__link-btn:hover { text-decoration: underline; }
      .admin__link-btn--danger { color: #7a2e1f; }
      .admin__link-btn:disabled { opacity: 0.5; cursor: not-allowed; text-decoration: none; }

      .panel__error {
        font-size: 0.85rem;
        color: #7a2e1f;
        background: rgba(158, 73, 54, 0.1);
        border-left: 3px solid var(--russet);
        padding: 10px 14px;
        border-radius: var(--radius);
        margin: 10px 0 0;
      }
      .panel__error.is-hidden { display: none; }

      @media (max-width: 640px) {
        .admin-top__tag { display: none; }
        .admin-top__nav-link + .admin-top__nav-link { margin-left: 12px; }
        .admin__head { flex-direction: column; align-items: stretch; }
        .upload-form { flex-direction: column; align-items: stretch; }
      }
    </style>

    <script>
      import { initConfirmDialog, confirmDialog } from "@/lib/confirmDialog.js";

      initConfirmDialog();

      document.getElementById("admin-logout-btn")?.addEventListener("click", async () => {
        await fetch("/api/admin/logout", { method: "POST" });
        window.location.href = "/admin/login";
      });

      const tourPicker = document.getElementById("tour-picker") as HTMLSelectElement | null;
      const banner = document.getElementById("admin-banner") as HTMLParagraphElement | null;
      const galleryCard = document.getElementById("gallery-card") as HTMLDivElement | null;
      const imageGrid = document.getElementById("image-grid") as HTMLDivElement | null;
      const uploadForm = document.getElementById("upload-form") as HTMLFormElement | null;
      const fileInput = document.getElementById("new-file") as HTMLInputElement | null;
      const descInput = document.getElementById("new-desc") as HTMLTextAreaElement | null;
      const positionInput = document.getElementById("new-position") as HTMLInputElement | null;
      const uploadBtn = document.getElementById("upload-btn") as HTMLButtonElement | null;
      const uploadError = document.getElementById("upload-error") as HTMLParagraphElement | null;

      function showBanner(message: string, isError = false) {
        if (!banner) return;
        banner.textContent = message;
        banner.classList.remove("is-hidden");
        banner.classList.toggle("admin__banner--error", isError);
        window.scrollTo({ top: 0, behavior: "smooth" });
      }

      tourPicker?.addEventListener("change", () => {
        const url = new URL(window.location.href);
        url.searchParams.set("tour", tourPicker.value);
        window.location.href = url.toString();
      });

      function emptyStateNode(): HTMLParagraphElement {
        const p = document.createElement("p");
        p.className = "image-grid__empty";
        p.id = "image-grid-empty";
        p.textContent = "Todavía no hay imágenes para esta ruta.";
        return p;
      }

      function imageItemNode(entry: { gallery_id: string; image_id: string; url: string; alt: string; position: number }): HTMLDivElement {
        const div = document.createElement("div");
        div.className = "image-item";
        div.setAttribute("data-gallery-id", entry.gallery_id);
        div.setAttribute("data-image-id", entry.image_id);
        div.innerHTML = `
          <img src="${entry.url}" alt="${entry.alt ?? ""}" class="image-item__thumb" />
          <div class="image-item__fields">
            <label>
              Descripción
              <textarea class="image-item__desc" rows="2">${entry.alt ?? ""}</textarea>
            </label>
            <label class="image-item__position-label">
              Posición
              <input type="number" min="0" class="image-item__position" value="${entry.position}" />
            </label>
          </div>
          <div class="image-item__actions">
            <button type="button" class="btn orange-btn image-item__save">Guardar</button>
            <button type="button" class="admin__link-btn admin__link-btn--danger image-item__delete">Eliminar</button>
          </div>
          <p class="panel__error is-hidden image-item__error" role="alert"></p>
        `;
        return div;
      }

      uploadForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!galleryCard || !fileInput || !uploadBtn) return;

        uploadError?.classList.add("is-hidden");

        const tourId = galleryCard.getAttribute("data-tour-id");
        const file = fileInput.files?.[0];
        if (!tourId || !file) return;

        const alt = descInput?.value ?? "";
        const position = Number(positionInput?.value ?? 0) || 0;

        uploadBtn.disabled = true;
        uploadBtn.textContent = "Subiendo…";

        try {
          const formData = new FormData();
          formData.append("file", file);
          formData.append("alt", alt);
          formData.append("position", String(position));

          const uploadRes = await fetch("/api/admin/images", { method: "POST", body: formData });
          const image = await uploadRes.json();
          if (!uploadRes.ok) throw new Error(image?.message || "No se ha podido subir la imagen.");

          const attachRes = await fetch(`/api/admin/tours/${tourId}/gallery`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ imageId: image.id, position })
          });
          const entry = await attachRes.json();
          if (!attachRes.ok) throw new Error(entry?.message || "No se ha podido añadir la imagen a la galería.");

          imageGrid?.querySelector("#image-grid-empty")?.remove();
          const node = imageItemNode({
            gallery_id: entry.id,
            image_id: image.id,
            url: image.url,
            alt: image.alt ?? "",
            position: entry.position
          });
          imageGrid?.appendChild(node);

          uploadForm.reset();
          if (positionInput) positionInput.value = String((imageGrid?.querySelectorAll(".image-item").length) ?? 0);
          showBanner("Imagen subida y añadida a la galería.");
        } catch (err: any) {
          if (uploadError) {
            uploadError.textContent = err?.message || "No se ha podido subir la imagen.";
            uploadError.classList.remove("is-hidden");
          }
        } finally {
          uploadBtn.disabled = false;
          uploadBtn.textContent = "Subir imagen";
        }
      });

      imageGrid?.addEventListener("click", async (e) => {
        const target = e.target as HTMLElement;
        const item = target.closest(".image-item") as HTMLDivElement | null;
        if (!item || !galleryCard) return;

        const tourId = galleryCard.getAttribute("data-tour-id");
        const galleryId = item.getAttribute("data-gallery-id");
        const imageId = item.getAttribute("data-image-id");
        if (!tourId || !galleryId || !imageId) return;

        const errorEl = item.querySelector(".image-item__error") as HTMLParagraphElement | null;

        if (target.classList.contains("image-item__save")) {
          errorEl?.classList.add("is-hidden");
          const desc = (item.querySelector(".image-item__desc") as HTMLTextAreaElement)?.value ?? "";
          const position = Number((item.querySelector(".image-item__position") as HTMLInputElement)?.value ?? 0) || 0;

          target.setAttribute("disabled", "true");
          try {
            const [descRes, posRes] = await Promise.all([
              fetch(`/api/admin/images/${imageId}`, {
                method: "PATCH",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ alt: desc })
              }),
              fetch(`/api/admin/tours/${tourId}/gallery/${galleryId}`, {
                method: "PATCH",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ position })
              })
            ]);
            const descData = await descRes.json();
            const posData = await posRes.json();
            if (!descRes.ok) throw new Error(descData?.message || "No se ha podido guardar la descripción.");
            if (!posRes.ok) throw new Error(posData?.message || "No se ha podido guardar la posición.");
            showBanner("Cambios guardados.");
          } catch (err: any) {
            if (errorEl) {
              errorEl.textContent = err?.message || "No se han podido guardar los cambios.";
              errorEl.classList.remove("is-hidden");
            }
          } finally {
            target.removeAttribute("disabled");
          }
        }

        if (target.classList.contains("image-item__delete")) {
          const confirmed = await confirmDialog({
            title: "Eliminar imagen",
            message: "¿Eliminar esta imagen? Se quitará de la galería y se borrará permanentemente. Esta acción no se puede deshacer.",
            confirmLabel: "Eliminar"
          });
          if (!confirmed) return;

          target.setAttribute("disabled", "true");
          try {
            const detachRes = await fetch(`/api/admin/tours/${tourId}/gallery/${galleryId}`, { method: "DELETE" });
            const detachData = await detachRes.json();
            if (!detachRes.ok) throw new Error(detachData?.message || "No se ha podido quitar la imagen de la galería.");

            const deleteRes = await fetch(`/api/admin/images/${imageId}`, { method: "DELETE" });
            const deleteData = await deleteRes.json();
            if (!deleteRes.ok) throw new Error(deleteData?.message || "No se ha podido eliminar el archivo de la imagen.");

            item.remove();
            if (!imageGrid?.querySelector(".image-item")) {
              imageGrid?.appendChild(emptyStateNode());
            }
            showBanner("Imagen eliminada.");
          } catch (err: any) {
            showBanner(err?.message || "No se ha podido eliminar la imagen.", true);
            target.removeAttribute("disabled");
          }
        }
      });
    </script>
  </body>
</html>
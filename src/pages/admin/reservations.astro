---
// @ts-nocheck
import "@/styles/global.css";
import { listAllTours, listBookingsSummary } from "@/lib/adminApi.js";

export const prerender = false;

interface ApiTour {
  id: string;
  name: string;
  is_active: boolean;
}

interface SummaryRow {
  tour_id: string;
  tour_name: string;
  tour_date_id: string;
  date: string;
  tour_schedule_id: string;
  time: string;
  booking_count: number;
  adults: number;
  children: number;
  babies: number;
  pets: number;
}

function todayIso() {
  return new Date().toISOString().slice(0, 10);
}

function addDaysIso(days: number) {
  const d = new Date();
  d.setDate(d.getDate() + days);
  return d.toISOString().slice(0, 10);
}

let tours: ApiTour[] = [];
let loadError: string | null = null;

try {
  tours = await listAllTours();
} catch (err) {
  console.error("No se han podido cargar las excursiones para el panel de reservas", err);
  loadError = "No se han podido cargar las excursiones. Recarga la página.";
}

const params = Astro.url.searchParams;
const hasFilters = [...params.keys()].length > 0;

const selectedTourId = params.get("tour") || "";
const dateFrom = params.has("from") ? params.get("from") : todayIso();
const dateTo = params.has("to") ? params.get("to") : addDaysIso(30);
const timeFrom = params.get("timeFrom") || "";
const timeTo = params.get("timeTo") || "";
const includeCancelled = params.get("includeCancelled") === "on";

let rows: SummaryRow[] = [];
let summaryError: string | null = null;

if (!loadError) {
  try {
    rows = await listBookingsSummary({
      tourId: selectedTourId || undefined,
      dateFrom: dateFrom || undefined,
      dateTo: dateTo || undefined,
      timeFrom: timeFrom || undefined,
      timeTo: timeTo || undefined,
      includeCancelled
    });
  } catch (err) {
    console.error("No se han podido cargar el resumen de reservas", err);
    summaryError = "No se ha podido cargar el resumen de reservas para estos filtros.";
  }
}

const totals = rows.reduce(
  (acc, r) => {
    acc.bookings += r.booking_count;
    acc.adults += r.adults;
    acc.children += r.children;
    acc.babies += r.babies;
    acc.pets += r.pets;
    return acc;
  },
  { bookings: 0, adults: 0, children: 0, babies: 0, pets: 0 }
);

const formatDate = (value: string) => {
  const datePart = value.includes("T") ? value.split("T")[0] : value;
  return new Date(datePart + "T00:00:00").toLocaleDateString("es-ES", {
    weekday: "short",
    day: "numeric",
    month: "short",
    year: "numeric"
  });
};
const formatTime = (value: string) => value?.slice(0, 5) ?? value;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reservas — Meriyo Tours (Dublin)</title>
    <link rel="icon" href="/web-icon-orange.svg" />
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;1,500;1,600&family=Work+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="admin-top">
      <div class="wrap admin-top__row">
        <a href="/" class="admin-top__logo"><em>Meriyo</em> Tours <em>Dublín</em></a>
        <span class="admin-top__tag">Panel de reservas</span>
        <div class="admin-top__nav">
          <a href="/admin/tours" class="admin-top__nav-link">Excursiones</a>
          <a href="/admin/schedules" class="admin-top__nav-link">Horarios</a>
          <a href="/admin/dates" class="admin-top__nav-link">Fechas</a>
          <a href="/admin/images" class="admin-top__nav-link">Imagenes</a>
          <a href="/admin/stops" class="admin-top__nav-link">Puntos</a>
        </div>
        <button type="button" class="admin-top__back admin-top__logout" id="admin-logout-btn">Cerrar sesión</button>
        <a href="/" class="admin-top__back">← Volver al sitio</a>
      </div>
    </header>

    <main class="admin">
      <div class="wrap">
        <div class="admin__head">
            <div>
                <p class="eyebrow">Catálogo</p>
                <h1 class="admin__title">Reservas</h1>
            </div>
            <button type="button" class="btn orange-btn rounded-btn" id="send-summary-btn">
                Enviar resumen ahora
            </button>
        </div>

        {loadError && <p class="admin__notice admin__notice--error">{loadError}</p>}

        {!loadError && (
          <>
            <div class="admin__card">
              <form method="GET" class="filters">
                <div class="field">
                  <label for="f-tour">Ruta</label>
                  <div class="select-wrap">
                    <select id="f-tour" name="tour">
                      <option value="">Todas las rutas</option>
                      {tours.map((t) => (
                        <option value={t.id} selected={t.id === selectedTourId}>
                          {t.name}{!t.is_active ? " (archivada)" : ""}
                        </option>
                      ))}
                    </select>
                  </div>
                </div>

                <div class="field">
                  <label for="f-from">Desde</label>
                  <input type="date" id="f-from" name="from" value={dateFrom} />
                </div>

                <div class="field">
                  <label for="f-to">Hasta</label>
                  <input type="date" id="f-to" name="to" value={dateTo} />
                </div>

                <div class="field">
                  <label for="f-time-from">Hora desde</label>
                  <input type="time" id="f-time-from" name="timeFrom" value={timeFrom} />
                </div>

                <div class="field">
                  <label for="f-time-to">Hora hasta</label>
                  <input type="time" id="f-time-to" name="timeTo" value={timeTo} />
                </div>

                <label class="checkbox-row">
                  <input type="checkbox" name="includeCancelled" checked={includeCancelled} />
                  <span>Incluir canceladas</span>
                </label>

                <div class="filters__actions">
                  <button type="submit" class="btn orange-btn">Filtrar</button>
                  {hasFilters && <a href="/admin/reservations" class="admin__link-btn">Vista por defecto</a>}
                </div>
              </form>
            </div>

            {summaryError && <p class="admin__notice admin__notice--error">{summaryError}</p>}

            {!summaryError && (
              <div class="admin__table-wrap">
                <table class="admin__table">
                <thead>
                  <tr>
                    <th>Fecha</th>
                    <th>Hora</th>
                    <th>Ruta</th>
                    <th>Nombre</th>
                    <th class="admin__col-num">Reservas</th>
                    <th class="admin__col-num">Adultos</th>
                    <th class="admin__col-num">Niños</th>
                    <th class="admin__col-num">Bebés</th>
                    <th class="admin__col-num">Mascotas</th>
                    <th class="admin__col-num">Total personas</th>
                  </tr>
                </thead>
                <tbody>
                  {rows.length === 0 && (
                    <tr class="admin__empty-row">
                      <td colspan="10">No hay reservas para los filtros seleccionados.</td>
                    </tr>
                  )}
                  {rows.map((r) => (
                    <tr>
                      <td>{formatDate(r.date)}</td>
                      <td>{formatTime(r.time)}</td>
                      <td>{r.tour_name}</td>
                      <td>{r.customer_names}</td>
                      <td class="admin__col-num">{r.booking_count}</td>
                      <td class="admin__col-num">{r.adults}</td>
                      <td class="admin__col-num">{r.children}</td>
                      <td class="admin__col-num">{r.babies}</td>
                      <td class="admin__col-num">{r.pets}</td>
                      <td class="admin__col-num admin__col-strong">
                        {r.adults + r.children + r.babies + r.pets}
                      </td>
                    </tr>
                  ))}
                </tbody>
                {rows.length > 0 && (
                  <tfoot>
                    <tr>
                      <td colspan="4">Totales</td>
                      <td class="admin__col-num">{totals.bookings}</td>
                      <td class="admin__col-num">{totals.adults}</td>
                      <td class="admin__col-num">{totals.children}</td>
                      <td class="admin__col-num">{totals.babies}</td>
                      <td class="admin__col-num">{totals.pets}</td>
                      <td class="admin__col-num admin__col-strong">
                        {totals.adults + totals.children + totals.babies + totals.pets}
                      </td>
                    </tr>
                  </tfoot>
                )}
                </table>
              </div>
            )}
          </>
        )}
      </div>
    </main>

    <style is:global>
      .admin__col-name {
        max-width: 260px;
        white-space: normal;
        word-break: break-word;
      }
      .admin-top__nav {
        margin-left: auto;
        display: flex;
        gap: 20px;
        align-items: center;
      }
      .admin-top__nav-link { font-size: 0.85rem; color: var(--parchment-alt); }
      .admin-top__nav-link:hover { color: var(--gold-soft); }
      .admin-top { background: var(--forest-deep); border-bottom: 1px solid var(--line); }
      .admin-top__row { display: flex; align-items: center; gap: 20px; padding-block: 16px; }
      .admin-top__logo { font-family: var(--font-display); font-style: italic; font-size: 1.05rem; color: var(--cream); }
      .admin-top__logo em { color: var(--gold); }
      .admin-top__tag {
        font-size: 0.78rem; letter-spacing: 0.04em; text-transform: uppercase;
        color: var(--gold-soft); border: 1px solid var(--line); border-radius: 999px; padding: 4px 12px;
      }
      .admin-top__back { font-size: 0.85rem; color: var(--parchment-alt); }
      .admin-top__back:hover { color: var(--gold-soft); }
      .admin-top__logout { background: none; border: none; font-family: inherit; cursor: pointer; padding: 0; }

      .admin { background: var(--parchment); padding-block: 44px 100px; min-height: 60vh; }
      .admin__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 30px; }
      .admin__title {
        font-family: var(--font-display); font-weight: 600; font-size: clamp(1.8rem, 3vw, 2.4rem);
        color: var(--ink); margin: 8px 0 0;
      }
      .admin__notice {
        font-size: 0.92rem; border-radius: var(--radius); padding: 14px 18px; margin: 0 0 22px;
        color: #4a5b4c; background: var(--cream); border: 1px solid rgba(24, 34, 25, 0.12);
      }
      .admin__notice--error {
        color: #7a2e1f; background: rgba(158, 73, 54, 0.1); border-left: 3px solid var(--russet);
      }

      .admin__card {
        background: var(--cream); border: 1px solid rgba(24, 34, 25, 0.1); border-top: 3px solid var(--gold);
        border-radius: var(--radius); padding: 22px 24px 24px; margin-bottom: 24px;
      }
      .filters { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 16px; }
      .filters .field { min-width: 170px; }
      .filters__actions { display: flex; align-items: center; gap: 14px; margin-left: auto; }

      .field { margin-bottom: 0; }
      label { display: block; font-size: 0.82rem; font-weight: 600; color: #4a5b4c; margin-bottom: 7px; }
      input[type="date"], input[type="time"], select {
        font-family: var(--font-body); font-size: 0.95rem; color: var(--ink); background: var(--cream);
        border: 1px solid rgba(24, 34, 25, 0.22); border-radius: var(--radius); padding: 11px 14px; width: 100%;
      }
      select { appearance: none; cursor: pointer; }
      input:focus, select:focus { outline: none; border-color: var(--gold); box-shadow: 0 0 0 3px rgba(233, 151, 10, 0.16); }
      .select-wrap { position: relative; min-width: 200px; }

      .checkbox-row { display: flex; align-items: center; gap: 8px; font-size: 0.88rem; color: var(--ink); cursor: pointer; padding-bottom: 11px; }
      .checkbox-row input { width: auto; accent-color: var(--gold); }

      .admin__link-btn {
        background: none; border: none; font-size: 0.85rem; font-family: var(--font-body);
        color: var(--russet); cursor: pointer; padding: 4px 6px; text-decoration: none;
      }
      .admin__link-btn:hover { text-decoration: underline; }

      .admin__table-wrap {
        background: var(--cream); border: 1px solid rgba(24, 34, 25, 0.1); border-top: 3px solid var(--gold);
        border-radius: var(--radius); overflow: hidden; overflow-x: auto;
      }
      .admin__table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
      .admin__table th {
        text-align: left; font-size: 0.74rem; letter-spacing: 0.05em; text-transform: uppercase;
        color: #7a7562; padding: 14px 18px; border-bottom: 1px solid rgba(24, 34, 25, 0.1); white-space: nowrap;
      }
      .admin__table td {
        padding: 12px 18px; border-bottom: 1px dashed rgba(24, 34, 25, 0.12); color: var(--ink); vertical-align: middle;
      }
      .admin__table tr:last-child td { border-bottom: none; }
      .admin__col-num { text-align: right; white-space: nowrap; }
      .admin__col-strong { font-weight: 700; }
      .admin__empty-row td { color: #7a7562; text-align: center; padding: 30px 18px; }
      .admin__table tfoot td {
        font-weight: 700; background: var(--parchment-alt); border-top: 2px solid rgba(24, 34, 25, 0.15); border-bottom: none;
      }

      @media (max-width: 640px) {
        .admin-top__tag { display: none; }
        .admin__head { flex-direction: column; align-items: stretch; }
        .filters { flex-direction: column; align-items: stretch; }
        .filters__actions { margin-left: 0; justify-content: space-between; }
      }
    </style>

    <script>
        const sendSummaryBtn = document.getElementById("send-summary-btn") as HTMLButtonElement | null;
        const summaryBanner = document.getElementById("admin-banner") as HTMLParagraphElement | null;

        function showSummaryBanner(message: string, isError = false) {
        if (!summaryBanner) return;
            summaryBanner.textContent = message;
            summaryBanner.classList.remove("is-hidden");
            summaryBanner.classList.toggle("admin__banner--error", isError);
            window.scrollTo({ top: 0, behavior: "smooth" });
        }

        sendSummaryBtn?.addEventListener("click", async () => {
        sendSummaryBtn.disabled = true;
        const originalLabel = sendSummaryBtn.textContent;
        sendSummaryBtn.textContent = "Enviando…";

        try {
            const res = await fetch("/api/admin/reservations/send-summary", { method: "POST" });
            const data = await res.json();
            if (!res.ok) throw new Error(data?.message || "No se ha podido enviar el resumen.");

            showSummaryBanner(
            `Resumen enviado (${data.dateFrom} a ${data.dateTo}, ${data.rowCount} salida${data.rowCount === 1 ? "" : "s"}).`
            );
        } catch (err: any) {
            showSummaryBanner(err?.message || "No se ha podido enviar el resumen.", true);
        } finally {
            sendSummaryBtn.disabled = false;
            sendSummaryBtn.textContent = originalLabel;
        }
        });
      document.getElementById("admin-logout-btn")?.addEventListener("click", async () => {
        await fetch("/api/admin/logout", { method: "POST" });
        window.location.href = "/admin/login";
      });
    </script>
  </body>
</html>
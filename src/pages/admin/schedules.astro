---
// @ts-nocheck
import "@/styles/global.css";
import { listAllTours, listTourSchedules } from "@/lib/adminApi.js";
import ConfirmDialog from "@/components/ConfirmDialog.astro";

export const prerender = false;

interface ApiTour {
  id: string;
  name: string;
  is_active: boolean;
}

interface ApiSchedule {
  id: string;
  time: string;
  tour_id: string;
  created_at: string;
}

let tours: ApiTour[] = [];
let loadError: string | null = null;

try {
  tours = await listAllTours();
} catch (err) {
  console.error("No se han podido cargar las excursiones para el panel de horarios", err);
  loadError = "No se han podido cargar las excursiones. Recarga la página.";
}

const selectedTourId = Astro.url.searchParams.get("tour") || tours[0]?.id || "";
const selectedTour = tours.find((t) => t.id === selectedTourId) ?? null;

let schedules: ApiSchedule[] = [];
let scheduleError: string | null = null;

if (selectedTourId && !loadError) {
  try {
    schedules = await listTourSchedules(selectedTourId);
    schedules.sort((a, b) => a.time.localeCompare(b.time));
  } catch (err) {
    console.error("No se han podido cargar los horarios", err);
    scheduleError = "No se han podido cargar los horarios de esta ruta.";
  }
}

// tour_schedules.time comes back as "HH:MM:SS" — trim the seconds for display.
const formatTime = (value: string) => value?.slice(0, 5) ?? value;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Horarios de excursiones — Meriyo Tours (Dublin)</title>
    <link rel="icon" href="/web-icon-orange.svg" />
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;1,500;1,600&family=Work+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="admin-top">
      <div class="wrap admin-top__row">
        <a href="/" class="admin-top__logo"><em>Meriyo</em> Tours <em>Dublín</em></a>
        <span class="admin-top__tag">Panel de horarios</span>
        <div class="admin-top__nav">
          <a href="/admin/reservations" class="admin-top__nav-link">Reservas</a>
          <a href="/admin/tours" class="admin-top__nav-link">Excursiones</a>
          <a href="/admin/dates" class="admin-top__nav-link">Fechas</a> 
          <a href="/admin/images" class="admin-top__nav-link">Imagenes</a>  
          <a href="/admin/stops" class="admin-top__nav-link">Puntos</a>   
        </div>
        <button type="button" class="admin-top__back admin-top__logout" id="admin-logout-btn">Cerrar sesión</button>
        <a href="/" class="admin-top__back">← Volver al sitio</a>
      </div>
    </header>

    <main class="admin">
      <div class="wrap">
        <div class="admin__head">
          <div>
            <p class="eyebrow">Catálogo</p>
            <h1 class="admin__title">Horarios</h1>
          </div>
        </div>

        {loadError && <p class="admin__notice admin__notice--error">{loadError}</p>}

        <p class="admin__banner is-hidden" id="admin-banner" role="status"></p>

        {!loadError && tours.length === 0 && (
          <p class="admin__notice">
            Todavía no hay excursiones. Crea una primero desde el
            <a href="/admin/tours">panel de excursiones</a>.
          </p>
        )}

        {!loadError && tours.length > 0 && (
          <>
            <div class="admin__card">
              <div class="field">
                <label for="tour-picker">Ruta</label>
                <div class="select-wrap">
                  <select id="tour-picker">
                    {tours.map((t) => (
                      <option value={t.id} selected={t.id === selectedTourId}>
                        {t.name}{!t.is_active ? " (archivada)" : ""}
                      </option>
                    ))}
                  </select>
                </div>
              </div>
            </div>

            {selectedTour && (
              <div class="admin__card" id="schedules-card" data-tour-id={selectedTour.id}>
                <h2 class="admin__card-title">Horarios de "{selectedTour.name}"</h2>

                {scheduleError && <p class="admin__notice admin__notice--error">{scheduleError}</p>}

                {!scheduleError && (
                  <>
                    <ul class="schedule-list" id="schedule-list">
                      {schedules.length === 0 && (
                        <li class="schedule-list__empty" id="schedule-empty">
                          Todavía no hay horarios para esta ruta.
                        </li>
                      )}
                      {schedules.map((s) => (
                        <li class="schedule-list__item" data-schedule-id={s.id}>
                          <span class="schedule-list__time">{formatTime(s.time)}</span>
                          <button type="button" class="admin__link-btn admin__link-btn--danger" data-delete-schedule={s.id}>
                            Eliminar
                          </button>
                        </li>
                      ))}
                    </ul>

                    <form id="add-schedule-form" class="add-schedule">
                      <div class="field add-schedule__field">
                        <label for="new-time">Añadir hora de salida</label>
                        <input type="time" id="new-time" required />
                      </div>
                      <button type="submit" class="btn orange-btn" id="add-schedule-btn">Añadir</button>
                    </form>
                    <p class="panel__error is-hidden" id="add-schedule-error" role="alert"></p>
                  </>
                )}
              </div>
            )}
          </>
        )}
      </div>
    </main>

    <ConfirmDialog />

    <style is:global>
      .admin-top__nav {
        margin-left: auto;
        display: flex;
        gap: 20px;
        align-items: center;
      }
      .admin-top__nav-link {
        font-size: 0.85rem;
        color: var(--parchment-alt);
      }

      .admin-top {
        background: var(--forest-deep);
        border-bottom: 1px solid var(--line);
      }
      .admin-top__row {
        display: flex;
        align-items: center;
        gap: 20px;
        padding-block: 16px;
      }
      .admin-top__logo {
        font-family: var(--font-display);
        font-style: italic;
        font-size: 1.05rem;
        color: var(--cream);
      }
      .admin-top__logo em { color: var(--gold); }
      .admin-top__tag {
        font-size: 0.78rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--gold-soft);
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 4px 12px;
      }
      .admin-top__nav-link {
        font-size: 0.85rem;
        color: var(--parchment-alt);
      }
      .admin-top__nav-link:first-of-type {
        margin-left: auto;
      }
      .admin-top__nav-link:hover { color: var(--gold-soft); }
      .admin-top__back {
        font-size: 0.85rem;
        color: var(--parchment-alt);
      }
      .admin-top__back:hover { color: var(--gold-soft); }
      .admin-top__logout {
        background: none;
        border: none;
        font-family: inherit;
        cursor: pointer;
        padding: 0;
      }

      .admin { background: var(--parchment); padding-block: 44px 100px; min-height: 60vh; }

      .admin__head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 30px;
      }
      .admin__title {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: clamp(1.8rem, 3vw, 2.4rem);
        color: var(--ink);
        margin: 8px 0 0;
      }

      .admin__notice {
        font-size: 0.92rem;
        border-radius: var(--radius);
        padding: 14px 18px;
        margin: 0 0 22px;
        color: #4a5b4c;
        background: var(--cream);
        border: 1px solid rgba(24, 34, 25, 0.12);
      }
      .admin__notice--error {
        color: #7a2e1f;
        background: rgba(158, 73, 54, 0.1);
        border-left: 3px solid var(--russet);
      }

      .admin__banner {
        font-size: 0.9rem;
        border-radius: var(--radius);
        padding: 12px 18px;
        margin: 0 0 20px;
        background: rgba(233, 151, 10, 0.12);
        border-left: 3px solid var(--gold);
        color: var(--ink);
      }
      .admin__banner.is-hidden { display: none; }
      .admin__banner--error {
        background: rgba(158, 73, 54, 0.1);
        border-left-color: var(--russet);
        color: #7a2e1f;
      }

      .admin__card {
        background: var(--cream);
        border: 1px solid rgba(24, 34, 25, 0.1);
        border-top: 3px solid var(--gold);
        border-radius: var(--radius);
        padding: 26px 28px 28px;
        margin-bottom: 24px;
      }
      .admin__card-title {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1.15rem;
        color: var(--ink);
        margin: 0 0 20px;
      }

      .field { margin-bottom: 0; }
      label {
        display: block;
        font-size: 0.82rem;
        font-weight: 600;
        color: #4a5b4c;
        margin-bottom: 7px;
      }

      input[type="time"],
      select {
        font-family: var(--font-body);
        font-size: 0.95rem;
        color: var(--ink);
        background: var(--cream);
        border: 1px solid rgba(24, 34, 25, 0.22);
        border-radius: var(--radius);
        padding: 11px 14px;
      }
      select { width: 100%; appearance: none; cursor: pointer; }
      input:focus, select:focus {
        outline: none;
        border-color: var(--gold);
        box-shadow: 0 0 0 3px rgba(233, 151, 10, 0.16);
      }
      .select-wrap { position: relative; max-width: 360px; }

      .schedule-list {
        list-style: none;
        margin: 0 0 22px;
        padding: 0;
        border: 1px solid rgba(24, 34, 25, 0.1);
        border-radius: var(--radius);
        overflow: hidden;
      }
      .schedule-list__item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 16px;
        border-bottom: 1px dashed rgba(24, 34, 25, 0.12);
        font-size: 0.92rem;
        color: var(--ink);
      }
      .schedule-list__item:last-child { border-bottom: none; }
      .schedule-list__time { font-weight: 600; }
      .schedule-list__empty {
        padding: 18px 16px;
        color: #7a7562;
        font-size: 0.9rem;
        text-align: center;
      }

      .admin__link-btn {
        background: none;
        border: none;
        font-size: 0.85rem;
        font-family: var(--font-body);
        color: var(--russet);
        cursor: pointer;
        padding: 4px 6px;
      }
      .admin__link-btn:hover { text-decoration: underline; }
      .admin__link-btn--danger { color: #7a2e1f; }
      .admin__link-btn:disabled { opacity: 0.5; cursor: not-allowed; text-decoration: none; }

      .add-schedule {
        display: flex;
        align-items: flex-end;
        gap: 14px;
        flex-wrap: wrap;
      }
      .add-schedule__field { flex: 1; min-width: 160px; }

      .panel__error {
        font-size: 0.85rem;
        color: #7a2e1f;
        background: rgba(158, 73, 54, 0.1);
        border-left: 3px solid var(--russet);
        padding: 10px 14px;
        border-radius: var(--radius);
        margin: 16px 0 0;
      }
      .panel__error.is-hidden { display: none; }

      @media (max-width: 640px) {
        .admin-top__tag { display: none; }
        .admin__head { flex-direction: column; align-items: stretch; }
        .add-schedule { flex-direction: column; align-items: stretch; }
      }
    </style>

    <script>
      import { initConfirmDialog, confirmDialog } from "@/lib/confirmDialog.js";

      initConfirmDialog();

      document.getElementById("admin-logout-btn")?.addEventListener("click", async () => {
        await fetch("/api/admin/logout", { method: "POST" });
        window.location.href = "/admin/login";
      });

      const tourPicker = document.getElementById("tour-picker") as HTMLSelectElement | null;
      const banner = document.getElementById("admin-banner") as HTMLParagraphElement | null;
      const scheduleCard = document.getElementById("schedules-card") as HTMLDivElement | null;
      const scheduleList = document.getElementById("schedule-list") as HTMLUListElement | null;
      const addForm = document.getElementById("add-schedule-form") as HTMLFormElement | null;
      const newTimeInput = document.getElementById("new-time") as HTMLInputElement | null;
      const addBtn = document.getElementById("add-schedule-btn") as HTMLButtonElement | null;
      const addError = document.getElementById("add-schedule-error") as HTMLParagraphElement | null;

      function showBanner(message: string, isError = false) {
        if (!banner) return;
        banner.textContent = message;
        banner.classList.remove("is-hidden");
        banner.classList.toggle("admin__banner--error", isError);
        window.scrollTo({ top: 0, behavior: "smooth" });
      }

      tourPicker?.addEventListener("change", () => {
        const url = new URL(window.location.href);
        url.searchParams.set("tour", tourPicker.value);
        window.location.href = url.toString();
      });

      function formatTime(value: string) {
        return value?.slice(0, 5) ?? value;
      }

      function emptyStateRow(): HTMLLIElement {
        const li = document.createElement("li");
        li.className = "schedule-list__empty";
        li.id = "schedule-empty";
        li.textContent = "Todavía no hay horarios para esta ruta.";
        return li;
      }

      function scheduleRow(schedule: { id: string; time: string }): HTMLLIElement {
        const li = document.createElement("li");
        li.className = "schedule-list__item";
        li.setAttribute("data-schedule-id", schedule.id);
        li.innerHTML = `
          <span class="schedule-list__time">${formatTime(schedule.time)}</span>
          <button type="button" class="admin__link-btn admin__link-btn--danger" data-delete-schedule="${schedule.id}">Eliminar</button>
        `;
        return li;
      }

      addForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!scheduleCard || !newTimeInput || !addBtn) return;

        addError?.classList.add("is-hidden");

        const tourId = scheduleCard.getAttribute("data-tour-id");
        const time = newTimeInput.value;
        if (!tourId || !time) return;

        addBtn.disabled = true;
        addBtn.textContent = "Añadiendo…";

        try {
          const res = await fetch(`/api/admin/tours/${tourId}/schedules`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ time })
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data?.message || "No se ha podido añadir el horario.");

          scheduleList?.querySelector("#schedule-empty")?.remove();
          const row = scheduleRow(data);
          const items = [...(scheduleList?.querySelectorAll<HTMLLIElement>(".schedule-list__item") ?? [])];
          const next = items.find((item) => (item.querySelector(".schedule-list__time")?.textContent ?? "") > formatTime(data.time));
          if (next) {
            scheduleList?.insertBefore(row, next);
          } else {
            scheduleList?.appendChild(row);
          }

          newTimeInput.value = "";
          showBanner("Horario añadido.");
        } catch (err: any) {
          if (addError) {
            addError.textContent = err?.message || "No se ha podido añadir el horario.";
            addError.classList.remove("is-hidden");
          }
        } finally {
          addBtn.disabled = false;
          addBtn.textContent = "Añadir";
        }
      });

      scheduleList?.addEventListener("click", async (e) => {
        const target = e.target as HTMLElement;
        const scheduleId = target.getAttribute("data-delete-schedule");
        if (!scheduleId || !scheduleCard) return;

        const confirmed = await confirmDialog({
          title: "Eliminar horario",
          message: "¿Eliminar este horario? Esta acción no se puede deshacer.",
          confirmLabel: "Eliminar"
        });
        if (!confirmed) return;

        const tourId = scheduleCard.getAttribute("data-tour-id");
        if (!tourId) return;

        target.setAttribute("disabled", "true");
        try {
          const res = await fetch(`/api/admin/tours/${tourId}/schedules/${scheduleId}`, { method: "DELETE" });
          const data = await res.json();
          if (!res.ok) throw new Error(data?.message || "No se ha podido eliminar el horario.");

          const row = scheduleList?.querySelector(`li[data-schedule-id="${scheduleId}"]`);
          row?.remove();
          if (!scheduleList?.querySelector(".schedule-list__item")) {
            scheduleList?.appendChild(emptyStateRow());
          }
          showBanner("Horario eliminado.");
        } catch (err: any) {
          showBanner(err?.message || "No se ha podido eliminar el horario. Puede que ya tenga reservas asociadas.", true);
        } finally {
          target.removeAttribute("disabled");
        }
      });
    </script>
  </body>
</html>
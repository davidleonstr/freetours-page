---
import "@/styles/global.css";
import { getTourById, listTourStops } from "@/lib/adminApi.js";
import ConfirmDialog from "@/components/ConfirmDialog.astro";

export const prerender = false;

const tourId = Astro.url.searchParams.get("tour");

let tour = null;
let stops = [];
let loadError = null;

if (tourId) {
  try {
    const [tourResult, stopsResult] = await Promise.all([getTourById(tourId), listTourStops(tourId)]);
    tour = tourResult;
    stops = [...stopsResult].sort((a, b) => a.position - b.position);
  } catch (err) {
    console.error("No se han podido cargar los puntos de ruta", err);
    loadError = "No se han podido cargar los puntos de ruta. Recarga la página.";
  }
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{tour ? `Puntos de ruta — ${tour.name}` : "Puntos de ruta"} — Meriyo Tours (Dublin)</title>
    <link rel="icon" href="/web-icon-orange.svg" />
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;1,500;1,600&family=Work+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  </head>
  <body>
    <header class="admin-top">
      <div class="wrap admin-top__row">
        <a href="/" class="admin-top__logo"><em>Meriyo</em> Tours <em>Dublín</em></a>
        <span class="admin-top__tag">Panel de excursiones</span>
        <div class="admin-top__nav">
          <a href="/admin/reservations" class="admin-top__nav-link">Reservas</a>
          {tourId && <a href={`/admin/schedules?tour=${tourId}`} class="admin-top__nav-link">Horarios</a>}
          {tourId && <a href={`/admin/dates?tour=${tourId}`} class="admin-top__nav-link">Fechas</a>}
          {tourId && <a href={`/admin/images?tour=${tourId}`} class="admin-top__nav-link">Imagenes</a>}
        </div>
        <button type="button" class="admin-top__back admin-top__logout" id="admin-logout-btn">Cerrar sesión</button>
        <a href="/admin/tours" class="admin-top__back">← Excursiones</a>
      </div>
    </header>

    <main class="admin">
      <div class="wrap">
        {!tourId && (
          <div class="admin__notice admin__notice--error">
            Selecciona una excursión desde <a href="/admin/tours">el catálogo</a> para gestionar sus puntos de ruta.
          </div>
        )}

        {tourId && (
          <>
            <div class="admin__head">
              <div>
                <p class="eyebrow">{tour ? tour.name : "Excursión"}</p>
                <h1 class="admin__title">Puntos de ruta</h1>
              </div>
              <button type="button" class="btn orange-btn rounded-btn" id="new-stop-btn">+ Nuevo punto</button>
            </div>

            <p class="admin__hint">
              Estos son los puntos intermedios de la ruta (paradas), distintos del punto de encuentro de la
              excursión. El orden aquí es el orden en que se visitan y en que se muestran en la web.
            </p>

            {loadError && <p class="admin__notice admin__notice--error">{loadError}</p>}

            <p class="admin__banner is-hidden" id="admin-banner" role="status"></p>

            <div class="admin__table-wrap">
              <table class="admin__table" id="stops-table">
                <thead>
                  <tr>
                    <th class="admin__col-order">#</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Coordenadas</th>
                    <th class="admin__col-actions">Acciones</th>
                  </tr>
                </thead>
                <tbody id="stops-tbody">
                  {stops.length === 0 && !loadError && (
                    <tr class="admin__empty-row">
                      <td colspan="5">Todavía no hay puntos de ruta. Crea el primero con el botón de arriba.</td>
                    </tr>
                  )}
                  {stops.map((s, i) => (
                    <tr data-stop-row={s.id}>
                      <td class="admin__col-order">
                        <div class="order-controls">
                          <button type="button" class="order-btn" data-move-up={s.id} disabled={i === 0} aria-label="Subir">▲</button>
                          <span class="order-controls__num">{i + 1}</span>
                          <button type="button" class="order-btn" data-move-down={s.id} disabled={i === stops.length - 1} aria-label="Bajar">▼</button>
                        </div>
                      </td>
                      <td class="admin__cell-name"><span class="admin__tour-name">{s.name}</span></td>
                      <td class="admin__cell-desc">{s.description ?? "—"}</td>
                      <td class="admin__cell-coords">{s.lat.toFixed(5)}, {s.lng.toFixed(5)}</td>
                      <td class="admin__col-actions">
                        <button type="button" class="admin__link-btn" data-edit-stop={s.id}>Editar</button>
                        <button type="button" class="admin__link-btn admin__link-btn--danger" data-delete-stop={s.id}>Eliminar</button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        )}
      </div>
    </main>

    <!-- Create / edit panel -->
    <div class="overlay is-hidden" id="stop-overlay">
      <div class="panel" role="dialog" aria-modal="true" aria-labelledby="panel-title">
        <div class="panel__head">
          <h2 class="panel__title" id="panel-title">Nuevo punto de ruta</h2>
          <button type="button" class="panel__close" id="panel-close" aria-label="Cerrar">✕</button>
        </div>

        <form id="stop-form" novalidate>
          <input type="hidden" id="stop-id" />

          <div class="field">
            <label for="f-name">Nombre<em>*</em></label>
            <input type="text" id="f-name" maxlength="255" required />
          </div>

          <div class="field">
            <label for="f-description">Descripción <span class="field__optional">(opcional)</span></label>
            <textarea id="f-description" rows="3"></textarea>
          </div>

          <div class="field">
            <label for="f-location-search">Ubicación del punto (OpenStreetMap)<em>*</em></label>
            <div class="map-search-row">
              <input type="text" id="f-location-search" placeholder="Busca una dirección…" />
              <button type="button" class="btn btn-ghost black-color-05" id="f-location-search-btn">Buscar</button>
            </div>
            <div id="f-location-map" class="admin-map"></div>
            <p class="field__hint">Busca una dirección o haz clic en el mapa para fijar la ubicación exacta de este punto.</p>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="f-lat">Latitud<em>*</em></label>
              <input type="text" id="f-lat" required readonly />
            </div>
            <div class="field">
              <label for="f-lng">Longitud<em>*</em></label>
              <input type="text" id="f-lng" required readonly />
            </div>
          </div>

          <p class="panel__error is-hidden" id="panel-error" role="alert"></p>

          <div class="panel__actions">
            <button type="button" class="btn btn-ghost black-color-05" id="panel-cancel">Cancelar</button>
            <button type="submit" class="btn orange-btn" id="panel-submit">Guardar punto</button>
          </div>
        </form>
      </div>
    </div>

    <ConfirmDialog />

    <style is:global>
      .admin-top__nav {
        margin-left: auto;
        display: flex;
        gap: 20px;
        align-items: center;
      }
      .admin-top__nav-link {
        font-size: 0.85rem;
        color: var(--parchment-alt);
      }
      .admin-top__nav-link--active {
        color: var(--gold-soft);
        text-decoration: underline;
      }
      .black-color-05 {
          color: rgba(0, 0, 0, 0.5);
      }
      .admin-top {
        background: var(--forest-deep);
        border-bottom: 1px solid var(--line);
      }
      .admin-top__row {
        display: flex;
        align-items: center;
        gap: 20px;
        padding-block: 16px;
      }
      .admin-top__logo {
        font-family: var(--font-display);
        font-style: italic;
        font-size: 1.05rem;
        color: var(--cream);
      }
      .admin-top__logo em { color: var(--gold); }
      .admin-top__tag {
        font-size: 0.78rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--gold-soft);
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 4px 12px;
      }
      .admin-top__nav-link:hover { color: var(--gold-soft); }
      .admin-top__back {
        font-size: 0.85rem;
        color: var(--parchment-alt);
      }
      .admin-top__back:hover { color: var(--gold-soft); }
      .admin-top__logout {
        background: none;
        border: none;
        font-family: inherit;
        cursor: pointer;
        padding: 0;
      }

      .admin { background: var(--parchment); padding-block: 44px 100px; min-height: 60vh; }

      .admin__head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 16px;
      }
      .admin__title {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: clamp(1.8rem, 3vw, 2.4rem);
        color: var(--ink);
        margin: 8px 0 0;
      }
      .admin__hint {
        font-size: 0.88rem;
        color: #5a6b5c;
        margin: 0 0 26px;
        max-width: 62ch;
      }

      .admin__notice {
        font-size: 0.92rem;
        border-radius: var(--radius);
        padding: 14px 18px;
        margin: 0 0 22px;
      }
      .admin__notice--error {
        color: #7a2e1f;
        background: rgba(158, 73, 54, 0.1);
        border-left: 3px solid var(--russet);
      }
      .admin__notice--error a { color: inherit; text-decoration: underline; }

      .admin__banner {
        font-size: 0.9rem;
        border-radius: var(--radius);
        padding: 12px 18px;
        margin: 0 0 20px;
        background: rgba(233, 151, 10, 0.12);
        border-left: 3px solid var(--gold);
        color: var(--ink);
      }
      .admin__banner.is-hidden { display: none; }
      .admin__banner--error {
        background: rgba(158, 73, 54, 0.1);
        border-left-color: var(--russet);
        color: #7a2e1f;
      }

      .admin__table-wrap {
        background: var(--cream);
        border: 1px solid rgba(24, 34, 25, 0.1);
        border-top: 3px solid var(--gold);
        border-radius: var(--radius);
        overflow: hidden;
      }
      .admin__table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
      .admin__table th {
        text-align: left;
        font-size: 0.74rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: #7a7562;
        padding: 14px 18px;
        border-bottom: 1px solid rgba(24, 34, 25, 0.1);
      }
      .admin__table td {
        padding: 14px 18px;
        border-bottom: 1px dashed rgba(24, 34, 25, 0.12);
        color: var(--ink);
        vertical-align: middle;
      }
      .admin__table tr:last-child td { border-bottom: none; }
      .admin__tour-name { font-weight: 600; }
      .admin__cell-desc {
        max-width: 320px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: #5a6b5c;
      }
      .admin__cell-coords {
        font-variant-numeric: tabular-nums;
        color: #5a6b5c;
        font-size: 0.85rem;
        white-space: nowrap;
      }
      .admin__empty-row td { color: #7a7562; text-align: center; padding: 30px 18px; }

      .admin__col-order { width: 78px; }
      .order-controls {
        display: flex;
        align-items: center;
        gap: 6px;
      }
      .order-controls__num {
        font-weight: 600;
        min-width: 16px;
        text-align: center;
      }
      .order-btn {
        background: none;
        border: 1px solid rgba(24, 34, 25, 0.18);
        border-radius: 4px;
        font-size: 0.7rem;
        line-height: 1;
        padding: 4px 6px;
        cursor: pointer;
        color: var(--ink);
      }
      .order-btn:hover:not(:disabled) { border-color: var(--gold); color: var(--russet); }
      .order-btn:disabled { opacity: 0.3; cursor: not-allowed; }

      .admin__col-actions { white-space: nowrap; text-align: right; }
      .admin__link-btn {
        background: none;
        border: none;
        font-size: 0.85rem;
        font-family: var(--font-body);
        color: var(--russet);
        cursor: pointer;
        padding: 4px 6px;
      }
      .admin__link-btn:hover { text-decoration: underline; }
      .admin__link-btn--danger { color: #7a2e1f; margin-left: 6px; }

      /* ---------- Overlay panel (shared field styles borrowed from Tours) ---------- */
      .overlay {
        position: fixed;
        inset: 0;
        background: rgba(10, 14, 10, 0.5);
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding: 5vh 20px;
        z-index: 100;
        overflow-y: auto;
      }
      .overlay.is-hidden { display: none; }

      .panel {
        width: 100%;
        max-width: 560px;
        background: var(--cream);
        border-radius: var(--radius);
        border-top: 3px solid var(--gold);
        padding: 28px 30px 32px;
      }
      .panel__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
      }
      .panel__title {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1.3rem;
        color: var(--ink);
        margin: 0;
      }
      .panel__close {
        background: none;
        border: none;
        font-size: 1.1rem;
        color: #7a7562;
        cursor: pointer;
        line-height: 1;
      }

      .field { margin-bottom: 16px; }
      .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
      label {
        display: block;
        font-size: 0.82rem;
        font-weight: 600;
        color: #4a5b4c;
        margin-bottom: 7px;
      }
      label em { font-style: normal; color: var(--russet); margin-left: 2px; }
      .field__optional { font-weight: 400; color: #8a8272; }
      .field__hint { font-size: 0.78rem; color: #7a7562; margin: 6px 0 0; }

      .map-search-row {
        display: flex;
        gap: 10px;
        margin-bottom: 10px;
      }
      .map-search-row input { flex: 1; }
      .admin-map {
        width: 100%;
        height: 260px;
        border-radius: var(--radius);
        overflow: hidden;
        border: 1px solid rgba(24, 34, 25, 0.22);
        margin-bottom: 6px;
      }

      input[type="text"],
      input[type="number"],
      textarea,
      select {
        width: 100%;
        font-family: var(--font-body);
        font-size: 0.95rem;
        color: var(--ink);
        background: var(--cream);
        border: 1px solid rgba(24, 34, 25, 0.22);
        border-radius: var(--radius);
        padding: 11px 14px;
      }
      textarea { resize: vertical; }
      input:focus, select:focus, textarea:focus {
        outline: none;
        border-color: var(--gold);
        box-shadow: 0 0 0 3px rgba(233, 151, 10, 0.16);
      }
      input[readonly] { background: var(--parchment-alt); cursor: not-allowed; }

      .panel__error {
        font-size: 0.85rem;
        color: #7a2e1f;
        background: rgba(158, 73, 54, 0.1);
        border-left: 3px solid var(--russet);
        padding: 10px 14px;
        border-radius: var(--radius);
        margin-bottom: 16px;
      }
      .panel__error.is-hidden { display: none; }

      .panel__actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 6px;
      }

      @media (max-width: 640px) {
        .admin-top__tag { display: none; }
        .field-row { grid-template-columns: 1fr; }
        .admin__head { flex-direction: column; align-items: stretch; }
        .admin__cell-desc { max-width: 160px; }
      }
    </style>

<script>
      import { initConfirmDialog, confirmDialog } from "@/lib/confirmDialog.js";

      // Tell TS about Leaflet if you aren't importing @types/leaflet directly
      declare const L: any;

      interface Stop {
        id: string;
        name: string;
        description: string | null;
        lat: number;
        lng: number;
        position: number;
      }

      interface NominatimResult {
        lat: string;
        lon: string;
      }

      initConfirmDialog();

      const tourId = new URLSearchParams(window.location.search).get("tour");

      document.getElementById("admin-logout-btn")?.addEventListener("click", async () => {
        await fetch("/api/admin/logout", { method: "POST" });
        window.location.href = "/admin/login";
      });

      if (tourId) {
        const DUBLIN_CENTER: [number, number] = [53.3498, -6.2603];

        // Type Assertions for DOM Elements
        const tbody = document.getElementById("stops-tbody") as HTMLTableSectionElement;
        const banner = document.getElementById("admin-banner") as HTMLDivElement;

        const overlay = document.getElementById("stop-overlay") as HTMLDivElement;
        const panelTitle = document.getElementById("panel-title") as HTMLHeadingElement;
        const form = document.getElementById("stop-form") as HTMLFormElement;
        const panelError = document.getElementById("panel-error") as HTMLDivElement;
        const panelSubmit = document.getElementById("panel-submit") as HTMLButtonElement;

        const idField = document.getElementById("stop-id") as HTMLInputElement;
        const nameField = document.getElementById("f-name") as HTMLInputElement;
        const descField = document.getElementById("f-description") as HTMLTextAreaElement;
        const latField = document.getElementById("f-lat") as HTMLInputElement;
        const lngField = document.getElementById("f-lng") as HTMLInputElement;
        const searchInput = document.getElementById("f-location-search") as HTMLInputElement;
        const searchBtn = document.getElementById("f-location-search-btn") as HTMLButtonElement;

        let knownStops: Stop[] = [];

        let map: any = null;
        let marker: any = null;

        function ensureMap(): void {
          if (map) return;
          map = L.map("f-location-map").setView(DUBLIN_CENTER, 12);
          L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
            maxZoom: 19,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
          }).addTo(map);
          map.on("click", (e: any) => setMarker(e.latlng.lat, e.latlng.lng));
        }

        function setMarker(lat: number, lng: number): void {
          latField.value = lat.toFixed(6);
          lngField.value = lng.toFixed(6);
          if (marker) {
            marker.setLatLng([lat, lng]);
          } else {
            marker = L.marker([lat, lng]).addTo(map);
          }
          map.setView([lat, lng], Math.max(map.getZoom(), 15));
        }

        function clearMarker(): void {
          if (marker && map) {
            map.removeLayer(marker);
            marker = null;
          }
          latField.value = "";
          lngField.value = "";
          map?.setView(DUBLIN_CENTER, 12);
        }

        searchBtn?.addEventListener("click", async () => {
          const query = searchInput.value.trim();
          if (!query) return;

          searchBtn.disabled = true;
          const originalLabel = searchBtn.textContent || "Buscar";
          searchBtn.textContent = "Buscando…";

          try {
            const res = await fetch(
              `https://nominatim.openstreetmap.org/search?format=json&limit=1&q=${encodeURIComponent(query)}`,
              { headers: { Accept: "application/json" } }
            );
            const results = (await res.json()) as NominatimResult[];
            
            if (!Array.isArray(results) || results.length === 0) {
              panelError.textContent =
                "No se ha encontrado esa dirección. Prueba con otra búsqueda o marca el punto directamente en el mapa.";
              panelError.classList.remove("is-hidden");
              return;
            }
            
            panelError.classList.add("is-hidden");
            const { lat, lon } = results[0];
            setMarker(Number(lat), Number(lon));
          } catch {
            panelError.textContent = "No se ha podido buscar la dirección. Inténtalo de nuevo.";
            panelError.classList.remove("is-hidden");
          } finally {
            searchBtn.disabled = false;
            searchBtn.textContent = originalLabel;
          }
        });

        function showBanner(message: string, isError = false): void {
          banner.textContent = message;
          banner.classList.remove("is-hidden");
          banner.classList.toggle("admin__banner--error", isError);
          window.scrollTo({ top: 0, behavior: "smooth" });
        }

        function escapeHtml(value: string): string {
          const div = document.createElement("div");
          div.textContent = value;
          return div.innerHTML;
        }

        function rowHtml(s: Stop, index: number, total: number): string {
          return `
            <td class="admin__col-order">
              <div class="order-controls">
                <button type="button" class="order-btn" data-move-up="${s.id}" aria-label="Subir" ${index === 0 ? "disabled" : ""}>▲</button>
                <span class="order-controls__num">${index + 1}</span>
                <button type="button" class="order-btn" data-move-down="${s.id}" aria-label="Bajar" ${index === total - 1 ? "disabled" : ""}>▼</button>
              </div>
            </td>
            <td class="admin__cell-name"><span class="admin__tour-name">${escapeHtml(s.name)}</span></td>
            <td class="admin__cell-desc">${s.description ? escapeHtml(s.description) : "—"}</td>
            <td class="admin__cell-coords">${s.lat.toFixed(5)}, ${s.lng.toFixed(5)}</td>
            <td class="admin__col-actions">
              <button type="button" class="admin__link-btn" data-edit-stop="${s.id}">Editar</button>
              <button type="button" class="admin__link-btn admin__link-btn--danger" data-delete-stop="${s.id}">Eliminar</button>
            </td>`;
        }

        function renderTable(): void {
          const emptyRow = tbody.querySelector(".admin__empty-row");
          emptyRow?.remove();

          if (knownStops.length === 0) {
            tbody.innerHTML = `<tr class="admin__empty-row"><td colspan="5">Todavía no hay puntos de ruta. Crea el primero con el botón de arriba.</td></tr>`;
            return;
          }

          tbody.innerHTML = "";
          knownStops.forEach((s, i) => {
            const row = document.createElement("tr");
            row.setAttribute("data-stop-row", s.id);
            row.innerHTML = rowHtml(s, i, knownStops.length);
            tbody.appendChild(row);
          });
        }

        async function fetchStops(): Promise<void> {
          try {
            const res = await fetch(`/api/admin/tours/${tourId}/stops`);
            if (!res.ok) return;
            const stops = (await res.json()) as Stop[];
            knownStops = [...stops].sort((a, b) => a.position - b.position);
            renderTable();
          } catch {
            // keep whatever is currently rendered
          }
        }

        document.querySelectorAll("tr[data-stop-row]").forEach((row) => {
          const id = row.getAttribute("data-stop-row");
          if (!id) return;
          
          const coordsText = row.querySelector(".admin__cell-coords")?.textContent ?? "0, 0";
          const [lat, lng] = coordsText.split(",").map((v) => Number(v.trim()));

          const descText = row.querySelector(".admin__cell-desc")?.textContent?.trim() ?? "";

          knownStops.push({
            id,
            name: row.querySelector(".admin__tour-name")?.textContent ?? "",
            description: descText && descText !== "—" ? descText : null,
            lat,
            lng,
            position: knownStops.length
          });
        });

        function openPanel(stop?: Stop): void {
          form.reset();
          panelError.classList.add("is-hidden");
          searchInput.value = "";

          ensureMap();

          if (stop) {
            panelTitle.textContent = "Editar punto de ruta";
            idField.value = stop.id;
            nameField.value = stop.name;
            descField.value = stop.description ?? "";
            setMarker(Number(stop.lat), Number(stop.lng));
          } else {
            panelTitle.textContent = "Nuevo punto de ruta";
            idField.value = "";
            clearMarker();
          }

          overlay.classList.remove("is-hidden");
          nameField.focus();
          setTimeout(() => map?.invalidateSize(), 60);
        }

        function closePanel(): void {
          overlay.classList.add("is-hidden");
        }

        document.getElementById("new-stop-btn")?.addEventListener("click", () => openPanel());
        document.getElementById("panel-close")?.addEventListener("click", closePanel);
        document.getElementById("panel-cancel")?.addEventListener("click", closePanel);
        
        overlay.addEventListener("click", (e: MouseEvent) => {
          if (e.target === overlay) closePanel();
        });

        async function moveStop(id: string, direction: number): Promise<void> {
          const index = knownStops.findIndex((s) => s.id === id);
          const swapWith = index + direction;
          if (index === -1 || swapWith < 0 || swapWith >= knownStops.length) return;

          const reordered = [...knownStops];
          [reordered[index], reordered[swapWith]] = [reordered[swapWith], reordered[index]];
          knownStops = reordered;
          renderTable();

          try {
            const res = await fetch(`/api/admin/tours/${tourId}/stops/order`, {
              method: "PUT",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ order: reordered.map((s) => s.id) })
            });
            if (!res.ok) throw new Error(((await res.json()) as any)?.message);
            await fetchStops();
          } catch (err: any) {
            showBanner(err?.message || "No se ha podido reordenar los puntos.", true);
            await fetchStops();
          }
        }

        tbody.addEventListener("click", async (e: MouseEvent) => {
          const target = e.target as HTMLElement;

          const editId = target.getAttribute("data-edit-stop");
          if (editId) {
            const stop = knownStops.find((s) => s.id === editId);
            if (stop) openPanel(stop);
            return;
          }

          const upId = target.getAttribute("data-move-up");
          if (upId) {
            await moveStop(upId, -1);
            return;
          }

          const downId = target.getAttribute("data-move-down");
          if (downId) {
            await moveStop(downId, 1);
            return;
          }

          const deleteId = target.getAttribute("data-delete-stop");
          if (deleteId) {
            const stop = knownStops.find((s) => s.id === deleteId);
            const confirmed = await confirmDialog({
              title: "Eliminar punto de ruta",
              message: `¿Eliminar "${stop?.name ?? "este punto"}"? Esta acción no se puede deshacer.`,
              confirmLabel: "Eliminar",
              danger: true
            });
            if (!confirmed) return;

            target.setAttribute("disabled", "true");
            try {
              const res = await fetch(`/api/admin/tours/${tourId}/stops/${deleteId}`, { method: "DELETE" });
              if (!res.ok) throw new Error(((await res.json()) as any)?.message);
              showBanner("Punto de ruta eliminado.");
              await fetchStops();
            } catch (err: any) {
              showBanner(err?.message || "No se ha podido eliminar el punto.", true);
            } finally {
              target.removeAttribute("disabled");
            }
          }
        });

        form.addEventListener("submit", async (e: SubmitEvent) => {
          e.preventDefault();
          panelError.classList.add("is-hidden");

          if (!nameField.value.trim() || !latField.value || !lngField.value) {
            panelError.textContent = "Completa el nombre y fija la ubicación del punto en el mapa.";
            panelError.classList.remove("is-hidden");
            return;
          }

          panelSubmit.disabled = true;
          panelSubmit.textContent = "Guardando…";

          try {
            const isEditing = Boolean(idField.value);
            
            interface Payload {
              name: string;
              description?: string;
              location: { lat: number; lng: number };
              [key: string]: any; // Allows deleting undefined keys safely
            }

            const payload: Payload = {
              name: nameField.value.trim(),
              description: descField.value.trim() || undefined,
              location: {
                lat: Number(latField.value),
                lng: Number(lngField.value)
              }
            };
            
            // Clean up undefined fields
            Object.keys(payload).forEach((key) => payload[key] === undefined && delete payload[key]);

            const res = await fetch(
              isEditing ? `/api/admin/tours/${tourId}/stops/${idField.value}` : `/api/admin/tours/${tourId}/stops`,
              {
                method: isEditing ? "PATCH" : "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload)
              }
            );
            const data = await res.json();
            if (!res.ok) throw new Error(data?.message || "No se ha podido guardar el punto de ruta.");

            showBanner(isEditing ? "Punto de ruta actualizado." : "Punto de ruta creado.");
            closePanel();
            await fetchStops();
          } catch (err: any) {
            panelError.textContent = err?.message || "No se ha podido guardar el punto de ruta.";
            panelError.classList.remove("is-hidden");
          } finally {
            panelSubmit.disabled = false;
            panelSubmit.textContent = "Guardar punto";
          }
        });
      }
    </script>
  </body>
</html>
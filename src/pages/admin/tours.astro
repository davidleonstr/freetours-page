---
// @ts-nocheck
import "@/styles/global.css";
import { listAllTours } from "@/lib/adminApi.js";
import ConfirmDialog from "@/components/ConfirmDialog.astro";

export const prerender = false;

interface ApiTour {
  id: string;
  name: string;
  description: string;
  duration_hours: number | null;
  capacity: number | null;
  is_active: boolean;
}

let tours: ApiTour[] = [];
let loadError: string | null = null;

try {
  tours = await listAllTours();
} catch (err) {
  console.error("No se han podido cargar las excursiones para el panel de admin", err);
  loadError = "No se han podido cargar las excursiones. Recarga la página.";
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Panel de excursiones — Meriyo Tours (Dublin)</title>
    <link rel="icon" href="/web-icon-orange.svg" />
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;1,500;1,600&family=Work+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  </head>
  <body>
    <header class="admin-top">
      <div class="wrap admin-top__row">
        <a href="/" class="admin-top__logo"><em>Meriyo</em> Tours Dublín</a>
        <span class="admin-top__tag">Panel de excursiones</span>
        <div class="admin-top__nav">
          <a href="/admin/reservations" class="admin-top__nav-link">Reservas</a>
          <a href="/admin/schedules" class="admin-top__nav-link">Horarios</a>
          <a href="/admin/dates" class="admin-top__nav-link">Fechas</a>    
          <a href="/admin/images" class="admin-top__nav-link">Imagenes</a>       
        </div>
        <button type="button" class="admin-top__back admin-top__logout" id="admin-logout-btn">Cerrar sesión</button>
        <a href="/" class="admin-top__back">← Volver al sitio</a>
      </div>
    </header>

    <main class="admin">
      <div class="wrap">
        <div class="admin__head">
          <div>
            <p class="eyebrow">Catálogo</p>
            <h1 class="admin__title">Excursiones</h1>
          </div>
          <button type="button" class="btn orange-btn rounded-btn" id="new-tour-btn">+ Nueva excursión</button>
        </div>

        {loadError && <p class="admin__notice admin__notice--error">{loadError}</p>}

        <p class="admin__banner is-hidden" id="admin-banner" role="status"></p>

        <div class="admin__table-wrap">
          <table class="admin__table" id="tours-table">
            <thead>
              <tr>
                <th>Nombre</th>
                <th>Duración</th>
                <th>Aforo</th>
                <th>Estado</th>
                <th class="admin__col-actions">Acciones</th>
              </tr>
            </thead>
            <tbody id="tours-tbody">
              {tours.length === 0 && !loadError && (
                <tr class="admin__empty-row">
                  <td colspan="5">Todavía no hay excursiones. Crea la primera con el botón de arriba.</td>
                </tr>
              )}
              {tours.map((t) => (
                <tr data-tour-row={t.id}>
                  <td class="admin__cell-name">
                    <span class="admin__tour-name">{t.name}</span>
                  </td>
                  <td>{t.duration_hours ? `${t.duration_hours} h` : "—"}</td>
                  <td>{t.capacity ?? "—"}</td>
                  <td>
                    <span class={`admin__status admin__status--${t.is_active ? "active" : "archived"}`}>
                      {t.is_active ? "Activa" : "Archivada"}
                    </span>
                  </td>
                  <td class="admin__col-actions">
                    <button type="button" class="admin__link-btn" data-edit-tour={t.id}>Editar</button>
                    <a class="admin__link-btn" href={`/admin/schedules?tour=${t.id}`}>Horarios</a>
                    <a class="admin__link-btn" href={`/admin/dates?tour=${t.id}`}>Fechas</a>
                    <a class="admin__link-btn" href={`/admin/images?tour=${t.id}`}>Imagenes</a>
                    <button
                      type="button"
                      class="admin__link-btn admin__link-btn--danger"
                      data-toggle-tour={t.id}
                      data-active={String(t.is_active)}
                    >
                      {t.is_active ? "Archivar" : "Reactivar"}
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </main>

    <!-- Create / edit panel -->
    <div class="overlay is-hidden" id="tour-overlay">
      <div class="panel" role="dialog" aria-modal="true" aria-labelledby="panel-title">
        <div class="panel__head">
          <h2 class="panel__title" id="panel-title">Nueva excursión</h2>
          <button type="button" class="panel__close" id="panel-close" aria-label="Cerrar">✕</button>
        </div>

        <form id="tour-form" novalidate>
          <input type="hidden" id="tour-id" />

          <div class="field">
            <label for="f-name">Nombre<em>*</em></label>
            <input type="text" id="f-name" maxlength="255" required />
          </div>

          <div class="field">
            <label for="f-description">Descripción<em>*</em></label>
            <textarea id="f-description" rows="4" required></textarea>
          </div>

          <div class="field">
            <label for="f-meeting-search">Punto de encuentro (OpenStreetMap)<em>*</em></label>
            <div class="map-search-row">
              <input type="text" id="f-meeting-search" placeholder="Busca una dirección…" />
              <button type="button" class="btn btn-ghost black-color-05" id="f-meeting-search-btn">Buscar</button>
            </div>
            <div id="f-meeting-map" class="admin-map"></div>
            <p class="field__hint">Busca una dirección o haz clic en el mapa para fijar el punto de encuentro exacto.</p>
          </div>

          <div class="field">
            <label for="f-meeting-address">Dirección<em>*</em></label>
            <input type="text" id="f-meeting-address" maxlength="500" required />
          </div>

          <div class="field-row">
            <div class="field">
              <label for="f-meeting-lat">Latitud<em>*</em></label>
              <input type="text" id="f-meeting-lat" required readonly />
            </div>
            <div class="field">
              <label for="f-meeting-lng">Longitud<em>*</em></label>
              <input type="text" id="f-meeting-lng" required readonly />
            </div>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="f-duration">Duración (horas)</label>
              <input type="number" id="f-duration" min="1" step="1" />
            </div>
            <div class="field">
              <label for="f-capacity">Aforo máximo</label>
              <input type="number" id="f-capacity" min="1" step="1" />
            </div>
          </div>

          <div class="field">
            <label for="f-image">Imagen destacada <span class="field__optional">(opcional)</span></label>
            <div class="cover-preview is-hidden" id="cover-preview">
              <img id="cover-preview-img" alt="Imagen destacada actual" />
              <span>Imagen actual</span>
            </div>
            <input type="file" id="f-image" accept="image/jpeg,image/png,image/webp,image/gif" />
            <p class="field__hint" id="f-image-hint"></p>
          </div>

          <label class="checkbox-row">
            <input type="checkbox" id="f-active" checked />
            <span>Excursión activa (visible en la web)</span>
          </label>

          <p class="panel__error is-hidden" id="panel-error" role="alert"></p>

          <div class="panel__actions">
            <button type="button" class="btn btn-ghost black-color-05" id="panel-cancel">Cancelar</button>
            <button type="submit" class="btn orange-btn" id="panel-submit">Guardar excursión</button>
          </div>
        </form>
      </div>
    </div>

    <ConfirmDialog />

    <style is:global>
      .admin-top__nav {
        margin-left: auto;
        display: flex;
        gap: 20px;
        align-items: center;
      }
      .admin-top__nav-link {
        font-size: 0.85rem;
        color: var(--parchment-alt);
      }
      .black-color-05 {
          color: rgba(0, 0, 0, 0.5);
      }
      .admin-top {
        background: var(--forest-deep);
        border-bottom: 1px solid var(--line);
      }
      .admin-top__row {
        display: flex;
        align-items: center;
        gap: 20px;
        padding-block: 16px;
      }
      .admin-top__logo {
        font-family: var(--font-display);
        font-style: italic;
        font-size: 1.05rem;
        color: var(--cream);
      }
      .admin-top__logo em { color: var(--gold); }
      .admin-top__tag {
        font-size: 0.78rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--gold-soft);
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 4px 12px;
      }
      .admin-top__nav-link {
        font-size: 0.85rem;
        color: var(--parchment-alt);
      }
      .admin-top__nav-link:first-of-type {
        margin-left: auto;
      }
      .admin-top__nav-link:hover { color: var(--gold-soft); }
      .admin-top__back {
        font-size: 0.85rem;
        color: var(--parchment-alt);
      }
      .admin-top__back:hover { color: var(--gold-soft); }
      .admin-top__logout {
        background: none;
        border: none;
        font-family: inherit;
        cursor: pointer;
        padding: 0;
      }

      .admin { background: var(--parchment); padding-block: 44px 100px; min-height: 60vh; }

      .admin__head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 30px;
      }
      .admin__title {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: clamp(1.8rem, 3vw, 2.4rem);
        color: var(--ink);
        margin: 8px 0 0;
      }

      .admin__notice {
        font-size: 0.92rem;
        border-radius: var(--radius);
        padding: 14px 18px;
        margin: 0 0 22px;
      }
      .admin__notice--error {
        color: #7a2e1f;
        background: rgba(158, 73, 54, 0.1);
        border-left: 3px solid var(--russet);
      }

      .admin__banner {
        font-size: 0.9rem;
        border-radius: var(--radius);
        padding: 12px 18px;
        margin: 0 0 20px;
        background: rgba(233, 151, 10, 0.12);
        border-left: 3px solid var(--gold);
        color: var(--ink);
      }
      .admin__banner.is-hidden { display: none; }
      .admin__banner--error {
        background: rgba(158, 73, 54, 0.1);
        border-left-color: var(--russet);
        color: #7a2e1f;
      }

      .admin__table-wrap {
        background: var(--cream);
        border: 1px solid rgba(24, 34, 25, 0.1);
        border-top: 3px solid var(--gold);
        border-radius: var(--radius);
        overflow: hidden;
      }
      .admin__table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
      .admin__table th {
        text-align: left;
        font-size: 0.74rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: #7a7562;
        padding: 14px 18px;
        border-bottom: 1px solid rgba(24, 34, 25, 0.1);
      }
      .admin__table td {
        padding: 14px 18px;
        border-bottom: 1px dashed rgba(24, 34, 25, 0.12);
        color: var(--ink);
        vertical-align: middle;
      }
      .admin__table tr:last-child td { border-bottom: none; }
      .admin__tour-name { font-weight: 600; }
      .admin__empty-row td { color: #7a7562; text-align: center; padding: 30px 18px; }

      .admin__status {
        display: inline-block;
        font-size: 0.74rem;
        font-weight: 600;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        border-radius: 999px;
        padding: 4px 11px;
      }
      .admin__status--active { background: rgba(72, 122, 74, 0.14); color: #2e5c30; }
      .admin__status--archived { background: rgba(24, 34, 25, 0.08); color: #6b6b5f; }

      .admin__col-actions { white-space: nowrap; text-align: right; }
      .admin__link-btn {
        background: none;
        border: none;
        font-size: 0.85rem;
        font-family: var(--font-body);
        color: var(--russet);
        cursor: pointer;
        padding: 4px 6px;
      }
      .admin__link-btn:hover { text-decoration: underline; }
      .admin__link-btn--danger { color: #7a2e1f; margin-left: 6px; }

      /* ---------- Overlay panel (shared field styles borrowed from Booking) ---------- */
      .overlay {
        position: fixed;
        inset: 0;
        background: rgba(10, 14, 10, 0.5);
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding: 5vh 20px;
        z-index: 100;
        overflow-y: auto;
      }
      .overlay.is-hidden { display: none; }

      .panel {
        width: 100%;
        max-width: 560px;
        background: var(--cream);
        border-radius: var(--radius);
        border-top: 3px solid var(--gold);
        padding: 28px 30px 32px;
      }
      .panel__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
      }
      .panel__title {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1.3rem;
        color: var(--ink);
        margin: 0;
      }
      .panel__close {
        background: none;
        border: none;
        font-size: 1.1rem;
        color: #7a7562;
        cursor: pointer;
        line-height: 1;
      }

      .field { margin-bottom: 16px; }
      .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
      label {
        display: block;
        font-size: 0.82rem;
        font-weight: 600;
        color: #4a5b4c;
        margin-bottom: 7px;
      }
      label em { font-style: normal; color: var(--russet); margin-left: 2px; }
      .field__optional { font-weight: 400; color: #8a8272; }
      .field__hint { font-size: 0.78rem; color: #7a7562; margin: 6px 0 0; }

      .map-search-row {
        display: flex;
        gap: 10px;
        margin-bottom: 10px;
      }
      .map-search-row input { flex: 1; }
      .admin-map {
        width: 100%;
        height: 260px;
        border-radius: var(--radius);
        overflow: hidden;
        border: 1px solid rgba(24, 34, 25, 0.22);
        margin-bottom: 6px;
      }

      .cover-preview {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 10px;
        font-size: 0.8rem;
        color: #7a7562;
      }
      .cover-preview.is-hidden { display: none; }
      .cover-preview img {
        width: 56px;
        height: 56px;
        object-fit: cover;
        border-radius: 6px;
        border: 1px solid rgba(24, 34, 25, 0.15);
      }

      input[type="text"],
      input[type="number"],
      input[type="file"],
      textarea,
      select {
        width: 100%;
        font-family: var(--font-body);
        font-size: 0.95rem;
        color: var(--ink);
        background: var(--cream);
        border: 1px solid rgba(24, 34, 25, 0.22);
        border-radius: var(--radius);
        padding: 11px 14px;
      }
      textarea { resize: vertical; }
      input:focus, select:focus, textarea:focus {
        outline: none;
        border-color: var(--gold);
        box-shadow: 0 0 0 3px rgba(233, 151, 10, 0.16);
      }
      input[readonly] { background: var(--parchment-alt); cursor: not-allowed; }

      .checkbox-row {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.92rem;
        color: var(--ink);
        margin: 4px 0 18px;
        cursor: pointer;
      }
      .checkbox-row input { width: auto; accent-color: var(--gold); }

      .panel__error {
        font-size: 0.85rem;
        color: #7a2e1f;
        background: rgba(158, 73, 54, 0.1);
        border-left: 3px solid var(--russet);
        padding: 10px 14px;
        border-radius: var(--radius);
        margin-bottom: 16px;
      }
      .panel__error.is-hidden { display: none; }

      .panel__actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 6px;
      }

      @media (max-width: 640px) {
        .admin-top__tag { display: none; }
        .field-row { grid-template-columns: 1fr; }
        .admin__head { flex-direction: column; align-items: stretch; }
      }
    </style>

    <script>
      import { initConfirmDialog, confirmDialog } from "@/lib/confirmDialog.js";

      initConfirmDialog();

      document.getElementById("admin-logout-btn")?.addEventListener("click", async () => {
        await fetch("/api/admin/logout", { method: "POST" });
        window.location.href = "/admin/login";
      });

      interface Tour {
        id: string;
        name: string;
        description: string;
        meeting_point: string | null;
        meeting_point_lat: number | null;
        meeting_point_lng: number | null;
        meeting_point_osm_id?: string | null;
        duration_hours: number | null;
        capacity: number | null;
        is_active: boolean;
        gallery?: { id: string; url: string; alt: string | null; position: number }[];
      }

      const DUBLIN_CENTER: [number, number] = [53.3498, -6.2603];

      const tbody = document.getElementById("tours-tbody") as HTMLTableSectionElement;
      const banner = document.getElementById("admin-banner") as HTMLParagraphElement;

      const overlay = document.getElementById("tour-overlay") as HTMLDivElement;
      const panelTitle = document.getElementById("panel-title") as HTMLHeadingElement;
      const form = document.getElementById("tour-form") as HTMLFormElement;
      const panelError = document.getElementById("panel-error") as HTMLParagraphElement;
      const panelSubmit = document.getElementById("panel-submit") as HTMLButtonElement;

      const idField = document.getElementById("tour-id") as HTMLInputElement;
      const nameField = document.getElementById("f-name") as HTMLInputElement;
      const descField = document.getElementById("f-description") as HTMLTextAreaElement;
      const addressField = document.getElementById("f-meeting-address") as HTMLInputElement;
      const latField = document.getElementById("f-meeting-lat") as HTMLInputElement;
      const lngField = document.getElementById("f-meeting-lng") as HTMLInputElement;
      const searchInput = document.getElementById("f-meeting-search") as HTMLInputElement;
      const searchBtn = document.getElementById("f-meeting-search-btn") as HTMLButtonElement;
      const durationField = document.getElementById("f-duration") as HTMLInputElement;
      const capacityField = document.getElementById("f-capacity") as HTMLInputElement;
      const activeField = document.getElementById("f-active") as HTMLInputElement;
      const imageField = document.getElementById("f-image") as HTMLInputElement;
      const imageHint = document.getElementById("f-image-hint") as HTMLParagraphElement;
      const coverPreview = document.getElementById("cover-preview") as HTMLDivElement;
      const coverPreviewImg = document.getElementById("cover-preview-img") as HTMLImageElement;

      let knownTours = new Map<string, Tour>();

      // ---------- OpenStreetMap (Leaflet) meeting-point picker ----------
      let map: any = null;
      let marker: any = null;

      function ensureMap() {
        if (map) return;
        // @ts-ignore — Leaflet is loaded globally via the CDN <script> tag in <head>
        map = L.map("f-meeting-map").setView(DUBLIN_CENTER, 12);
        // @ts-ignore
        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
          maxZoom: 19,
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);
        map.on("click", (e: any) => setMarker(e.latlng.lat, e.latlng.lng));
      }

      function setMarker(lat: number, lng: number) {
        latField.value = lat.toFixed(6);
        lngField.value = lng.toFixed(6);
        if (marker) {
          marker.setLatLng([lat, lng]);
        } else {
          // @ts-ignore
          marker = L.marker([lat, lng]).addTo(map);
        }
        map.setView([lat, lng], Math.max(map.getZoom(), 15));
      }

      function clearMarker() {
        if (marker && map) {
          map.removeLayer(marker);
          marker = null;
        }
        latField.value = "";
        lngField.value = "";
        map?.setView(DUBLIN_CENTER, 12);
      }

      searchBtn?.addEventListener("click", async () => {
        const query = searchInput.value.trim();
        if (!query) return;

        searchBtn.disabled = true;
        const originalLabel = searchBtn.textContent;
        searchBtn.textContent = "Buscando…";

        try {
          const res = await fetch(
            `https://nominatim.openstreetmap.org/search?format=json&limit=1&q=${encodeURIComponent(query)}`,
            { headers: { Accept: "application/json" } }
          );
          const results = await res.json();
          if (!Array.isArray(results) || results.length === 0) {
            panelError.textContent =
              "No se ha encontrado esa dirección. Prueba con otra búsqueda o marca el punto directamente en el mapa.";
            panelError.classList.remove("is-hidden");
            return;
          }
          panelError.classList.add("is-hidden");
          const { lat, lon, display_name } = results[0];
          setMarker(Number(lat), Number(lon));
          addressField.value = display_name;
        } catch {
          panelError.textContent = "No se ha podido buscar la dirección. Inténtalo de nuevo.";
          panelError.classList.remove("is-hidden");
        } finally {
          searchBtn.disabled = false;
          searchBtn.textContent = originalLabel;
        }
      });

      function showBanner(message: string, isError = false) {
        banner.textContent = message;
        banner.classList.remove("is-hidden");
        banner.classList.toggle("admin__banner--error", isError);
        window.scrollTo({ top: 0, behavior: "smooth" });
      }

      function rowHtml(t: Tour) {
        return `
          <td class="admin__cell-name"><span class="admin__tour-name">${escapeHtml(t.name)}</span></td>
          <td>${t.duration_hours ? `${t.duration_hours} h` : "—"}</td>
          <td>${t.capacity ?? "—"}</td>
          <td><span class="admin__status admin__status--${t.is_active ? "active" : "archived"}">${
            t.is_active ? "Activa" : "Archivada"
          }</span></td>
          <td class="admin__col-actions">
            <button type="button" class="admin__link-btn" data-edit-tour="${t.id}">Editar</button>
            <a class="admin__link-btn" href="/admin/schedules?tour=${t.id}">Horarios</a>
            <a class="admin__link-btn" href="/admin/dates?tour=${t.id}">Fechas</a>
            <button type="button" class="admin__link-btn admin__link-btn--danger" data-toggle-tour="${t.id}" data-active="${t.is_active}">${
              t.is_active ? "Archivar" : "Reactivar"
            }</button>
          </td>`;
      }

      function escapeHtml(value: string) {
        const div = document.createElement("div");
        div.textContent = value;
        return div.innerHTML;
      }

      function upsertRow(tour: Tour) {
        knownTours.set(tour.id, tour);
        const emptyRow = tbody.querySelector(".admin__empty-row");
        emptyRow?.remove();

        let row = tbody.querySelector(`tr[data-tour-row="${tour.id}"]`) as HTMLTableRowElement | null;
        if (!row) {
          row = document.createElement("tr");
          row.setAttribute("data-tour-row", tour.id);
          tbody.prepend(row);
        }
        row.innerHTML = rowHtml(tour);
      }

      // Seed knownTours from the server-rendered rows so "Editar" works
      // immediately, without an extra fetch on page load.
      document.querySelectorAll<HTMLTableRowElement>("tr[data-tour-row]").forEach((row) => {
        const id = row.getAttribute("data-tour-row")!;
        knownTours.set(id, {
          id,
          name: row.querySelector(".admin__tour-name")?.textContent ?? "",
          description: "",
          meeting_point: null,
          meeting_point_lat: null,
          meeting_point_lng: null,
          duration_hours: null,
          capacity: null,
          is_active: row.querySelector("[data-toggle-tour]")?.getAttribute("data-active") === "true"
        });
      });

      async function fetchTour(id: string): Promise<Tour | null> {
        try {
          const res = await fetch(`/api/admin/tours/${id}`);
          if (!res.ok) return null;
          return await res.json();
        } catch {
          return null;
        }
      }

      async function refreshTourRow(id: string) {
        const fresh = await fetchTour(id);
        if (fresh) upsertRow(fresh);
      }

      function openPanel(tour?: Tour) {
        form.reset();
        panelError.classList.add("is-hidden");
        imageHint.textContent = "";
        coverPreview.classList.add("is-hidden");
        searchInput.value = "";

        ensureMap();

        if (tour) {
          panelTitle.textContent = "Editar excursión";
          idField.value = tour.id;
          nameField.value = tour.name;
          descField.value = tour.description;
          durationField.value = tour.duration_hours ? String(tour.duration_hours) : "";
          capacityField.value = tour.capacity ? String(tour.capacity) : "";
          activeField.checked = tour.is_active;

          addressField.value = tour.meeting_point ?? "";
          if (tour.meeting_point_lat != null && tour.meeting_point_lng != null) {
            setMarker(Number(tour.meeting_point_lat), Number(tour.meeting_point_lng));
          } else {
            clearMarker();
          }

          const currentCover = tour.gallery?.[0];
          if (currentCover) {
            coverPreviewImg.src = currentCover.url;
            coverPreview.classList.remove("is-hidden");
            imageHint.textContent = "Sube un archivo solo si quieres reemplazar la imagen actual.";
          } else {
            imageHint.textContent = "";
          }
        } else {
          panelTitle.textContent = "Nueva excursión";
          idField.value = "";
          activeField.checked = true;
          addressField.value = "";
          clearMarker();
        }

        overlay.classList.remove("is-hidden");
        nameField.focus();
        // Leaflet needs the container to be visible/sized before it can
        // compute its dimensions correctly.
        setTimeout(() => map?.invalidateSize(), 60);
      }

      function closePanel() {
        overlay.classList.add("is-hidden");
      }

      document.getElementById("new-tour-btn")?.addEventListener("click", () => openPanel());
      document.getElementById("panel-close")?.addEventListener("click", closePanel);
      document.getElementById("panel-cancel")?.addEventListener("click", closePanel);
      overlay.addEventListener("click", (e) => {
        if (e.target === overlay) closePanel();
      });

      tbody.addEventListener("click", async (e) => {
        const target = e.target as HTMLElement;

        const editId = target.getAttribute("data-edit-tour");
        if (editId) {
          // The seeded summary (from the server-rendered rows) is missing
          // description/meeting point/gallery — fetch the full record
          // before opening the form.
          const fresh = await fetchTour(editId);
          const tour = fresh ?? knownTours.get(editId);
          if (tour) openPanel(tour);
          return;
        }

        const toggleId = target.getAttribute("data-toggle-tour");
        if (toggleId) {
          const isActive = target.getAttribute("data-active") === "true";

          const confirmed = await confirmDialog({
            title: isActive ? "Archivar excursión" : "Reactivar excursión",
            message: isActive
              ? "¿Archivar esta excursión? Dejará de verse en la web."
              : "¿Reactivar esta excursión? Volverá a verse en la web.",
            confirmLabel: isActive ? "Archivar" : "Reactivar",
            danger: isActive
          });
          if (!confirmed) return;

          target.setAttribute("disabled", "true");
          try {
            if (isActive) {
              const res = await fetch(`/api/admin/tours/${toggleId}`, { method: "DELETE" });
              if (!res.ok) throw new Error((await res.json())?.message);
            } else {
              const res = await fetch(`/api/admin/tours/${toggleId}`, {
                method: "PATCH",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ isActive: true })
              });
              if (!res.ok) throw new Error((await res.json())?.message);
            }
            showBanner(isActive ? "Excursión archivada." : "Excursión reactivada.");
            await refreshTourRow(toggleId);
          } catch (err: any) {
            showBanner(err?.message || "No se ha podido completar la operación.", true);
          } finally {
            target.removeAttribute("disabled");
          }
        }
      });

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        panelError.classList.add("is-hidden");

        if (
          !nameField.value.trim() ||
          !descField.value.trim() ||
          !addressField.value.trim() ||
          !latField.value ||
          !lngField.value
        ) {
          panelError.textContent =
            "Completa el nombre, la descripción y fija el punto de encuentro en el mapa.";
          panelError.classList.remove("is-hidden");
          return;
        }

        panelSubmit.disabled = true;
        panelSubmit.textContent = "Guardando…";

        try {
          const isEditing = Boolean(idField.value);
          const payload: Record<string, unknown> = {
            name: nameField.value.trim(),
            description: descField.value.trim(),
            meetingPoint: {
              address: addressField.value.trim(),
              lat: Number(latField.value),
              lng: Number(lngField.value)
            },
            durationHours: durationField.value ? Number(durationField.value) : undefined,
            capacity: capacityField.value ? Number(capacityField.value) : undefined,
            isActive: activeField.checked
          };

          // Trim undefined keys — the backend schema rejects unexpected
          // properties, but `undefined` values still show up as own keys
          // after JSON.stringify unless removed first.
          Object.keys(payload).forEach((key) => payload[key] === undefined && delete payload[key]);

          const res = await fetch(isEditing ? `/api/admin/tours/${idField.value}` : "/api/admin/tours", {
            method: isEditing ? "PATCH" : "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
          });
          let tour = await res.json();
          if (!res.ok) throw new Error(tour?.message || "No se ha podido guardar la excursión.");

          // The tour now definitely has an id — only now can a cover photo
          // be attached to its gallery (the endpoint the site actually
          // reads covers from), whether this was a create or an edit.
          const file = imageField.files?.[0];
          if (file) {
            const uploadForm = new FormData();
            uploadForm.set("file", file);
            const uploadRes = await fetch("/api/admin/images", { method: "POST", body: uploadForm });
            const uploaded = await uploadRes.json();
            if (!uploadRes.ok) throw new Error(uploaded?.message || "No se ha podido subir la imagen.");

            const coverRes = await fetch(`/api/admin/tours/${tour.id}/cover-image`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ imageId: uploaded.id })
            });
            const coverData = await coverRes.json();
            if (!coverRes.ok) throw new Error(coverData?.message || "No se ha podido guardar la imagen destacada.");
          }

          upsertRow(tour);
          showBanner(isEditing ? "Excursión actualizada." : "Excursión creada.");
          closePanel();
        } catch (err: any) {
          panelError.textContent = err?.message || "No se ha podido guardar la excursión.";
          panelError.classList.remove("is-hidden");
        } finally {
          panelSubmit.disabled = false;
          panelSubmit.textContent = "Guardar excursión";
        }
      });
    </script>
  </body>
</html>
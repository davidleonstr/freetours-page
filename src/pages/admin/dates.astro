        border: 1px solid rgba(24, 34, 25, 0.08);
        border-radius: calc(var(--radius) - 4px);
        margin: 8px 0;
        overflow: hidden;
      }
      .month-group:first-child { margin-top: 0; }
      .month-group:last-child { margin-bottom: 0; }

      .month-group__summary {
        list-style: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 11px 14px;
        font-size: 0.9rem;
        font-weight: 600;
        color: #4a5b4c;
        background: var(--cream);
        user-select: none;
      }

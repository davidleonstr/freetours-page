      .admin__link-btn--danger { color: #7a2e1f; }
      .admin__link-btn:disabled { opacity: 0.5; cursor: not-allowed; text-decoration: none; }

      .add-schedule {
        display: flex;
        align-items: flex-end;
        gap: 14px;
        flex-wrap: wrap;
      }
      .add-schedule__field { flex: 1; min-width: 160px; }

      .panel__error {
        font-size: 0.85rem;
        color: #7a2e1f;
        background: rgba(158, 73, 54, 0.1);
        border-left: 3px solid var(--russet);
        padding: 10px 14px;
        border-radius: var(--radius);
        margin: 16px 0 0;
      }
      .panel__error.is-hidden { display: none; }

      @media (max-width: 640px) {

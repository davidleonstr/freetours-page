      }
      .month-group[open] > .month-group__summary::before { transform: rotate(45deg); }

      .group-count {
        font-weight: 400;
        color: #8a8272;
        font-size: 0.85em;
      }

      .month-group .schedule-list {
        margin: 0;
        border: none;
        border-radius: 0;

---
// @ts-nocheck
import "@/styles/global.css";
import { listAllTours, listTourDates } from "@/lib/adminApi.js";
import ConfirmDialog from "@/components/ConfirmDialog.astro";

export const prerender = false;

interface ApiTour {
  id: string;
  name: string;
  is_active: boolean;
}

interface ApiDate {
  id: string;
  date: string;
  tour_id: string;
  is_active: boolean;
  created_at: string;
}

let tours: ApiTour[] = [];
let loadError: string | null = null;

try {
  tours = await listAllTours();
} catch (err) {
  console.error("No se han podido cargar las excursiones para el panel de fechas", err);
  loadError = "No se han podido cargar las excursiones. Recarga la página.";
}

const selectedTourId = Astro.url.searchParams.get("tour") || tours[0]?.id || "";
const selectedTour = tours.find((t) => t.id === selectedTourId) ?? null;

let dates: ApiDate[] = [];
let dateError: string | null = null;

if (selectedTourId && !loadError) {
  try {
    dates = await listTourDates(selectedTourId);
    dates.sort((a, b) => a.date.localeCompare(b.date));
  } catch (err) {
    console.error("No se han podido cargar las fechas", err);
    dateError = "No se han podido cargar las fechas de esta ruta.";
  }
}

const formatDate = (value: string) => {
  const datePart = value.includes("T") ? value.split("T")[0] : value;
  return new Date(datePart + "T00:00:00").toLocaleDateString("es-ES", { day: "numeric", month: "short", year: "numeric" });
};

// --- Agrupar fechas por año y luego por mes, para no tener un scroll gigante ---
interface MonthGroup {
  key: string; // "YYYY-MM"
  label: string;
  dates: ApiDate[];
}
interface YearGroup {
  year: string;
  months: MonthGroup[];
}

function groupDatesByYearMonth(list: ApiDate[]): YearGroup[] {
  const yearMap = new Map<string, Map<string, ApiDate[]>>();

  for (const d of list) {
    const datePart = d.date.includes("T") ? d.date.split("T")[0] : d.date;
    const [year, month] = datePart.split("-");
    const monthKey = `${year}-${month}`;
    if (!yearMap.has(year)) yearMap.set(year, new Map());
    const monthMap = yearMap.get(year)!;
    if (!monthMap.has(monthKey)) monthMap.set(monthKey, []);
    monthMap.get(monthKey)!.push(d);
  }

  const monthFormatter = new Intl.DateTimeFormat("es-ES", { month: "long" });
  const years = [...yearMap.keys()].sort();

  return years.map((year) => {
    const monthMap = yearMap.get(year)!;
    const monthKeys = [...monthMap.keys()].sort();
    const months = monthKeys.map((monthKey) => {
      const monthNum = Number(monthKey.split("-")[1]);
      const rawLabel = monthFormatter.format(new Date(Number(year), monthNum - 1, 1));
      return {
        key: monthKey,
        label: rawLabel.charAt(0).toUpperCase() + rawLabel.slice(1),
        dates: monthMap.get(monthKey)!
      };
    });
    return { year, months };
  });
}

const dateGroups = groupDatesByYearMonth(dates);

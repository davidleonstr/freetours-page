      .year-group {
        border: 1px solid rgba(24, 34, 25, 0.1);
        border-radius: var(--radius);
        margin-bottom: 10px;
        overflow: hidden;
      }
      .year-group:last-child { margin-bottom: 0; }

      .year-group__summary {

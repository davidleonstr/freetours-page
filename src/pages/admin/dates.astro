      /* ---------- Grupos de fechas por año / mes ---------- */
      .date-groups { margin: 0 0 22px; }

      .date-groups > .schedule-list__empty {
        padding: 18px 16px;
        color: #7a7562;
        font-size: 0.9rem;
        text-align: center;
        border: 1px solid rgba(24, 34, 25, 0.1);
        border-radius: var(--radius);

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Fechas de excursiones — Meriyo Tours (Dublin)</title>
    <link rel="icon" href="/web-icon-orange.svg" />
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;1,500;1,600&family=Work+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="admin-top">
      <div class="wrap admin-top__row">
        <a href="/" class="admin-top__logo"><em>Meriyo</em> Tours <em>Dublín</em></a>
        <span class="admin-top__tag">Panel de fechas</span>
        <div class="admin-top__nav">
          <a href="/admin/reservations" class="admin-top__nav-link">Reservas</a>
          <a href="/admin/tours" class="admin-top__nav-link">Excursiones</a>   
          <a href="/admin/schedules" class="admin-top__nav-link">Horarios</a>
          <a href="/admin/images" class="admin-top__nav-link">Imagenes</a> 
          <a href="/admin/stops" class="admin-top__nav-link">Puntos</a>  
        </div>
        <button type="button" class="admin-top__back admin-top__logout" id="admin-logout-btn">Cerrar sesión</button>
        <a href="/" class="admin-top__back">← Volver al sitio</a>
      </div>
    </header>

    <main class="admin">
      <div class="wrap">
        <div class="admin__head">
          <div>
            <p class="eyebrow">Catálogo</p>
            <h1 class="admin__title">Fechas</h1>
          </div>
        </div>

        {loadError && <p class="admin__notice admin__notice--error">{loadError}</p>}

        <p class="admin__banner is-hidden" id="admin-banner" role="status"></p>

        {!loadError && tours.length === 0 && (
          <p class="admin__notice">
            Todavía no hay excursiones. Crea una primero desde el
            <a href="/admin/tours">panel de excursiones</a>.
          </p>
        )}

        {!loadError && tours.length > 0 && (
          <>
            <div class="admin__card">
              <div class="field">
                <label for="tour-picker">Ruta</label>
                <div class="select-wrap">
                  <select id="tour-picker">
                    {tours.map((t) => (
                      <option value={t.id} selected={t.id === selectedTourId}>
                        {t.name}{!t.is_active ? " (archivada)" : ""}
                      </option>
                    ))}
                  </select>
                </div>
              </div>
            </div>

            {selectedTour && (
              <div class="admin__card" id="dates-card" data-tour-id={selectedTour.id}>
                <h2 class="admin__card-title">Fechas de "{selectedTour.name}"</h2>

                {dateError && <p class="admin__notice admin__notice--error">{dateError}</p>}

                {!dateError && (
                  <>
                    <div class="date-groups" id="date-list">
                      {dates.length === 0 && (
                        <p class="schedule-list__empty" id="date-empty">
                          Todavía no hay fechas para esta ruta.
                        </p>
                      )}
                      {dateGroups.map((group, gi) => (
                        <details class="year-group" data-year={group.year} open={gi === 0}>
                          <summary class="year-group__summary">
                            {group.year}
                            <span class="group-count">({group.months.reduce((n, m) => n + m.dates.length, 0)})</span>
                          </summary>
                          <div class="year-group__months">
                            {group.months.map((month, mi) => (
                              <details class="month-group" data-year-month={month.key} open={gi === 0 && mi === 0}>
                                <summary class="month-group__summary">
                                  {month.label}
                                  <span class="group-count">({month.dates.length})</span>
                                </summary>
                                <ul class="schedule-list">
                                  {month.dates.map((d) => (
                                    <li class="schedule-list__item" data-date-id={d.id} data-date={d.date.includes("T") ? d.date.split("T")[0] : d.date}>
                                      <span class="schedule-list__time">{formatDate(d.date)}</span>
                                      <button type="button" class="admin__link-btn admin__link-btn--danger" data-delete-date={d.id}>
                                        Eliminar
                                      </button>
                                    </li>
                                  ))}
                                </ul>
                              </details>
                            ))}
                          </div>
                        </details>
                      ))}
                    </div>

                    <div class="generate-dates">
                      <p class="quick-add__label">Generar fechas automáticamente</p>
                      <div class="generate-dates__row">
                        <div class="field">
                          <label for="gen-date-from">Desde</label>
                          <input type="date" id="gen-date-from" />
                        </div>
                        <div class="field">
                          <label for="gen-date-to">Hasta</label>
                          <input type="date" id="gen-date-to" />
                        </div>
                        <button type="button" class="btn orange-btn" id="generate-dates-btn">Generar</button>
                      </div>
                      <p class="generate-dates__hint">Se creará una fecha para cada día del rango (incluidos fines de semana).</p>
                      <p class="panel__error is-hidden" id="generate-dates-error" role="alert"></p>
                    </div>

                    <form id="add-date-form" class="add-schedule">
                      <div class="field add-schedule__field">
                        <label for="new-date">Añadir fecha disponible</label>
                        <input type="date" id="new-date" required />
                      </div>
                      <button type="submit" class="btn orange-btn" id="add-date-btn">Añadir</button>
                    </form>
                    <p class="panel__error is-hidden" id="add-date-error" role="alert"></p>

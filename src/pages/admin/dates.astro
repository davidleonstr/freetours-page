        .admin__head { flex-direction: column; align-items: stretch; }
        .add-schedule { flex-direction: column; align-items: stretch; }
      }
    </style>

    <script>
      import { initConfirmDialog, confirmDialog } from "@/lib/confirmDialog.js";

      initConfirmDialog();

      document.getElementById("admin-logout-btn")?.addEventListener("click", async () => {
        await fetch("/api/admin/logout", { method: "POST" });
        window.location.href = "/admin/login";
      });

      const tourPicker = document.getElementById("tour-picker") as HTMLSelectElement | null;
      const banner = document.getElementById("admin-banner") as HTMLParagraphElement | null;
      const datesCard = document.getElementById("dates-card") as HTMLDivElement | null;
      const dateList = document.getElementById("date-list") as HTMLDivElement | null;
      const addForm = document.getElementById("add-date-form") as HTMLFormElement | null;
      const newDateInput = document.getElementById("new-date") as HTMLInputElement | null;
      const addBtn = document.getElementById("add-date-btn") as HTMLButtonElement | null;
      const addError = document.getElementById("add-date-error") as HTMLParagraphElement | null;

      function showBanner(message: string, isError = false) {
        if (!banner) return;
        banner.textContent = message;
        banner.classList.remove("is-hidden");
        banner.classList.toggle("admin__banner--error", isError);
        window.scrollTo({ top: 0, behavior: "smooth" });
      }

      // Mostrar resumen tras recargar la página al terminar de generar fechas
      const urlParams = new URLSearchParams(window.location.search);
      const generatedCount = urlParams.get("generated");
      if (generatedCount !== null) {
        const failedCount = urlParams.get("generatedFailed");
        const message = failedCount
          ? `Se han creado ${generatedCount} fecha(s). ${failedCount} no se pudieron crear (puede que ya existieran).`
          : `Se han creado ${generatedCount} fecha(s).`;
        showBanner(message, !!failedCount);
        urlParams.delete("generated");
        urlParams.delete("generatedFailed");
        const qs = urlParams.toString();
        window.history.replaceState({}, "", `${window.location.pathname}${qs ? `?${qs}` : ""}`);
      }

      const genFromInput = document.getElementById("gen-date-from") as HTMLInputElement | null;
      const genToInput = document.getElementById("gen-date-to") as HTMLInputElement | null;
      const genBtn = document.getElementById("generate-dates-btn") as HTMLButtonElement | null;
      const genError = document.getElementById("generate-dates-error") as HTMLParagraphElement | null;

      genBtn?.addEventListener("click", async () => {
        if (!datesCard || !genFromInput || !genToInput) return;
        genError?.classList.add("is-hidden");

        const tourId = datesCard.getAttribute("data-tour-id");
        const from = genFromInput.value;
        const to = genToInput.value;

        if (!tourId || !from || !to) {
          if (genError) {
            genError.textContent = "Selecciona una fecha de inicio y una de fin.";
            genError.classList.remove("is-hidden");
          }
          return;
        }

        const start = new Date(from + "T00:00:00");
        const end = new Date(to + "T00:00:00");

        if (start > end) {
          if (genError) {
            genError.textContent = "La fecha de inicio debe ser anterior (o igual) a la fecha de fin.";
            genError.classList.remove("is-hidden");
          }
          return;
        }

        const dayMs = 24 * 60 * 60 * 1000;
        const MAX_DAYS = 366; // límite de seguridad ante un rango escrito por error
        const totalDays = Math.round((end.getTime() - start.getTime()) / dayMs) + 1;
        if (totalDays > MAX_DAYS) {
          if (genError) {
            genError.textContent = `El rango es demasiado grande (${totalDays} días). Elige hasta ${MAX_DAYS} días.`;
            genError.classList.remove("is-hidden");
          }
          return;
        }

        genBtn.disabled = true;
        genBtn.textContent = "Generando…";

        let created = 0;
        let failed = 0;

        for (let t = start.getTime(); t <= end.getTime(); t += dayMs) {
          const iso = new Date(t).toISOString().slice(0, 10);
          try {
            const res = await fetch(`/api/admin/tours/${tourId}/dates`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ date: iso })
            });
            if (res.ok) created += 1;
            else failed += 1;
          } catch {
            failed += 1;
          }
        }

        const url = new URL(window.location.href);
        url.searchParams.set("tour", tourId);
        url.searchParams.set("generated", String(created));
        if (failed > 0) url.searchParams.set("generatedFailed", String(failed));
        else url.searchParams.delete("generatedFailed");
        window.location.href = url.toString();
      });

      tourPicker?.addEventListener("change", () => {
        const url = new URL(window.location.href);
        url.searchParams.set("tour", tourPicker.value);
        window.location.href = url.toString();
      });

      function formatDate(value: string) {
        const datePart = value.includes("T") ? value.split("T")[0] : value;
        return new Date(datePart + "T00:00:00").toLocaleDateString("es-ES", {
          day: "numeric",
          month: "short",
          year: "numeric"
        });
      }

      // Descompone "YYYY-MM-DD" (o "YYYY-MM-DDTHH:mm:ss") en las piezas que
      // necesitamos para encontrar/crear su grupo de año y mes.
      function parseDateParts(value: string) {
        const datePart = value.includes("T") ? value.split("T")[0] : value;
        const [year, month] = datePart.split("-");
        return { datePart, year, monthKey: `${year}-${month}`, monthNum: Number(month) };
      }

      function monthLabelFor(year: string, monthNum: number) {
        const formatter = new Intl.DateTimeFormat("es-ES", { month: "long" });
        const label = formatter.format(new Date(Number(year), monthNum - 1, 1));
        return label.charAt(0).toUpperCase() + label.slice(1);
      }

      function emptyStateRow(): HTMLParagraphElement {
        const p = document.createElement("p");
        p.className = "schedule-list__empty";
        p.id = "date-empty";
        p.textContent = "Todavía no hay fechas para esta ruta.";
        return p;
      }

      function dateRow(dateEntry: { id: string; date: string }): HTMLLIElement {
        const { datePart } = parseDateParts(dateEntry.date);
        const li = document.createElement("li");
        li.className = "schedule-list__item";
        li.setAttribute("data-date-id", dateEntry.id);
        li.setAttribute("data-date", datePart);
        li.innerHTML = `
          <span class="schedule-list__time">${formatDate(dateEntry.date)}</span>
          <button type="button" class="admin__link-btn admin__link-btn--danger" data-delete-date="${dateEntry.id}">Eliminar</button>
        `;
        return li;
      }

      function updateMonthCount(monthGroup: HTMLDetailsElement) {
        const count = monthGroup.querySelectorAll(".schedule-list__item").length;
        const countEl = monthGroup.querySelector(":scope > summary .group-count");
        if (countEl) countEl.textContent = `(${count})`;
      }

      function updateYearCount(yearGroup: HTMLDetailsElement) {
        const count = yearGroup.querySelectorAll(".schedule-list__item").length;
        const countEl = yearGroup.querySelector(":scope > summary .group-count");
        if (countEl) countEl.textContent = `(${count})`;
      }

      function getOrCreateYearGroup(year: string): HTMLDetailsElement | null {
        if (!dateList) return null;
        let yearGroup = dateList.querySelector<HTMLDetailsElement>(`:scope > details.year-group[data-year="${year}"]`);
        if (yearGroup) return yearGroup;

        yearGroup = document.createElement("details");
        yearGroup.className = "year-group";
        yearGroup.setAttribute("data-year", year);
        yearGroup.open = true;
        yearGroup.innerHTML = `
          <summary class="year-group__summary">${year} <span class="group-count">(0)</span></summary>
          <div class="year-group__months"></div>
        `;

        const existingYears = [...dateList.querySelectorAll<HTMLDetailsElement>(":scope > details.year-group")];
        const next = existingYears.find((el) => (el.getAttribute("data-year") ?? "") > year);
        if (next) dateList.insertBefore(yearGroup, next);
        else dateList.appendChild(yearGroup);

        return yearGroup;
      }

      function getOrCreateMonthGroup(
        yearGroup: HTMLDetailsElement,
        monthKey: string,
        year: string,
        monthNum: number
      ): HTMLDetailsElement {
        const monthsContainer = yearGroup.querySelector<HTMLDivElement>(":scope > .year-group__months")!;
        let monthGroup = monthsContainer.querySelector<HTMLDetailsElement>(
          `:scope > details.month-group[data-year-month="${monthKey}"]`
        );
        if (monthGroup) return monthGroup;

        monthGroup = document.createElement("details");
        monthGroup.className = "month-group";
        monthGroup.setAttribute("data-year-month", monthKey);
        monthGroup.open = true;
        monthGroup.innerHTML = `
          <summary class="month-group__summary">${monthLabelFor(year, monthNum)} <span class="group-count">(0)</span></summary>
          <ul class="schedule-list"></ul>
        `;

        const existingMonths = [...monthsContainer.querySelectorAll<HTMLDetailsElement>(":scope > details.month-group")];
        const next = existingMonths.find((el) => (el.getAttribute("data-year-month") ?? "") > monthKey);
        if (next) monthsContainer.insertBefore(monthGroup, next);
        else monthsContainer.appendChild(monthGroup);

        return monthGroup;
      }

      function insertDateRow(ul: HTMLUListElement, row: HTMLLIElement) {
        const rowDate = row.getAttribute("data-date") ?? "";
        const existing = [...ul.querySelectorAll<HTMLLIElement>(":scope > li.schedule-list__item")];
        const next = existing.find((li) => (li.getAttribute("data-date") ?? "") > rowDate);
        if (next) ul.insertBefore(row, next);
        else ul.appendChild(row);
      }

      addForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!datesCard || !newDateInput || !addBtn || !dateList) return;

        addError?.classList.add("is-hidden");

        const tourId = datesCard.getAttribute("data-tour-id");
        const date = newDateInput.value;
        if (!tourId || !date) return;

        addBtn.disabled = true;
        addBtn.textContent = "Añadiendo…";

        try {
          const res = await fetch(`/api/admin/tours/${tourId}/dates`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ date })
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data?.message || "No se ha podido añadir la fecha.");

          dateList.querySelector("#date-empty")?.remove();

          const { year, monthKey, monthNum } = parseDateParts(data.date);
          const yearGroup = getOrCreateYearGroup(year);
          if (yearGroup) {
            const monthGroup = getOrCreateMonthGroup(yearGroup, monthKey, year, monthNum);
            const ul = monthGroup.querySelector("ul.schedule-list") as HTMLUListElement;
            insertDateRow(ul, dateRow(data));
            updateMonthCount(monthGroup);
            updateYearCount(yearGroup);
          }

          newDateInput.value = "";
          showBanner("Fecha añadida.");
        } catch (err: any) {
          if (addError) {
            addError.textContent = err?.message || "No se ha podido añadir la fecha.";
            addError.classList.remove("is-hidden");
          }
        } finally {
          addBtn.disabled = false;
          addBtn.textContent = "Añadir";
        }
      });

      dateList?.addEventListener("click", async (e) => {
        const target = e.target as HTMLElement;
        const dateId = target.getAttribute("data-delete-date");
        if (!dateId || !datesCard || !dateList) return;

        const confirmed = await confirmDialog({
          title: "Eliminar fecha",
          message: "¿Eliminar esta fecha? Esta acción no se puede deshacer.",
          confirmLabel: "Eliminar"
        });
        if (!confirmed) return;

        const tourId = datesCard.getAttribute("data-tour-id");
        if (!tourId) return;

        target.setAttribute("disabled", "true");
        try {
          const res = await fetch(`/api/admin/tours/${tourId}/dates/${dateId}`, { method: "DELETE" });
          const data = await res.json();
          if (!res.ok) throw new Error(data?.message || "No se ha podido eliminar la fecha.");

          const row = dateList.querySelector(`li[data-date-id="${dateId}"]`);
          const monthGroup = row?.closest("details.month-group") as HTMLDetailsElement | null;
          const yearGroup = row?.closest("details.year-group") as HTMLDetailsElement | null;
          row?.remove();

          if (monthGroup) {
            const remaining = monthGroup.querySelectorAll(".schedule-list__item").length;
            if (remaining === 0) monthGroup.remove();
            else updateMonthCount(monthGroup);
          }
          if (yearGroup) {
            const remainingInYear = yearGroup.querySelectorAll(".schedule-list__item").length;
            if (remainingInYear === 0) yearGroup.remove();
            else updateYearCount(yearGroup);
          }

          if (!dateList.querySelector(".schedule-list__item")) {
            dateList.appendChild(emptyStateRow());
          }
          showBanner("Fecha eliminada.");
        } catch (err: any) {
          showBanner(err?.message || "No se ha podido eliminar la fecha. Puede que ya tenga reservas asociadas.", true);
        } finally {
          target.removeAttribute("disabled");
        }
      });
    </script>
  </body>
</html>
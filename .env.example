# Base URL of the tours/bookings API.
API_BASE_URL=http://localhost:3000
PUBLISH_KEY=change-me-super-secret-publish-key

# The API's general x-api-key (see auth.js in the backend). Server-only —
# do NOT prefix this with PUBLIC_, or Astro will bundle it into client-side
# JS and expose it to every visitor.
API_KEY=change-me-super-secret-api-key

CONTACT_PHONE=

ADMIN_USER=
ADMIN_PASSWORD=